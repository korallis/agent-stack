#!/usr/bin/env python3
"""agent-ci-runner: local GitHub Actions runners for the korallis repos on this host (docs/RUNNERS.md).

  agent-ci-runner install REPO [--count N] [--main-lane|--no-main-lane] [--dry-run]
                                             download the pinned runner (checksum verified) and run N runners for REPO
                                             (default: as installed, else 1; runner k >= 2 is instance REPO_r<k>), each as
                                             agent-ci-runner@<instance>; wait until GitHub lists them all online, then
                                             variable CI_LOCAL=1 (workflows then pick the local runner). --main-lane: the
                                             last runner (N >= 2) takes only label korallis-local-main, so it is kept for
                                             the jobs a workflow sends there (push to main); kept until --no-main-lane
  agent-ci-runner stop|start REPO            pause (CI_LOCAL cleared first, so jobs go to hosted runners) / resume
  agent-ci-runner remove REPO [--keep]       clear CI_LOCAL, stop the unit, delete the runner on GitHub and its dir
  agent-ci-runner status [--json]            units, GitHub runner state, CI_LOCAL, job slots, load
  agent-ci-runner logs REPO [-n N]           the unit's journal
  agent-ci-runner register REPO              (agent-ci-runner-register@, before every start) fresh ephemeral registration,
                                             clean work dir
  agent-ci-runner refresh-hooks              (install.sh --apply) copy the job gate hook into ci-runners/_shared, by
                                             rename; register does it too, before every job
  agent-ci-runner watch                      (timer, every 2 min) a runner down for 10 minutes -> CI_LOCAL cleared,
                                             so its repo's jobs run hosted instead of queueing; back online -> set again

Repos are korallis/<REPO> (AGENT_CI_OWNER). korallis is a personal account, so a runner serves exactly one repo: one
ephemeral runner per repo, and the job gate (system/ci-runner-hook) caps how many jobs run at once across all of them
(AGENT_CI_MAX_JOBS in ~/.config/agent-stack/ci-runners.env, default 2). Registration and removal tokens come from
`gh api` and reach the runner only as ACTIONS_RUNNER_INPUT_TOKEN in its environment: never printed, never on a
command line. Fork pull requests never reach a local runner: the workflows' runs-on picks the hosted runner for them.
"""
import argparse
import hashlib
import json
import os
import pwd
import re
import shutil
import socket
import subprocess
import sys
import tarfile
import time
import urllib.request
from pathlib import Path

VERSION = "2.337.0"
SHA256 = "70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613"
LABEL = "korallis-local"
MAIN_LABEL = "korallis-local-main"   # the main-lane runner's only label (install --main-lane)
VAR = "CI_LOCAL"
OFFLINE_GRACE_S = 600
REAL_HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)
OWNER = os.environ.get("AGENT_CI_OWNER", "korallis")
ROOT = Path(os.environ.get("AGENT_CI_ROOT", REAL_HOME / ".local/share/agent-stack/ci-runners"))
STATE = Path(os.environ.get("AGENT_CI_STATE", REAL_HOME / ".local/state/agent-stack/ci-runners"))
CONFIG = Path(os.environ.get("AGENT_CI_CONFIG", REAL_HOME / ".config/agent-stack/ci-runners.env"))
CACHE = Path(os.environ.get("AGENT_CI_CACHE", REAL_HOME / ".cache/agent-stack"))
HOOK_SRC = Path(os.environ.get("AGENT_CI_HOOK_SRC", Path(__file__).resolve().parent.parent / "system/ci-runner-hook"))
HOST = os.environ.get("AGENT_CI_HOST", socket.gethostname().split(".")[0])
DEFAULT_CONFIG = """# Local CI runners (agent-ci-runner, docs/RUNNERS.md). Numbers only; read by the job gate at every job start.
AGENT_CI_MAX_JOBS=2
AGENT_CI_MAX_LOAD_PER_CPU=1.0
AGENT_CI_MIN_MEM_GB=6
AGENT_CI_GATE_WAIT_S=900
# 1 keeps each runner's home and tool cache between jobs (faster; a same-repo PR job could leave files a later job uses)
AGENT_CI_KEEP_CACHE=0
"""


def die(msg, code=1):
    print(f"agent-ci-runner: {msg}", file=sys.stderr)
    sys.exit(code)


def say(msg):
    print(msg, flush=True)
    subprocess.run(["logger", "-t", "agent-ci-runner", msg], check=False)


def repo_ok(repo):
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,100}", repo) or repo.startswith(("_", ".")):
        die(f"not a repo name: {repo!r}")
    return repo


# The unit's PATH is minimal (/usr/local/bin:/usr/bin:/bin), and gh is a mise shim or lives in ~/.local/bin.
TOOL_PATH = os.environ.get("AGENT_CI_TOOL_PATH", f"{REAL_HOME}/.local/bin:{REAL_HOME}/.local/share/mise/shims")


def gh(*args, check=True):
    # The unit's HOME is the runner's own; gh's login (and mise's config) live in the real home.
    env = {**os.environ, "HOME": str(REAL_HOME), "PATH": f"{TOOL_PATH}:{os.environ.get('PATH', '/usr/bin:/bin')}"}
    # a stable cwd: the unit's WorkingDirectory is the runner dir, which register replaces (mise's shim fails on a
    # deleted cwd with "No such file or directory")
    r = subprocess.run(["gh", *args], capture_output=True, text=True, env=env, cwd=REAL_HOME)
    if check and r.returncode != 0:
        die(f"gh {' '.join(args[:3])} failed: {(r.stderr or r.stdout).strip()[:300]}")
    return r


def token(repo, kind):
    r = gh("api", "-X", "POST", f"repos/{OWNER}/{repo}/actions/runners/{kind}-token", "--jq", ".token")
    tok = r.stdout.strip()
    if not tok:
        die(f"GitHub returned no {kind} token for {OWNER}/{repo}")
    return tok


def systemctl(*args, check=True):
    r = subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"systemctl --user {' '.join(args)} failed: {(r.stderr or r.stdout).strip()[:300]}")
    return r


# A repo can have several runners (instances): <repo> is runner 1, <repo>_r<N> runner N (N >= 2). Each instance has its
# own directory, unit (agent-ci-runner@<instance>), GitHub runner name (<host>-<repo>, <host>-<repo>-<N>) and job slot;
# CI_LOCAL and the paused state belong to the repo.
def split(inst):
    m = re.fullmatch(r"(.+)_r(\d+)", inst)
    return (m.group(1), int(m.group(2))) if m and int(m.group(2)) >= 2 else (inst, 1)


def inst_name(repo, k):
    return repo if k == 1 else f"{repo}_r{k}"


def runner_name(inst):
    repo, k = split(inst)
    return f"{HOST}-{repo}" if k == 1 else f"{HOST}-{repo}-{k}"


def unit(inst):
    return f"agent-ci-runner@{inst}.service"


def runner_dir(inst):
    return ROOT / inst / "runner"


def installed():
    """Every installed instance."""
    return sorted(p.name for p in ROOT.glob("*") if p.is_dir() and not p.name.startswith(("_", ".")) and (p / "runner").is_dir()) if ROOT.is_dir() else []


def instances(repo):
    return sorted((i for i in installed() if split(i)[0] == repo), key=lambda i: split(i)[1])


def repos():
    return sorted({split(i)[0] for i in installed()})


def github_runners(repo):
    r = gh("api", f"repos/{OWNER}/{repo}/actions/runners", "--paginate", "--jq", ".runners[] | {id, name, status, busy}", check=False)
    if r.returncode != 0:
        return None
    return [json.loads(line) for line in r.stdout.splitlines() if line.strip()]


def online_names(repo):
    """This host's runner names GitHub lists online for repo (None: GitHub unreachable)."""
    runners = github_runners(repo)
    if runners is None:
        return None
    return {x["name"] for x in runners if x["status"] == "online"}


def var_get(repo):
    r = gh("api", f"repos/{OWNER}/{repo}/actions/variables/{VAR}", "--jq", ".value", check=False)
    return r.stdout.strip() if r.returncode == 0 else None


def var_set(repo, on):
    if on:
        gh("variable", "set", VAR, "--body", "1", "--repo", f"{OWNER}/{repo}")
    elif var_get(repo) is not None:
        gh("variable", "delete", VAR, "--repo", f"{OWNER}/{repo}")


def run_config(inst, args, tok):
    d = runner_dir(inst)
    env = {**os.environ, "ACTIONS_RUNNER_INPUT_TOKEN": tok, "HOME": str(ROOT / inst / "home")}
    r = subprocess.run([str(d / "config.sh"), *args], cwd=d, env=env, capture_output=True, text=True)
    out = (r.stdout + r.stderr).replace(tok, "***")
    tail = "\n".join(l for l in out.splitlines() if l.strip())[-1500:]
    return r.returncode, tail


def config_value(name, default):
    if CONFIG.is_file():
        m = re.search(rf"^{name}=([0-9.]+)$", CONFIG.read_text(), re.M)
        if m:
            return m.group(1)
    return default


def extract_runner(inst):
    tarball = fetch_runner()  # verified before anything is replaced
    d = runner_dir(inst)
    ROOT.mkdir(parents=True, exist_ok=True)
    os.chdir(ROOT)  # never sit in the directory being replaced (the unit starts this step inside it)
    shutil.rmtree(d, ignore_errors=True)
    d.mkdir(parents=True)
    with tarfile.open(tarball) as t:
        t.extractall(d, filter="tar")
    (d / ".agent-ci-version").write_text(VERSION + "\n")


PORT_BASE = int(os.environ.get("AGENT_CI_PORT_BASE", "47100"))


def alloc_port(inst):
    """A stable E2E_PORT per runner instance (PORT_BASE..PORT_BASE+99): two runners on this host must not start the same
    app port (a project's 2 browser shards collided on its default port, 2026-10-03)."""
    f = STATE / "ports.json"
    try:
        ports = json.loads(f.read_text())
    except (OSError, ValueError):
        ports = {}
    ports = {k: v for k, v in ports.items() if (ROOT / k / "runner").is_dir() or k == inst}
    if inst not in ports:
        used = set(ports.values())
        free = next((p for p in range(PORT_BASE, PORT_BASE + 100) if p not in used), None)
        if free is None:
            die(f"no free E2E_PORT in {PORT_BASE}..{PORT_BASE + 99}")
        ports[inst] = free
    STATE.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(ports, sort_keys=True))
    return ports[inst]


def cmd_register(inst):
    repo = split(inst)[0]
    if not runner_dir(inst).is_dir():
        die(f"{runner_dir(inst)} has no runner; run agent-ci-runner install {repo}")
    (STATE / "slots" / inst).unlink(missing_ok=True)  # a (re)start means the previous job is over
    install_hooks()
    # Nothing a job wrote may reach the next one: the job can write its whole runner directory, so the runner itself
    # is re-extracted from the checksum-verified release (with a fresh _work), and its home and tool cache are wiped,
    # unless AGENT_CI_KEEP_CACHE=1 keeps those two (faster; a same-repo PR job could then leave files a later job uses).
    extract_runner(inst)
    for sub in ("home", "toolcache"):
        if config_value("AGENT_CI_KEEP_CACHE", "0") != "1":
            shutil.rmtree(ROOT / inst / sub, ignore_errors=True)
        (ROOT / inst / sub).mkdir(parents=True, exist_ok=True)
    # the unit loads this file (EnvironmentFile): each runner's jobs get their own app port
    (ROOT / inst / "ci.env").write_text(f"E2E_PORT={alloc_port(inst)}\n")
    rc, tail = run_config(inst, ["--unattended", "--ephemeral", "--replace", "--disableupdate",
                                 "--url", f"https://github.com/{OWNER}/{repo}", "--name", runner_name(inst),
                                 "--labels", label(inst), "--work", "_work"], token(repo, "registration"))
    print(tail)
    if rc != 0:
        die(f"runner registration for {OWNER}/{repo} failed (exit {rc})")
    print(f"registered {runner_name(inst)} for {OWNER}/{repo} (ephemeral, label {label(inst)})")


def fetch_runner():
    tarball = Path(os.environ.get("AGENT_CI_TARBALL", CACHE / f"actions-runner-linux-x64-{VERSION}.tar.gz"))
    want = os.environ.get("AGENT_CI_SHA256", SHA256)
    if not tarball.is_file():
        CACHE.mkdir(parents=True, exist_ok=True)
        url = f"https://github.com/actions/runner/releases/download/v{VERSION}/actions-runner-linux-x64-{VERSION}.tar.gz"
        tmp = tarball.with_suffix(".part")
        with urllib.request.urlopen(url, timeout=120) as resp, open(tmp, "wb") as out:
            shutil.copyfileobj(resp, out)
        tmp.replace(tarball)
    got = hashlib.sha256(tarball.read_bytes()).hexdigest()
    if got != want:
        die(f"{tarball}: checksum {got} is not the pinned {want}; refusing to install it")
    return tarball


def put(path, data):
    """Write an executable file by rename, never in place: a running job's bash may be reading the old one (it reads its
    script as it goes), and no reader ever sees a partly written file. Unchanged content is not rewritten."""
    try:
        if path.read_bytes() == data:
            return False
    except OSError:
        pass
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_bytes(data)
    tmp.chmod(0o755)
    os.replace(tmp, path)
    return True


def install_hooks():
    """The job gate every runner runs from ci-runners/_shared (bound read-only into each unit). Called by install, by
    register (before every job, so a merged hook change reaches the next job) and by refresh-hooks (install.sh)."""
    shared = ROOT / "_shared"
    shared.mkdir(parents=True, exist_ok=True)
    changed = put(shared / "ci-runner-hook", HOOK_SRC.read_bytes())
    for name, mode in (("job-started.sh", "start"), ("job-completed.sh", "end")):
        changed |= put(shared / name, f'#!/usr/bin/env bash\nexec "$(dirname "$0")/ci-runner-hook" {mode}\n'.encode())
    (STATE / "slots").mkdir(parents=True, exist_ok=True)
    if not CONFIG.exists():
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(DEFAULT_CONFIG)
        CONFIG.chmod(0o600)
    return changed


def cmd_refresh_hooks():
    if not repos():
        print("no local runners installed: nothing to refresh")
        return
    print("job gate hook refreshed (from the next job on)" if install_hooks() else "job gate hook already current")


def wait_online(repo, names, seconds):
    end = time.time() + seconds
    while time.time() < end:
        if set(names) <= (online_names(repo) or set()):
            return True
        time.sleep(float(os.environ.get("AGENT_CI_POLL_S", "5")))
    return False


def lanes():
    try:
        return json.loads((STATE / "lanes.json").read_text())
    except (OSError, ValueError):
        return {}


def set_lane(repo, inst):
    """{repo: instance}: that instance registers with MAIN_LABEL only; inst None removes the repo's lane."""
    d = lanes()
    if inst:
        d[repo] = inst
    else:
        d.pop(repo, None)
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE / "lanes.json.tmp"
    tmp.write_text(json.dumps(d, sort_keys=True))
    os.replace(tmp, STATE / "lanes.json")


def label(inst):
    return MAIN_LABEL if lanes().get(split(inst)[0]) == inst else LABEL


def drop_instance(inst):
    repo = split(inst)[0]
    systemctl("disable", "--now", unit(inst), check=False)
    for x in github_runners(repo) or []:
        if x["name"] == runner_name(inst):
            gh("api", "-X", "DELETE", f"repos/{OWNER}/{repo}/actions/runners/{x['id']}")
    (STATE / "slots" / inst).unlink(missing_ok=True)
    f = STATE / "ports.json"
    try:
        ports = json.loads(f.read_text())
        ports.pop(inst, None)
        f.write_text(json.dumps(ports, sort_keys=True))
    except (OSError, ValueError):
        pass


def start_inactive(inst):
    # an active runner may be mid-job: starting it again would also start its register unit (Requires=), which
    # re-extracts the runner and wipes its home under the job
    if systemctl("is-active", unit(inst), check=False).stdout.strip() != "active":
        systemctl("start", unit(inst))


def cmd_install(repo, count, dry, lane=None):
    r = gh("api", f"repos/{OWNER}/{repo}", "--jq", ".full_name", check=False)
    if r.returncode != 0:
        die(f"{OWNER}/{repo} is not reachable with gh: {(r.stderr or r.stdout).strip()[:200]}")
    count = count or max(1, len(instances(repo)))
    want = [inst_name(repo, k) for k in range(1, count + 1)]
    extra = [i for i in instances(repo) if i not in want]
    if lane and len(want) < 2:
        die("--main-lane needs --count 2 or more (the other runners take the PR jobs)")
    lane_inst = want[-1] if lane else None if lane is False else lanes().get(repo) if lanes().get(repo) in want else None
    if dry:
        print(f"would install runner {VERSION} as {', '.join(want)} ({', '.join(runner_name(i) for i in want)}; sandboxed, "
              f"agent-heavy.slice){'; remove ' + ', '.join(extra) if extra else ''}"
              f"{'; ' + lane_inst + ' takes only ' + MAIN_LABEL if lane_inst else ''}; wait for them online, then set {VAR}=1 on {OWNER}/{repo}")
        return
    # Only a new instance is extracted here: register re-extracts the verified release before every start anyway, and an
    # installed runner may be in the middle of a job (re-extracting it would pull its files from under that job).
    for inst in want:
        if not runner_dir(inst).is_dir():
            extract_runner(inst)
    install_hooks()
    # before any start: register reads it (an active runner picks up a change at its next registration, after its job)
    set_lane(repo, lane_inst)
    for inst in extra:
        drop_instance(inst)
        shutil.rmtree(ROOT / inst, ignore_errors=True)
    (STATE / f"{repo}.paused").unlink(missing_ok=True)
    systemctl("daemon-reload")
    for inst in want:
        systemctl("enable", unit(inst))
        start_inactive(inst)
    names = [runner_name(i) for i in want]
    if not wait_online(repo, names, float(os.environ.get("AGENT_CI_ONLINE_WAIT_S", "120"))):
        die(f"{', '.join(names)} did not all come online; {VAR} left unset (jobs stay hosted). See: agent-ci-runner logs {repo}")
    var_set(repo, True)
    say(f"{OWNER}/{repo}: {len(want)} local runner(s) online ({', '.join(names)}); {VAR}=1 (Linux jobs run here)")


def cmd_stop(repo):
    var_set(repo, False)
    (STATE).mkdir(parents=True, exist_ok=True)
    (STATE / f"{repo}.paused").write_text(str(int(time.time())))
    for inst in instances(repo):
        systemctl("stop", unit(inst), check=False)
        (STATE / "slots" / inst).unlink(missing_ok=True)  # a job stopped mid-run never reaches its job-completed hook
    say(f"{OWNER}/{repo}: local runner(s) paused; {VAR} cleared (jobs run hosted)")


def cmd_start(repo):
    (STATE / f"{repo}.paused").unlink(missing_ok=True)
    insts = instances(repo)
    if not insts:
        die(f"no local runner installed for {repo}; run agent-ci-runner install {repo}")
    for inst in insts:
        start_inactive(inst)
    if not wait_online(repo, [runner_name(i) for i in insts], float(os.environ.get("AGENT_CI_ONLINE_WAIT_S", "120"))):
        die(f"the runner(s) for {repo} did not all come online; {VAR} left unset")
    var_set(repo, True)
    say(f"{OWNER}/{repo}: local runner(s) resumed; {VAR}=1")


def cmd_remove(repo, keep):
    var_set(repo, False)
    set_lane(repo, None)
    for inst in instances(repo):
        drop_instance(inst)
        if not keep:
            shutil.rmtree(ROOT / inst, ignore_errors=True)
    (STATE / f"{repo}.paused").unlink(missing_ok=True)
    say(f"{OWNER}/{repo}: local runner(s) removed; {VAR} cleared")


def load_state():
    try:
        return json.loads((STATE / "watch.json").read_text())
    except (OSError, ValueError):
        return {}


def cmd_watch():
    st, now = load_state(), int(time.time())
    for repo in repos():
        if (STATE / f"{repo}.paused").exists():
            continue
        up = online_names(repo)
        if up is None:
            continue  # GitHub unreachable: judge nothing
        # healthy while, for each label the repo's runners take (korallis-local, and the main lane's if it has one), one
        # of them is both running here and online on GitHub: with the lane runner down, main's jobs would only queue
        ok = [i for i in instances(repo) if runner_name(i) in up
              and systemctl("is-active", unit(i), check=False).stdout.strip() == "active"]
        healthy = bool(ok) and {label(i) for i in ok} == {label(i) for i in instances(repo)}
        if healthy:
            st.pop(repo, None)
            if var_get(repo) != "1":
                var_set(repo, True)
                say(f"{OWNER}/{repo}: local runner back online; {VAR}=1 again")
            continue
        since = st.setdefault(repo, now)
        if now - since >= OFFLINE_GRACE_S and var_get(repo) == "1":
            var_set(repo, False)
            say(f"{OWNER}/{repo}: local runner(s) down {(now - since) // 60} min; {VAR} cleared, jobs run hosted until one is back")
            subprocess.run(["notify-send", "--app-name=Agent stack", "CI moved to hosted runners",
                            f"{OWNER}/{repo}: the local runner is down"], check=False, capture_output=True)
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "watch.json").write_text(json.dumps(st))


def cmd_status(as_json):
    rows = []
    slots = STATE / "slots"
    busy = sorted(p.name for p in slots.glob("*") if p.is_file() and not p.name.startswith(".")) if slots.is_dir() else []
    for repo in repos():
        up, ci = online_names(repo), var_get(repo)
        for inst in instances(repo):
            rows.append({"repo": repo, "instance": inst, "runner": runner_name(inst),
                         "unit": systemctl("is-active", unit(inst), check=False).stdout.strip(),
                         "online": None if up is None else runner_name(inst) in up, "ci_local": ci,
                         "paused": (STATE / f"{repo}.paused").exists(), "job_slot": inst in busy, "label": label(inst)})
    cfg = dict(re.findall(r"^(AGENT_CI_[A-Z_]+)=([0-9.]+)$", CONFIG.read_text(), re.M)) if CONFIG.is_file() else {}
    summary = {"runners": rows, "busy_slots": busy, "max_jobs": int(cfg.get("AGENT_CI_MAX_JOBS", 2)),
               "load1": float(Path("/proc/loadavg").read_text().split()[0]), "cpus": os.cpu_count()}
    if as_json:
        print(json.dumps(summary, indent=2))
        return
    for r in rows:
        print(f"{r['instance']:<20} unit {r['unit']:<9} github {'online' if r['online'] else ('?' if r['online'] is None else 'offline'):<8}"
              f" {VAR}={r['ci_local'] or 'unset':<6}{' paused' if r['paused'] else ''}{' main lane' if r['label'] == MAIN_LABEL else ''}"
              f"{' running a job' if r['job_slot'] else ''}")
    print(f"jobs: {len(busy)}/{summary['max_jobs']} slots busy; load {summary['load1']}/{summary['cpus']}")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("install", "stop", "start", "remove", "logs", "register"):
        s = sub.add_parser(name)
        s.add_argument("repo", help="instance (<repo> or <repo>_r<N>)" if name in ("register", "logs") else "repo")
        if name == "install":
            s.add_argument("--dry-run", action="store_true")
            s.add_argument("--count", type=int, default=0, help="runners for this repo (default: as installed, else 1)")
            g = s.add_mutually_exclusive_group()
            g.add_argument("--main-lane", dest="lane", action="store_true", default=None,
                           help=f"the last runner takes only {MAIN_LABEL} (push-to-main jobs)")
            g.add_argument("--no-main-lane", dest="lane", action="store_false", help="every runner takes PR and main jobs")
        if name == "remove":
            s.add_argument("--keep", action="store_true")
        if name == "logs":
            s.add_argument("-n", type=int, default=100)
    sub.add_parser("watch")
    sub.add_parser("refresh-hooks")
    s = sub.add_parser("status")
    s.add_argument("--json", action="store_true")
    a = p.parse_args()
    if a.cmd in ("register", "logs"):
        repo_ok(split(a.repo)[0])
        repo = a.repo
    else:
        repo = repo_ok(a.repo) if hasattr(a, "repo") else None
        if repo and split(repo)[1] != 1:
            die(f"{repo!r}: name a repo, not a runner instance (instances are <repo>_r<N>)")
    if a.cmd == "install":
        if a.count < 0 or a.count > 8:
            die("--count must be 1 to 8")
        cmd_install(repo, a.count, a.dry_run, a.lane)
    elif a.cmd == "register":
        cmd_register(repo)
    elif a.cmd == "stop":
        cmd_stop(repo)
    elif a.cmd == "start":
        cmd_start(repo)
    elif a.cmd == "remove":
        cmd_remove(repo, a.keep)
    elif a.cmd == "logs":
        os.execvp("journalctl", ["journalctl", "--user", "-u", unit(repo), "-n", str(a.n), "--no-pager"])
    elif a.cmd == "watch":
        cmd_watch()
    elif a.cmd == "refresh-hooks":
        cmd_refresh_hooks()
    else:
        cmd_status(a.json)


if __name__ == "__main__":
    main()
