#!/usr/bin/env python3
"""agent-project-check <Project|workspace-path> [--json]

Checks that a project is wired the OpenRig way (OpenRig references: sdlc-conventions.md, wave-sdlc.md,
product-journey-sdlc.md, project-workspace.md) plus the agent-stack conventions. Read-only.
Each line is OK, WARN (advisory, fix soon) or FAIL (the project views or the team will misbehave).
Exit code 1 when anything FAILs. The `openrig-project-setup` skill explains every check.
"""
import collections, glob, json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
arg = next((a for a in sys.argv[1:] if not a.startswith("--")), None)
if not arg:
    sys.exit(__doc__)
W = os.path.abspath(arg if os.path.isdir(arg) and os.path.exists(os.path.join(arg, "project.yaml"))
                    else os.path.join(HOME, "Projects", f"{arg}-work"))
P = os.path.basename(W)[:-5] if W.endswith("-work") else os.path.basename(W)
REPO, WT = os.path.join(HOME, "Projects", P), os.path.join(HOME, "Projects", f"{P}.worktrees")
results = []


def rep(level, what, detail=""):
    results.append((level, what, detail))


def run(cmd, **kw):
    """subprocess.run that treats a missing or unrunnable tool (rig, tmux, npx, … on a machine without them) as a failed
    command with no output, so a check reports it instead of the whole script crashing."""
    try:
        return subprocess.run(cmd, **{"capture_output": True, "text": True, **kw})
    except (FileNotFoundError, PermissionError, NotADirectoryError) as e:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: {e.strerror or e}")


def sh(*cmd):
    r = run(list(cmd))
    return r.stdout if r.returncode == 0 else ""


def read(p):
    try:
        return open(p).read()
    except OSError:
        return None


def owner_names():
    """The names an Owner decisions source may use for the owner: agent-owner-address --names (per machine: "owner",
    the owner address's name part, AGENT_OWNER_NAMES). Never a name written in this repo."""
    try:
        r = run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "agent-owner-address"), "--names"],
                           capture_output=True, text=True, timeout=30)
        names = [n.strip() for n in r.stdout.splitlines() if n.strip()] if r.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired):
        names = []
    return names or ["owner"]


def owner_source_re(names):
    """A source: a Slack time or a non-blank operator relay reference in a parenthetical that names the owner (any
    configured name, any case), or that follows the owner's name closely: (owner, Slack 08:08Z), (<name>, via operator
    relay of <ref>), (<name> approved, Slack 14:04Z), <name> confirmed (Slack 14:51Z, 'yes')."""
    alt = "|".join(re.escape(n) for n in sorted(set(names), key=len, reverse=True))
    how = r"(?:\bSlack\b[^()]*\b\d{1,2}:\d{2}Z|via operator relay of [^()\s][^()]*)"
    return re.compile(rf"\((?=[^()]*\b(?:{alt})\b)[^()]*{how}[^()]*\)|\b(?:{alt})\b[^().;]{{0,40}}\(\s*[^()]*?{how}[^()]*\)", re.I)


OWNER_SOURCE = None   # compiled on first use (owner_names runs a helper)


def owner_decision_problems(culture):
    """The Owner decisions bullets without an owner source at their end, and those citing a lead doc (docs/decisions/*)."""
    m = re.search(r"^## Owner decisions[^\n]*\n(.*?)(?=^## |\Z)", culture, re.M | re.S)
    bullets, cur, gap = [], None, False
    for line in (m.group(1) if m else "").split("\n"):
        if re.match(r"[-*+] ", line):                       # every Markdown bullet marker
            cur, gap = [line[2:].strip()], False; bullets.append(cur)
        elif cur is not None and line.startswith("  ") and line.strip():
            cur.append(line.strip()); gap = False            # a continuation, also after a blank line inside the item
        elif cur is not None and not line.strip() and not gap:
            gap = True
        else:
            cur = None
    texts = [" ".join(b) for b in bullets if " ".join(b) != "(none yet)"]
    short = lambda t: (t[:70] + "…") if len(t) > 70 else t
    global OWNER_SOURCE
    OWNER_SOURCE = OWNER_SOURCE or owner_source_re(owner_names())
    return [short(t) for t in texts if not OWNER_SOURCE.search(t)], [short(t) for t in texts if "docs/decisions/" in t]


def frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n", text or "", re.S)
    fm = {}
    for line in (m.group(1) if m else "").splitlines():
        k, _, v = line.partition(":")
        if _ and not line.startswith(" "):
            fm[k.strip()] = v.strip()
    return fm, (text[m.end():] if m else text or "")


# ---- 1. workspace + catalog -------------------------------------------------------------------------
if not os.path.isdir(W):
    print(f"FAIL  workspace {W} does not exist (run agent-project-new)"); sys.exit(1)
proj = read(f"{W}/project.yaml") or ""
for f in ("project.yaml", "workspace.yaml", "SPEC.md", "missions"):
    rep("OK" if os.path.exists(f"{W}/{f}") else "FAIL", f"workspace has {f}")
rep("OK" if re.search(r"^sdlc:", proj, re.M) else "FAIL", "project.yaml declares sdlc defaults (rig/template/project-sdlc.yaml)")
rep("OK" if re.search(r"^git:", proj, re.M) else "FAIL", "project.yaml declares the git strategy")
rep("OK" if re.search(r"^\s*-\s*conventions\.md\s*$", proj, re.M) and os.path.exists(f"{W}/conventions.md") else "WARN",
    "project.yaml install.context includes conventions.md")
heavy = any("agent-heavy" in (read(p) or "") for p in (f"{W}/rig/CULTURE.md", f"{W}/conventions.md"))
rep("OK" if heavy else "WARN", "conventions require agent-heavy for heavy runs (tsc/eslint/tests/builds)",
    "" if heavy else "add the agent-heavy Operating rule from agent-stack rig/template/CULTURE.md, then agent-refresh-guidance")
wsy = read(f"{W}/workspace.yaml") or ""
pid = (re.search(r"^\s*-\s*id:\s*([\w.-]+)", wsy, re.M) or [None, None])[1]
rep("OK" if pid and pid != "default" else "FAIL", f"workspace.yaml project id is set ({pid})")
rep("OK" if re.search(r"^metadata:", proj, re.M) else "FAIL", "project.yaml has metadata (official shape)")
rep("OK" if re.search(r"^proofPolicy:\s*\n\s+judges:", proj, re.M) else "FAIL", "project.yaml proofPolicy.judges (else TUI readiness is 'legacy')")
cat = read(f"{HOME}/Projects/openrig-workspace/workspace.yaml") or ""
rep("OK" if W in cat else "FAIL", "listed in the umbrella catalog ~/Projects/openrig-workspace/workspace.yaml")
for k in ("files.allowlist", "progress.scan_roots"):
    rep("OK" if W in sh("rig", "config", "get", k) else "FAIL", f"{k} includes {W}")

# ---- 2. rig ------------------------------------------------------------------------------------------
specs = [s for s in glob.glob(f"{W}/rig/*.yaml") if re.search(r"^pods:", read(s) or "", re.M)]
rig, cwds = None, []
if specs:
    specs.sort(key=lambda f: len(re.findall(r"cwd:", read(f) or "")), reverse=True)  # the running team is the largest spec
    spec = read(specs[0])
    rig = (re.search(r'^name:\s*"?([\w.-]+)"?', spec, re.M) or [None, None])[1]
    cwds = re.findall(r'cwd:\s*"?([^"\n]+)"?', spec)
    rep("OK", f"rig spec {os.path.basename(specs[0])} (rig {rig}, {len(cwds)} seats)")
    missing = [c for c in cwds if not os.path.isdir(c)]
    rep("OK" if not missing else "FAIL", "every seat has its worktree", ", ".join(map(os.path.basename, missing[:5])))
    rep("OK" if os.path.exists(f"{W}/rig/CULTURE.md") else "FAIL", "rig/CULTURE.md present")
    lacks = [h for h in ("Owner decisions", "Operator and lead rules", "Operating rules") if not re.search(rf"^## {h}", read(f"{W}/rig/CULTURE.md") or "", re.M)]
    rep("OK" if not lacks else "WARN", "CULTURE.md has the Owner decisions, Operator and lead rules and Operating rules sections",
        f"missing {', '.join(lacks)}: copy from agent-stack rig/template/CULTURE.md" if lacks else "")
    # Owner decisions hold only the owner's own decisions, each ending with its source; a lead's interpretation filed
    # there reads to every seat as the owner's word (WO41).
    unsourced, lead_docs = owner_decision_problems(read(f"{W}/rig/CULTURE.md") or "")
    rep("OK" if not unsourced else "WARN", "every Owner decisions bullet ends with its owner source",
        f"{len(unsourced)} without (owner or the owner's name, Slack HH:MMZ) or (…, via operator relay of <ref>): {'; '.join(unsourced[:3])}. "
        "Add the source, or move a rule that isn't the owner's to \"Operator and lead rules\"" if unsourced else "")
    rep("OK" if not lead_docs else "WARN", "no Owner decisions bullet rests on a lead doc (docs/decisions/*)",
        f"{'; '.join(lead_docs[:3])}: a lead's doc is not the owner's word; move it to \"Operator and lead rules\"" if lead_docs else "")
    rpi = re.search(r"^## Research, plan, implement", read(f"{W}/rig/CULTURE.md") or "", re.M) is not None
    rep("OK" if rpi else "WARN", "CULTURE.md has the Research, plan, implement section (owner standard, 2026-09-30)",
        "" if rpi else "copy the section from agent-stack rig/template/CULTURE.md, then agent-refresh-guidance <P> --apply")
    wfs = re.search(r"^## Workflow skills", read(f"{W}/rig/CULTURE.md") or "", re.M) is not None
    rep("OK" if wfs else "WARN", "CULTURE.md has the Workflow skills section (WO30, 2026-09-30)",
        "" if wfs else "copy the section from agent-stack rig/template/CULTURE.md, then agent-refresh-guidance <P> --apply")
    WORKFLOW = ("bug-review-board", "verification-guide", "blast-radius", "review-lenses", "unslop", "technical-writing")
    unseen = [f"{d}/{n}" for n in WORKFLOW for d in ("~/.claude/skills", "~/.agents/skills")
              if not os.path.isfile(os.path.join(os.path.expanduser(d), n, "SKILL.md"))]
    rep("OK" if not unseen else "WARN", "seats can see the workflow skills (Claude and Codex skill dirs)",
        f"missing: {', '.join(unseen[:4])}{' …' if len(unseen) > 4 else ''}; run ./install.sh --apply" if unseen else "")
    ps = sh("rig", "ps", "--json")
    running = bool(rig) and (f'"{rig}"' in ps or re.search(rf"^{re.escape(rig)}\s", sh("rig", "ps"), re.M) is not None)
    rep("OK" if running else "WARN", f"rig {rig} is running")
    # Fable seats (the architect by default) bill to usage credits; an account may need a one-time consent first. A
    # running Fable seat whose screen asks for it, or says the model is unavailable, would otherwise stall silently.
    fable = []
    for pod_block in re.split(r"\n  - id: ", spec or "")[1:]:
        pod = pod_block.split("\n", 1)[0].strip()
        for mem in re.split(r"\n      - id: ", pod_block)[1:]:
            if re.search(r'model:\s*"?claude-fable', mem):
                fable.append(f"{pod}-{mem.split(chr(10), 1)[0].strip()}@{rig}")
    # A consent prompt or an unavailable-model error, not any mention of "usage credits" in ordinary work.
    CONSENT = re.compile(r"/model fable|(usage credits|extra usage)[^\n]{0,80}(consent|confirm|enable|accept|agree|turn on)"
                         r"|(consent|confirm|enable|accept|agree|turn on)[^\n]{0,80}(usage credits|extra usage)"
                         r"|model[^\n]{0,40}(is not available|unavailable|not supported)|invalid model", re.I)
    stuck_fable, unread = [], []
    for seat in fable if running else []:
        cap = run(["tmux", "capture-pane", "-p", "-S", "-80", "-t", seat], capture_output=True, text=True)
        if cap.returncode != 0:
            unread.append(seat)
        elif CONSENT.search(cap.stdout):
            stuck_fable.append(seat)
    if fable:
        level = "WARN" if stuck_fable or unread else "OK"
        detail = "; ".join(filter(None, [
            f"{', '.join(stuck_fable)}: the screen asks for Fable's one-time usage-credits consent or says the model is unavailable. "
            "In that seat run `/model fable` once, accept, then relaunch it at idle" if stuck_fable else "",
            f"{', '.join(unread)}: screen not readable (seat not in tmux?), so not verified" if unread else ""]))
        rep(level, f"Fable seats can use their model ({', '.join(fable)})", detail)
    try:
        wd = [j for j in json.loads(sh("rig", "watchdog", "list", "--json") or "[]")
              if j.get("state") == "active" and (j.get("targetSession") or "").endswith(f"@{rig}")]
    except json.JSONDecodeError:
        wd = []
    # A watchdog is a merge sweep or a daily summary by what its spec says (the template messages start "Merge sweep:" /
    # "Daily summary:"), never by its interval: `rig queue block --wake-after 15m|24h` registers a periodic-reminder
    # with the same 900 s / 86400 s ("Wake timer fired for parked qitem ..."), and those parked-row wakes are not counted.
    # A job whose spec can't be read is reported, not guessed.
    def spec_message(j):
        try:
            spec = json.loads(sh("rig", "watchdog", "show", j["jobId"], "--json") or "null")
        except json.JSONDecodeError:
            spec = None
        if not isinstance(spec, dict) or not isinstance(spec.get("specYaml"), str):
            return None
        try:
            import yaml
            doc = yaml.safe_load(spec["specYaml"]) or {}
        except Exception:
            return None
        if not isinstance(doc, dict):
            return None
        # What OpenRig delivers: the top-level message, else context.message (`message ?? context.message`; an empty
        # top-level string is a message, not a fallback).
        msg = doc.get("message")
        if msg is None and isinstance(doc.get("context"), dict):
            msg = doc["context"].get("message")
        return " ".join(msg.split()) if isinstance(msg, str) else None
    kinds, unread = {"merge": [], "daily": []}, []
    for j in wd:
        if j.get("policy", "periodic-reminder") != "periodic-reminder":
            continue
        msg = spec_message(j)
        if msg is None:
            unread.append(j["jobId"])
        elif msg.startswith("Merge sweep:"):
            kinds["merge"].append(j)
        elif msg.startswith("Daily summary:"):
            kinds["daily"].append(j)
    merge, daily = kinds["merge"], kinds["daily"]
    def verdict(js, seat_prefix):
        right = len(js) == 1 and js[0]["targetSession"].startswith(seat_prefix)
        detail = [] if right else ["none active" if not js else f"{len(js)} active ({', '.join(sorted(j['targetSession'] for j in js))})"]
        if unread:
            detail.append(f"{len(unread)} watchdog(s) whose spec could not be read were not counted")
        return ("OK" if right and not unread else "FAIL" if len(js) > 1 else "WARN"), "; ".join(detail)
    level, detail = verdict(merge, "integ-")
    rep(level, "one merge-sweep watchdog on the merge owner", detail)
    level, detail = verdict(daily, "coord-lead")
    rep(level, "one daily-summary watchdog on the lead", detail)
else:
    rep("FAIL", "no rig spec in <workspace>/rig/")
excl = read(f"{REPO}/.git/info/exclude") or ""
rep("OK" if all(x in excl for x in ("/.openrig/", "/CLAUDE.local.md")) else "WARN",
    "repo .git/info/exclude hides OpenRig seat files")

# ---- 3. missions + slices ----------------------------------------------------------------------------
ids, specs_by_id, open_slices_by_mission, witness_missions, witness_ids = {}, {}, {}, set(), set()
def is_witness_slice(slug, fm):
    """A W witness slice: frontmatter `witness:` as a YAML boolean (inline comment stripped; an explicit false wins),
    or, when unset, a name with a w/wNN token that ends in 'witness' (11-w02-witness, 07-m1-w-witness, 08-1-w-staging-witness)."""
    flag = re.sub(r"\s+#.*$", "", str(fm.get("witness", ""))).strip().strip("'\"").lower()
    if flag in ("true", "yes", "on"):
        return True
    if flag in ("false", "no", "off"):
        return False
    return bool(re.search(r"(^|-)w\d*(-|$)", slug)) and slug.endswith("witness")
bad = {"sections": [], "depends_on": [], "territory": [], "status": [], "mission_files": [], "yaml_refs": []}
for m in sorted(glob.glob(f"{W}/missions/*/")):
    mn = os.path.basename(m.rstrip("/"))
    for f in ("SPEC.md", "PROGRESS.md", "NOTES.md", "mission.yaml"):
        if not os.path.exists(m + f):
            bad["mission_files"].append(f"{mn}/{f}")
    my = read(m + "mission.yaml") or ""
    for ref in re.findall(r"ref:\s*(slices/[^\s]+)", my):
        if not os.path.exists(m + ref):
            bad["yaml_refs"].append(f"{mn}/{ref}")
    for s in sorted(glob.glob(m + "slices/*/")):
        sn = os.path.basename(s.rstrip("/"))
        fm, body = frontmatter(read(s + "SPEC.md"))
        sid = fm.get("id")
        if sid:
            ids.setdefault(sid, []).append(f"{mn}/{sn}")
            specs_by_id[sid] = (mn, sn, fm)
        for h in ("## Intent", "## Mini-requirements", "## Proof contract"):
            if h not in body:
                bad["sections"].append(f"{mn}/{sn}"); break
        if "depends_on" not in fm:
            bad["depends_on"].append(f"{mn}/{sn}")
        if is_witness_slice(sn, fm):
            witness_missions.add(mn)
            if sid:
                witness_ids.add(sid)
        st = fm.get("status", "")
        if st not in ("done", "closed", "delivered", "abandoned"):
            open_slices_by_mission.setdefault(mn, []).append(sn)
            if "Territory:" not in body:
                bad["territory"].append(f"{mn}/{sn}")
        if st in ("", "placeholder"):
            bad["status"].append(f"{mn}/{sn}")
CLOSED = ("done", "closed", "delivered", "abandoned", "archived", "complete", "completed")
def mission_status(mdir):
    """The mission's own status: mission.yaml metadata.status, else PROGRESS.md frontmatter status."""
    y = re.search(r"^metadata:\s*\n(?:\s+.*\n)*?\s+status:\s*['\"]?([\w-]+)", read(mdir + "mission.yaml") or "", re.M)
    return (y.group(1) if y else frontmatter(read(mdir + "PROGRESS.md"))[0].get("status", "")).strip().lower()
open_missions = set(open_slices_by_mission) | {os.path.basename(m.rstrip("/")) for m in glob.glob(f"{W}/missions/*/")
                                              if mission_status(m) not in ("",) + CLOSED}
# Per wave: every wave ends with a W slice witnessing its features and gating the next wave, unless the wave says
# `no-witness: <reason>`: a non-empty text reason, and only for a docs/infra wave (refused if any member is
# `ui: true`). Wave ids are global: each mission.yaml lists its own slices of a shared wave, so members are merged
# across missions. A wave is witnessed by a W slice among its members, or by a follow-on wave `<id>w` holding one (the
# project B layout). Only waves with open slices are judged: a finished wave can no longer be gated, whatever its name. A
# mission without waves needs one W slice of its own.
import yaml as _yaml
waves, unwitnessed = {}, []
done_ids = {sid for sid, (_, _, f) in specs_by_id.items() if f.get("status", "") in ("done", "closed", "delivered", "abandoned")}
for mdir in sorted(glob.glob(f"{W}/missions/*/")):
    mn = os.path.basename(mdir.rstrip("/"))
    try:
        mw = ((_yaml.safe_load(read(mdir + "mission.yaml") or "") or {}).get("arrangement") or {}).get("waves") or []
    except _yaml.YAMLError:
        mw = []
    if not mw and mn in open_missions and mn not in witness_missions:
        unwitnessed.append(mn)
    for wave in mw:
        w = waves.setdefault(str(wave.get("id", "?")), {"slices": set(), "optout": False})
        w["slices"] |= {str(x) for x in (wave.get("slices") or [])}
        reason = wave.get("no-witness")
        w["optout"] |= isinstance(reason, str) and reason.strip() != ""  # `true`, empty or whitespace is not a reason
ui_ids = {sid for sid, (_, _, f) in specs_by_id.items() if str(f.get("ui", "")).split("#")[0].strip().lower() in ("true", "yes")}
for wid, w in sorted(waves.items()):
    if wid.endswith("w") and w["slices"] & witness_ids:
        continue  # a follow-on witness wave
    if w["optout"] and not (w["slices"] & ui_ids):
        continue  # docs/infra only, with a stated reason
    if not (w["slices"] - done_ids - witness_ids):
        continue  # finished (or only its own witness left)
    follow = waves.get(wid + "w", {"slices": set()})["slices"]
    if not (w["slices"] & witness_ids or follow & witness_ids):
        unwitnessed.append(wid)
rep("OK" if not unwitnessed else "WARN", "every open wave ends with a W witness slice (or says no-witness: <reason>)",
    ("missing in " + ", ".join(unwitnessed if os.environ.get("AGENT_PROJECT_CHECK_FULL") else unwitnessed[:6])
     + ("…" if len(unwitnessed) > 6 and not os.environ.get("AGENT_PROJECT_CHECK_FULL") else "")
     + "; copy agent-stack rig/template/witness-slice/") if unwitnessed else "")
nslices = sum(len(v) for v in ids.values())
dups = {k: v for k, v in ids.items() if len(v) > 1}
rep("OK" if nslices else "WARN", f"{len(glob.glob(f'{W}/missions/*/'))} missions, {nslices} slices")
rep("OK" if not dups else "FAIL", "slice ids are unique", str(list(dups.items())[:3]))
unres = [f"{v[0]}/{v[1]}->{d}" for v in specs_by_id.values()
         for d in json.loads(v[2].get("depends_on") or "[]") if d not in specs_by_id] if specs_by_id else []
rep("OK" if not unres else "FAIL", "every depends_on resolves to a slice id", ", ".join(unres[:4]))
for key, lvl, what in (("mission_files", "FAIL", "missions have SPEC/PROGRESS/NOTES/mission.yaml"),
                       ("yaml_refs", "FAIL", "mission.yaml slice refs exist"),
                       ("sections", "WARN", "slice SPEC.md has Intent / Mini-requirements / Proof contract"),
                       ("depends_on", "FAIL", "slice SPEC.md frontmatter has depends_on (EC-1)"),
                       ("territory", "WARN", "open slices declare a Territory: line (needed to form waves)"),
                       ("status", "WARN", "slice status is set honestly (not placeholder)")):
    rep("OK" if not bad[key] else lvl, what, f"{len(bad[key])}: " + ", ".join(bad[key][:4]) if bad[key] else "")

# ---- 4. queue: wave maps + execution-data tags ------------------------------------------------------
# A failed read must say so: an empty result here used to skip the whole queue section silently.
q = []
try:
    qr = run(["rig", "queue", "list", "-A", "-a", "--full", "--json", "--limit", "20000"], timeout=180)
    if qr.returncode != 0:
        rep("WARN", "could not read the queue", f"rig queue list exit {qr.returncode}: {(qr.stderr or qr.stdout).strip()[-200:]}")
    elif not qr.stdout.strip():
        rep("WARN", "could not read the queue", "rig queue list exited 0 with no output")
    else:
        parsed = json.loads(qr.stdout)
        if isinstance(parsed, list):
            q = parsed
        else:
            rep("WARN", "could not read the queue", f"rig queue list returned JSON that is not a list of rows ({type(parsed).__name__})")
except (OSError, subprocess.TimeoutExpired) as e:
    rep("WARN", "could not read the queue", f"rig queue list: {e}")
except json.JSONDecodeError:
    rep("WARN", "could not read the queue", "rig queue list returned output that is not JSON (daemon down?)")
mine = [r for r in q if rig and ((r.get("destinationSession") or "").endswith(f"@{rig}")
                                 or (r.get("sourceSession") or "").endswith(f"@{rig}"))]
maps = {}
for r in mine:
    tags = r.get("tags") or []
    if "wave-map" in tags:
        mb = re.search(r"```json\s*(\{.*?\})\s*```", r.get("body") or "", re.S)
        try:
            d = json.loads(mb.group(1)) if mb else None
        except json.JSONDecodeError:
            d = None
        if d and d.get("format") == "wave-map-v1":
            maps[d.get("mission")] = d
        else:
            rep("FAIL", f"wave-map row {r.get('qitemId')} has no valid ```json wave-map-v1 block")
# Waves: the daemon's EXECUTION view (what the TUI shows) takes waves from mission.yaml `arrangement.waves`
# (members = slice SPEC ids) whenever mission.yaml exists; the EC-2 queue row is only a legacy fallback.
# So ask the daemon itself, exactly as the TUI does.
import urllib.parse, urllib.request
# Everything below asks the daemon the same questions the TUI asks (/api/scopes, /api/views/execution) and
# fails on what the TUI would show as missing. Files that look right but the daemon can't read are the
# failure mode this catches (it once missed that waves must live in mission.yaml, not queue rows).
def api(path):
    try:
        return json.load(urllib.request.urlopen(os.environ.get("OPENRIG_URL", "http://127.0.0.1:7433").rstrip("/") + path, timeout=30))
    except Exception as e:
        return {"__error__": e.__class__.__name__}
pq = urllib.parse.urlencode({"project": pid or "", "projectRoot": W})
sc = api(f"/api/scopes?detail=1&{pq}")
if "__error__" in sc:
    rep("FAIL", "daemon reachable for the project views", sc["__error__"])
else:
    mr = collections.Counter(m.get("readiness", {}).get("state") for m in sc.get("missions", []))
    sr = collections.Counter(sl.get("readiness", {}).get("state") for m in sc.get("missions", []) for sl in m.get("slices", []))
    issues = sorted({i for m in sc.get("missions", []) for i in m.get("readiness", {}).get("issues", [])})
    rep("OK" if not (mr.get("unknown") or mr.get("legacy") or issues) else "FAIL",
        "mission readiness derives (metadata + proofPolicy; not unknown/legacy)", f"{dict(mr)} {issues[:2]}" if issues or mr.get("unknown") or mr.get("legacy") else "")
    rep("OK" if not (sr.get("unknown") or sr.get("legacy")) else "FAIL", "slice readiness derives (proofPolicy.judges set)", "" if not (sr.get("unknown") or sr.get("legacy")) else str(dict(sr)))
noarr, gaps = [], collections.defaultdict(list)
for mdir in sorted(glob.glob(f"{W}/missions/*/")):
    mn = os.path.basename(mdir.rstrip("/"))
    if not glob.glob(mdir + "slices/*/"):
        continue
    if not re.search(r"^arrangement:\s*\n(?:.*\n)*?\s+waves:", read(mdir + "mission.yaml") or "", re.M):
        noarr.append(mn)
    v = api(f"/api/views/execution?mission={urllib.parse.quote(mn)}&{pq}")
    if "__error__" in v:
        gaps["daemon"].append(mn); continue
    row = (v.get("rows") or [{}])[0]
    src = row.get("sources", {})
    if "malformed" in json.dumps(src.get("arrangement", {})):
        gaps["mission.yaml malformed"].append(mn)
    care = row.get("q3_care") or []
    if any(c.get("build_wave") in (None, "INDETERMINATE") for c in care):
        gaps["no wave declared"].append(mn)
    if any(c.get("planning_dial") in (None, "INDETERMINATE") for c in care):
        gaps["no planning dial"].append(mn)
    if any(c.get("review_model") in (None, "INDETERMINATE") for c in care):
        gaps["wave without review_model"].append(mn)
    if "no reachable repo" in json.dumps(src.get("git", {})):
        gaps["no repo context (no worktree_path row)"].append(mn)
    if any(l.get("fragile_join") for l in row.get("q1_lanes") or []):
        gaps["in-progress rows without worktree_path"].append(mn)
rep("OK" if not noarr else "FAIL", "every mission.yaml declares arrangement.waves (the daemon's wave authority)",
    "run agent-project-repair --apply: " + ", ".join(noarr) if noarr else "")
for key, lvl, label in (("daemon", "FAIL", "answers for every mission"),
                        ("mission.yaml malformed", "FAIL", "reads every mission.yaml"),
                        ("no wave declared", "FAIL", "every slice has a wave"),
                        ("no planning dial", "WARN", "every slice has a planning dial (approved-spec-dial)"),
                        ("wave without review_model", "WARN", "every wave has a review_model"),
                        ("no repo context (no worktree_path row)", "WARN", "has a repo context (worktree_path rows)"),
                        ("in-progress rows without worktree_path", "WARN", "no in-progress row lacks worktree_path")):
    rep("OK" if not gaps[key] else lvl, f"TUI execution view {label}", f"{key}: " + ", ".join(gaps[key][:6]) if gaps[key] else "")
for mn, d in maps.items():
    known = {sn for (m2, sn, _) in specs_by_id.values() if m2 == mn}
    unknown = [s for w in d.get("waves", []) for s in w.get("slices", []) if s not in known and s not in specs_by_id]
    if unknown:
        rep("FAIL", f"wave map {mn} names unknown slices", ", ".join(unknown[:4]))
import datetime
# rows are never rewritten: judge only rows created since the seat `rig` helper was installed (or the last 24h)
helper = f"{HOME}/.local/share/agent-stack/seat-tools/rig"
t0 = os.path.getmtime(helper) if os.path.exists(helper) else 0
t0 = max(t0, (datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=24)).timestamp())
since = datetime.datetime.fromtimestamp(t0, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
recent = [r for r in mine if (r.get("tsCreated") or "") >= since
          and not (r.get("qitemId") or "").startswith("qitem-recovery-")  # daemon-made findings, not batons
          and not any(t in ("stuck-sweep-finding", "wake-escalation", "wave-map") for t in (r.get("tags") or []))]
tagged = [r for r in recent if any(t.startswith("project:") for t in (r.get("tags") or []))]
scoped = [r for r in recent if any(t.startswith(("mission:", "slice:")) for t in (r.get("tags") or []))]
wtp = [r for r in recent if "worktree_path=" in (r.get("body") or "")]
if not recent and q:
    rep("OK", f"queue rows since {since[:16]}Z: none for this project in the window, so the tag checks have nothing to judge",
        f"{len(mine)} row(s) of this rig in total; the window starts at the later of the seat helper's install time and 24h ago")
if recent:
    pct = lambda a: f"{len(a)}/{len(recent)}"
    rep("OK" if len(tagged) == len(recent) else "WARN", f"queue rows since {since[:16]}Z carry project:<id>", pct(tagged))
    rep("OK" if len(scoped) >= 0.8 * len(recent) else "WARN", "queue rows carry mission:/slice: tags", pct(scoped))
    rep("OK" if len(wtp) >= 0.8 * len(recent) else "WARN", "queue rows carry worktree_path= (EC-3)", pct(wtp))

# ---- 5b. seats: spec audit, live conformance, instruction blocks, role skills, commit guard ----------------
if specs:
    import yaml
    sp = specs[0]
    au = run(["rig", "spec", "audit", sp], capture_output=True, text=True).stdout
    # OpenRig's audit reads any dotted name in CULTURE as a seat id; the Jev decision ids (review.merge_gate, …) are not
    # seats, so those findings are dropped. Every other finding still WARNs.
    try:
        jev_ids = set((yaml.safe_load(open(os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                                                         "config/decisions.yaml"))) or {}).get("decisions") or {})
    except OSError:
        jev_ids = set()
    findings = [f.strip() for f in re.findall(r"^\s*- (.+)$", au, re.M)]
    real = [f for f in findings if not ((m := re.match(r"culture references seat id '([^']+)'", f)) and m[1] in jev_ids)]
    clean = "audit clean" in au or (findings and not real)
    rep("OK" if clean else "WARN", "rig spec audit (OpenRig authoring check) is clean"
        + (f" (ignoring {len(findings) - len(real)} Jev decision id(s) read as seat ids)" if clean and findings else ""),
        "" if clean else (real[0] if real else (au.strip().splitlines()[1].strip() if len(au.strip().splitlines()) > 1
                                                  else "" if au.strip() else "no output from `rig spec audit` (is rig installed?)")))
    if running:
        dc = run(["rig", "doctor", "--spec", sp], capture_output=True, text=True).stdout
        rep("OK" if "[OK] spec_live_conformance" in dc else "FAIL", "running rig matches its spec (rig doctor --spec)")
    d = yaml.safe_load(read(sp))
    cfile = ((d.get("managed_blocks") or {}).get("claude-code")) or "CLAUDE.md"
    noblocks, stale, noskills = [], [], []
    for pod in d.get("pods", []):
        for mem in pod.get("members", []):
            cwd, rt = mem.get("cwd"), mem.get("runtime")
            seat = os.path.basename(cwd or "")
            f = os.path.join(cwd or "", "AGENTS.md" if rt == "codex" else cfile)
            txt = read(f) or ""
            if "OpenRig MANAGED BLOCK" not in txt:
                noblocks.append(seat); continue
            ref = (mem.get("agent_ref") or "").replace("path:", "")
            ay = yaml.safe_load(read(os.path.join(ref, "agent.yaml")) or "{}") or {}
            prof = (ay.get("profiles") or {}).get(mem.get("profile") or "default") or {}
            want = [x.split(":")[-1] for x in ((prof.get("uses") or {}).get("skills") or [])]
            sd = os.path.join(cwd or "", ".agents/skills" if rt == "codex" else ".claude/skills")
            miss = [x for x in want if not os.path.exists(os.path.join(sd, x, "SKILL.md"))]
            if miss:
                noskills.append(f"{seat}:{'/'.join(miss)}")
    # Stale blocks: exactly what agent-refresh-guidance would change (it names blocks by their path under rig/, as
    # OpenRig does, e.g. startup/context.md), so this check and the refresh can't disagree.
    rg = run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "agent-refresh-guidance"), W, "--json"],
                        capture_output=True, text=True)
    try:
        stale = [f"{c['seat']}/{c['file']} ({'; '.join(c['reasons'])})" for c in json.loads(rg.stdout)["changed"]]
    except (ValueError, KeyError, TypeError):
        stale = [f"agent-refresh-guidance {W} --json failed: {(rg.stderr or rg.stdout).strip()[-200:]}"]
    if not running:  # OpenRig writes instruction blocks and projects skills at launch
        noblocks, stale, noskills = [], [], []
        rep("WARN", "seat instructions and skills not checked: the rig is not running (rig up, then re-check)")
    rep("OK" if not noblocks else "FAIL", "every seat's instruction file has its OpenRig blocks",
        "run agent-refresh-guidance --apply: " + ", ".join(noblocks) if noblocks else "")
    rep("OK" if not stale else "WARN", "seat instructions carry the current CULTURE.md and startup files",
        "run agent-refresh-guidance --apply: " + ", ".join(stale[:6]) if stale else "")
    rep("OK" if not noskills else "WARN", "every seat has the skills its role declares", ", ".join(noskills[:6]))
def git(*a):
    return run(["git", "-C", REPO, *a], capture_output=True, text=True).stdout.strip()
TRUNK = (git("symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD").removeprefix("origin/")
         or git("branch", "--show-current") or "main")
behind = git("rev-list", "--count", f"{TRUNK}..origin/{TRUNK}")
rep("OK" if behind in ("0", "") else ("WARN" if behind.isdigit() and int(behind) < 20 else "FAIL"),
    f"shared checkout's {TRUNK} is current (new worktrees start from the trunk; agent-repos-sync.timer)",
    f"{behind} commits behind origin/{TRUNK}" if behind not in ("0", "") else "")
if TRUNK != "main":
    # OpenRig judges "merged" against a local ref named main: it must mirror origin/<trunk> (agent-project-new sets it,
    # agent-repos-sync keeps it current, the pre-push hook keeps it off the remote).
    mirror, want = git("rev-parse", "-q", "--verify", "refs/heads/main"), git("rev-parse", "-q", "--verify", f"refs/remotes/origin/{TRUNK}")
    rep("OK" if mirror and mirror == want else "FAIL", f"local main mirrors origin/{TRUNK} (OpenRig judges 'merged' against main)",
        "" if mirror and mirror == want else
        (f"main is {mirror[:8]}, origin/{TRUNK} is {want[:8]}: run agent-repos-sync" if mirror else "no local main: run agent-project-new again"))
    # the hook git actually runs (core.hooksPath respected), and it must be executable
    hooks = git("rev-parse", "--git-path", "hooks")
    pp_path = os.path.join(REPO, hooks) if not os.path.isabs(hooks) else hooks
    pp_path = os.path.join(pp_path, "pre-push")
    ok = "agent-stack.mainMirror" in (read(pp_path) or "") and os.access(pp_path, os.X_OK)
    rep("OK" if ok else "FAIL", "pre-push hook keeps the main mirror off the remote",
        "" if ok else f"git runs hooks from {os.path.dirname(pp_path)}: put an executable agent-stack pre-push check there (system/git-hooks/pre-push)")
tim = run(["systemctl", "--user", "is-active", "agent-repos-sync.timer"], capture_output=True, text=True).stdout.strip()
rep("OK" if tim == "active" else "FAIL", "agent-repos-sync.timer active (keeps every project's main current)")
hook = read(f"{REPO}/.git/hooks/pre-commit") or ""
rep("OK" if "OpenRig MANAGED BLOCK" in hook else "FAIL", "repo pre-commit hook refuses OpenRig seat blocks",
    "install system/git-hooks/pre-commit" if "OpenRig MANAGED BLOCK" not in hook else "")

# ---- 5. machine: seat skills + seat tools -------------------------------------------------------------
for d in (f"{HOME}/.claude/skills", f"{HOME}/.agents/skills"):
    have = all(os.path.exists(f"{d}/{s}/SKILL.md") for s in ("mission-slice-sop", "queue-handoff", "openrig-project-setup"))
    rep("OK" if have else "FAIL", f"{d}: mission-slice-sop, queue-handoff, openrig-project-setup (run ./install.sh --apply)")
rep("OK" if os.access(f"{HOME}/.local/share/agent-stack/seat-tools/rig", os.X_OK) else "FAIL",
    "seat-tools/rig installed (adds project tag + worktree_path)")
rep("OK" if "seat-tools" in (read(f"{HOME}/.config/agent-stack/env.sh") or "") else "FAIL",
    "env.sh puts seat-tools first on seats' PATH")

# ---- 5b. OpenRig version and local patches (2026-09-30: a stale pin downgraded 0.6.1 to 0.5.17, patches gone) ----
AS = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
ens = run([f"{AS}/bin/openrig-ensure", "--check"], capture_output=True, text=True)
lines = [l for l in ens.stdout.splitlines() if l.strip()] or [f"--  FAIL: openrig-ensure --check gave nothing ({ens.stderr.strip()[:120]})"]
for l in lines:   # "ok  <what>" / "--  WARN: <what>" / "--  FAIL: <what>"
    body = l[4:]
    lvl = "OK" if l.startswith("ok") else ("WARN" if body.startswith("WARN:") else "FAIL")
    rep(lvl, "OpenRig version and local patches (openrig-ensure --check)" if lvl == "OK" else body.split(": ", 1)[-1][:160],
        body if lvl == "OK" else "install.sh never downgrades; run openrig-apply-patches for missing patches")

# ---- 6. never prompt: no Claude or Codex seat stops to ask for permission (agent-never-prompt-check) -----------
np = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "agent-never-prompt-check"), "--json"]
np += (["--spec", specs[0]] if specs else []) + (["--rig", rig] if rig else [])
try:
