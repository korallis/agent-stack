#!/usr/bin/env python3
"""semver-cmp <a> <b>: prints -1, 0 or 1 by SemVer 2.0 precedence (a leading "v" is ignored; build metadata ignored;
a prerelease ranks BELOW its release: 0.6.1-rc.1 < 0.6.1). Exit 2 when either isn't a version."""
import re, sys
RX = re.compile(r"^v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$")
def key(v):
    m = RX.match(v.strip())
    if not m:
        sys.exit(2)
    pre = m.group(4)
    ids = [(0, int(x), "") if x.isdigit() else (1, 0, x) for x in pre.split(".")] if pre else None
    return (int(m.group(1)), int(m.group(2)), int(m.group(3))), ids
def cmp(a, b):
    (ca, pa), (cb, pb) = key(a), key(b)
    if ca != cb:
        return (ca > cb) - (ca < cb)
    if pa == pb:
        return 0
    if pa is None:
        return 1          # release > prerelease
    if pb is None:
        return -1
    for x, y in zip(pa, pb):
        if x != y:
            return (x > y) - (x < y)
    return (len(pa) > len(pb)) - (len(pa) < len(pb))
if len(sys.argv) != 3:
    sys.exit(__doc__)
print(cmp(sys.argv[1], sys.argv[2]))
