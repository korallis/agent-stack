#!/usr/bin/env python3
"""agent-playwright-retention [--dry-run] [--migrate]: age out Playwright MCP artifacts (WO83).

The MCP's files (page snapshots, console and network logs, screenshots, PDFs) live in
~/.local/state/agent-stack/playwright-mcp/<seat>/ (agent-playwright-mcp). A page snapshot of a staging app holds what
the page showed, client data included, so nothing there is kept for long:
  - files older than KEEP_HOURS (default 48) are deleted;
  - in a seat dir of a client-data rig (CLIENT_DATA_RIGS, space-separated rig names) after CLIENT_DATA_HOURS (default 6);
  - what no seat can be told for (top-level files, the old shared net/ tree, unattributed-*: written by an MCP from
    before the per-seat dirs, any rig's, client data included) after UNATTRIBUTED_HOURS (default KEEP_HOURS); set it to
    the client-data window when any rig is client-data.
Settings: ~/.config/agent-stack/playwright-retention.env (NAME=value lines), overridden by the environment.
A seat keeps evidence by copying it into its slice's proof dir; this dir is scratch.

--migrate (install.sh): top-level files the MCP wrote before it had a dir per seat, untouched for an hour, are MOVED
(renamed, never deleted, never into a link) into unattributed-<UTC date>/ (0700); that run deletes nothing. The old
net/ tree stays where it is: seats on an MCP started before the per-seat dirs still write their logs there until they
relaunch. The hourly run ages all of it (unattributed-*, the old net/ tree, stray top-level files) by UNATTRIBUTED_HOURS.
Their seat can't be told, so the operator purges a client-data window on request. A symlinked MCP dir is refused.
Only regular files and symlinks (never followed) are removed; emptied subdirs go too, but never a seat dir or its net/.
Prints one line per dir it changed and a total. Runs hourly (agent-playwright-retention.timer).
"""
import math, os, re, sys, time

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, ".local/state/agent-stack/playwright-mcp")
CONF = os.path.join(HOME, ".config/agent-stack/playwright-retention.env")
SEAT = re.compile(r"^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$")
ARCHIVE = re.compile(r"^unattributed-\d{4}-\d{2}-\d{2}$")   # exactly what --migrate creates (a seat name is never this)
MIGRATE_MIN_AGE = 3600   # seconds since a top-level file was last written before --migrate moves it


def settings():
    s = {"KEEP_HOURS": "48", "CLIENT_DATA_HOURS": "6", "CLIENT_DATA_RIGS": "", "UNATTRIBUTED_HOURS": ""}
    try:
        for line in open(CONF):
            m = re.match(r"^\s*([A-Z_]+)\s*=\s*(.*?)\s*$", line)
            if m and m.group(1) in s:
                s[m.group(1)] = m.group(2).strip("\"'")
    except OSError:
        pass
    for k in s:
        if k in os.environ:
            s[k] = os.environ[k]
    try:
        keep, client = float(s["KEEP_HOURS"]), float(s["CLIENT_DATA_HOURS"])
        unattributed = float(s["UNATTRIBUTED_HOURS"]) if s["UNATTRIBUTED_HOURS"].strip() else keep
    except ValueError:
        sys.exit("agent-playwright-retention: KEEP_HOURS, CLIENT_DATA_HOURS and UNATTRIBUTED_HOURS must be numbers")
    # nan and inf would silently keep everything (QA PR87)
    if not all(math.isfinite(v) and v > 0 for v in (keep, client, unattributed)):
        sys.exit("agent-playwright-retention: KEEP_HOURS, CLIENT_DATA_HOURS and UNATTRIBUTED_HOURS must be finite numbers above 0")
    return keep, client, set(s["CLIENT_DATA_RIGS"].split()), unattributed


def migrate(dry, now):
    """Moves pre-WO83 top-level files into unattributed-<date>/: only what no MCP touched for MIGRATE_MIN_AGE (a seat on
    an old MCP may still copy a screenshot it just took), and never the old net/ tree, which seats on an old MCP still
    write their network/console logs to until they relaunch. Renames only; never into a link."""
    legacy = []
    for n in sorted(os.listdir(BASE)):
        if SEAT.match(n) or n == "local" or n == "net" or n.startswith("unattributed-"):
            continue
        try:
            st = os.lstat(os.path.join(BASE, n))
        except OSError:
            continue
        if now - st.st_mtime >= MIGRATE_MIN_AGE:
            legacy.append(n)
    if not legacy:
        return 0
    dest = os.path.join(BASE, "unattributed-" + time.strftime("%Y-%m-%d", time.gmtime(now)))
    if os.path.lexists(dest) and (os.path.islink(dest) or not os.path.isdir(dest)):
        sys.exit(f"agent-playwright-retention: {dest.replace(HOME, '~')} is not a plain directory (a link?): refusing to move files into it")
    if not dry:
        if not os.path.lexists(dest):
            os.mkdir(dest, 0o700)
        os.chmod(dest, 0o700)   # dest was just checked to be a plain directory, not a link
    for n in legacy:
        target, k = os.path.join(dest, n), 1
        while os.path.lexists(target):
            target, k = os.path.join(dest, f"{n}.{k}"), k + 1
        if not dry:
            os.rename(os.path.join(BASE, n), target)   # same filesystem; a link moves as a link
    print(f"{'would move' if dry else 'moved'} {len(legacy)} entries into {dest.replace(HOME, '~')}")
    return len(legacy)


def prune(top, hours, now, dry, keep_dirs):
    """Deletes files under `top` older than `hours`; removes emptied subdirs except `keep_dirs`. (count, bytes)"""
    cutoff, n, size = now - hours * 3600, 0, 0
    for root, dirs, files in os.walk(top, topdown=False, followlinks=False):
        for f in files:
            p = os.path.join(root, f)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if st.st_mtime < cutoff:
                n, size = n + 1, size + st.st_size
                if not dry:
                    os.unlink(p)
        for d in dirs:
            p = os.path.join(root, d)
            if os.path.islink(p):
                try:
                    if os.lstat(p).st_mtime < cutoff:
                        n += 1
                        if not dry:
                            os.unlink(p)
                except OSError:
                    pass
            elif p not in keep_dirs and not dry:
                try:
                    os.rmdir(p)   # only when empty
                except OSError:
                    pass
    return n, size


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    bad = [a for a in argv if a not in ("--dry-run", "--migrate")]
    if bad:
        print(f"agent-playwright-retention: unknown argument {bad[0]!r}", file=sys.stderr)
        return 2
    dry = "--dry-run" in argv
    keep, client, rigs, unattributed = settings()
    if os.path.islink(BASE):   # never clean (or move) through a link: it would act on another tree (QA PR87)
        sys.exit(f"agent-playwright-retention: {BASE.replace(HOME, '~')} is a symbolic link: refusing")
    if not os.path.isdir(BASE):
        print("nothing to do: no Playwright MCP dir yet")
        return 0
    now, total, total_bytes = time.time(), 0, 0
    if "--migrate" in argv:   # moves only: the one-off never deletes; the hourly run ages the moved files later
        if not migrate(dry, now):
            print("nothing to migrate")
        return 0
    for name in sorted(os.listdir(BASE)):
        p = os.path.join(BASE, name)
        if os.path.islink(p) or not os.path.isdir(p):
            # a top-level file or link: written by an MCP from before the per-seat dirs (until its seat relaunches)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if st.st_mtime < now - unattributed * 3600:
                total, total_bytes = total + 1, total_bytes + st.st_size
                if not dry:
                    os.unlink(p)
            continue
        # a seat dir (seat@rig, whatever its name starts with): its rig's window (QA PR91); the old shared net/ tree and
        # the --migrate archives: no rig can be told
        if SEAT.match(name):
            hours = client if name.split("@", 1)[1] in rigs else keep
        else:
            hours = unattributed if (name == "net" or ARCHIVE.match(name)) else keep
        n, size = prune(p, hours, now, dry, {os.path.join(p, "net")})
        if n:
            print(f"{'would delete' if dry else 'deleted'} {n} files ({size // 1024} KiB) older than {hours:g} h in {p.replace(HOME, '~')}")
        total, total_bytes = total + n, total_bytes + size
    print(f"{'would delete' if dry else 'deleted'} {total} files ({total_bytes // 1024} KiB); keep {keep:g} h, client-data rigs {client:g} h"
          f" ({', '.join(sorted(rigs)) or 'none set'}), unattributed {unattributed:g} h")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
