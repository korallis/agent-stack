#!/usr/bin/env bash
# agent-heavy <build|browser> [--wait SECONDS] [--max-runtime SPAN] [--allow-long] [--priority routine|urgent|critical] -- <command...>
# agent-heavy status [build|browser]   who holds each slot (seat, cwd, command, age, remaining runtime) and who waits, in
#                                      order (position, seat, priority, waiting time); read-only
# Runs a heavy build or browser test under a SHARED machine budget so 24 agents cannot starve the host, and in a
# filesystem sandbox (bwrap; see "The filesystem sandbox" below) so a job can't delete or change anything outside
# its own repository, ~/.cache and /tmp:
#   - concurrency slots (flock)            build: 2 at once, browser: 2 at once
#   - cgroup limits via systemd-run --user build: 8 CPUs / 14G RAM, browser: 4 CPUs / 8G RAM, no swap; a run over
#                                          its ceiling is OOM-killed inside its own scope (exit 137, says so, logs it)
#                                          instead of pushing the whole host into swap
#   - one ceiling for ALL heavy runs       every scope sits in agent-heavy.slice, MemoryMax 24G (AGENT_HEAVY_TOTAL_MEM;
#                                          "infinity" lifts it): four slots' ceilings would add up to most of the host
#   - worker hints in the job's env        PYTEST_XDIST_AUTO_NUM_WORKERS (pytest -n auto), VITEST_MAX_WORKERS (Vitest
#                                          4+), VITEST_MAX_THREADS / VITEST_MAX_FORKS (Vitest 3): 4 each unless set
#                                          (AGENT_HEAVY_WORKERS). node --test and jest read none: pass
#                                          --test-concurrency=4 / --maxWorkers=4 yourself.
#   - a max runtime per job (RuntimeMaxSec) build: 45min, browser: 30min; the job is stopped at the limit, so a hung or
#                                          endless job can't hold a slot; it then exits 124 (as timeout(1)) and logs
#                                          the stop (journalctl -t agent-heavy).
#                                          --max-runtime <N|Ns|Nmin|Nh> per call.
#   - a fair wait order per class         waiters queue first come, first served: each takes a ticket (arrival time, pid,
#                                          priority) and may try a slot only while it is among the first K live tickets,
#                                          K = free slots, so a newer job can't win a freed slot over an older one.
#                                          --priority urgent|critical (or AGENT_HEAVY_PRIORITY) sorts ahead of routine:
#                                          critical-path QA and merge-gate re-runs use it. It only orders the queue; it
#                                          never stops or preempts a running job. A dead waiter's ticket is skipped and
#                                          removed (its pid gone, or reused by another process).
# It is for jobs that finish. Long-lived servers (npm start / start:* / dev / serve / preview, next start|dev, vite,
# serve, http-server) are refused: run them outside agent-heavy (Playwright's webServer starts its own inside the test
# run). --allow-long lifts that refusal for a bounded job that only looks like a server; the max runtime still applies.
# Nesting: the job sees AGENT_HEAVY_ACTIVE (the classes it holds, e.g. "browser") and AGENT_HEAVY_SLOT (e.g.
# "browser.1"). A nested agent-heavy call of a class already held runs INLINE in that slot: a second slot of the same
# class would let one run hold both, and two such runs would wait on each other until the cap. A nested call of a
# different class (a build inside a browser run) takes its own slot as usual. That is allowed, but it holds two slots
# at once, so two runs nesting in opposite orders can still wait on each other until --wait runs out (exit 75).
# Without a systemd user session (no systemd-run, or no user bus) it warns and runs the job without CPU/memory limits,
# under timeout(1) for the max runtime.
# Budgets are ordinary code/config, never a model decision. Override with
# AGENT_HEAVY_<CLASS>_{SLOTS,CPU,MEM,SWAP,MAX_RUNTIME}, AGENT_HEAVY_TOTAL_MEM and AGENT_HEAVY_WORKERS.
set -euo pipefail
dir=${AGENT_HEAVY_DIR:-${XDG_RUNTIME_DIR:-/tmp}/agent-heavy}   # the slot locks (AGENT_HEAVY_DIR: tests only)
slice=${AGENT_HEAVY_SLICE:-agent-heavy.slice}                    # the all-heavy ceiling (AGENT_HEAVY_SLICE: tests only)
PROC=${AGENT_HEAVY_PROC:-/proc}
# A process's start time (clock ticks since boot, /proc/<pid>/stat field 22): with the pid, it names one process, so a
# ticket whose pid was reused is seen as dead.
pstart() { sed 's/^.*) //' "$PROC/$1/stat" 2>/dev/null | awk '{print $20}'; }
# The live tickets of a class's queue, in order (priority, then arrival). "--clean" removes dead ones (never in status).
tickets() {   # <class> [--clean]
  local t p s
  for t in $(ls "$dir/queue.$1" 2>/dev/null | grep -E '^[0-2]-[0-9]{20}-[0-9]+\.ticket$' | LC_ALL=C sort); do
    t=$dir/queue.$1/$t
    p=$(sed -n 's/^pid=//p' "$t" 2>/dev/null) s=$(sed -n 's/^pstart=//p' "$t" 2>/dev/null)
    if [[ -n $p && -n $s && $(pstart "$p") == "$s" ]]; then echo "$t"; elif [[ ${2:-} == --clean ]]; then rm -f "$t"; fi
  done; }
dur() { local t=$1; ((t >= 3600)) && printf '%dh%02dm' $((t / 3600)) $((t % 3600 / 60)) || printf '%dm%02ds' $((t / 60)) $((t % 60)); }

# status: read-only; never takes a lock. A slot's holders are the processes with an open file on the lock (its real
# path, so a symlinked runtime dir still matches) that actually carries the FLOCK: /proc/<pid>/fdinfo/<fd> lists the
# lock only on the locked open file (the agent-heavy that took the slot and the job that inherited the fd), never on
# another fd that merely opened the file. No device numbers are compared: on Btrfs stat's device (the subvolume's) and
# the lock table's (the filesystem's) differ for the same file (WO82). A lock the table shows (same device:inode, or
# the same inode on another device number) without a visible holder is "owner unknown"; what can't be observed is
# reported as unknown, never as free. (/proc/locks's own pid is only the short-lived `flock` helper.)
# holders <lock> [pid...]: the pids (all, or only those given) whose fd on the lock's real path carries a FLOCK.
holders() {
  local lock real f p fd; lock=$1; shift
  real=$(readlink -f "$lock") || return 0
  local where=("$PROC"/[0-9]*/fd); [[ $# -gt 0 ]] && where=("${@/#/$PROC/}") && where=("${where[@]/%//fd}")
  { find "${where[@]}" -maxdepth 1 -lname "$real" 2>/dev/null || true; } | while read -r f; do   # other users' fd dirs are unreadable
    fd=${f##*/} p=${f%/fd/*}; p=${p##*/}
    if grep -qsE "^lock:.*[[:space:]]FLOCK[[:space:]]" "$PROC/$p/fdinfo/$fd"; then echo "$p"; fi   # (set -e: never a failing last command)
  done | sort -un
}
if [[ ${1:-} == status ]]; then
  case ${2:-} in "") classes="build browser";; build|browser) classes=$2;; *) echo "usage: agent-heavy status [build|browser]" >&2; exit 2;; esac
  now=$(date +%s)
  locks=$(cat "$PROC/locks" 2>/dev/null) || locks=""
  [[ -n $locks || -r $PROC/locks ]] && table=1 || table=0
  for c in $classes; do
    [[ $c == build ]] && n=${AGENT_HEAVY_BUILD_SLOTS:-2} || n=${AGENT_HEAVY_BROWSER_SLOTS:-2}
    for i in $(seq 1 "$n"); do
      lock=$dir/$c.$i.lock holder=$dir/$c.$i.holder pid=""
      [[ -e $lock ]] || { echo "$c $i/$n  free"; continue; }
      [[ $table == 1 ]] || { echo "$c $i/$n  unknown (cannot read $PROC/locks)"; continue; }
      read -r maj min ino < <(stat -L -c '%Hd %Ld %i' "$lock")
      id=$(printf '%02x:%02x:%s' "$maj" "$min" "$ino")
      pids=$(holders "$lock")
      if [[ -z $pids ]]; then
        # no visible holder: free unless the table shows a FLOCK on this file (by device:inode, or by inode alone when the
        # devices disagree, as on Btrfs)
        if awk -v id="$id" -v ino="$ino" '$2 == "FLOCK" && ($6 == id || $6 ~ (":" ino "$")) { f = 1 } END { exit !f }' <<<"$locks"; then
          echo "$c $i/$n  held  owner unknown (lock $id is held but no holder is visible)"
        else echo "$c $i/$n  free"; fi
        continue
      fi
      hp=$(sed -n 's/^pid=//p' "$holder" 2>/dev/null || true)
      if [[ -n $hp ]] && grep -qx "$hp" <<<"$pids"; then
        get() { sed -n "s/^$1=//p" "$holder"; }
        age=$((now - $(get start))) max=$(get max)
        rem=$((max - age)); ((rem < 0)) && rem=0
        echo "$c $i/$n  held  seat=$(get seat)  age=$(dur $age)  remaining=$(dur $rem)  cwd=$(get cwd)  cmd=$(get cmd)"
        continue
      fi
      # no holder file for this run (an older agent-heavy): prefer the agent-heavy process, else the holder that took the
      # lock, i.e. the one whose parent is not itself a holder (children only inherited the fd)
      for p in $pids; do grep -qa agent-heavy "$PROC/$p/cmdline" 2>/dev/null && { pid=$p; break; }; done
      if [[ -z $pid ]]; then
        for p in $pids; do
          pp=$(awk '{print $4}' 2>/dev/null < "$PROC/$p/stat" || true)   # ppid (comm has no spaces for these)
          grep -qx "${pp:-x}" <<<"$pids" || { pid=$p; break; }
        done
      fi
      pid=${pid:-$(head -n1 <<<"$pids")}
      seat=$(tr '\0' '\n' 2>/dev/null < "$PROC/$pid/environ" | sed -n 's/^OPENRIG_SESSION_NAME=//p' || true)
      cmd=$(tr '\0' ' ' 2>/dev/null < "$PROC/$pid/cmdline" | sed 's/^.* -- //; s/ $//' || true)
      age=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ' || true)
      echo "$c $i/$n  held  seat=${seat:-unknown}  age=${age:+$(dur "$age")}  remaining=unknown (no holder record)  cwd=$(readlink "$PROC/$pid/cwd" 2>/dev/null || true)  cmd=${cmd:-unknown}  pid=$pid"
    done
    k=0
    while read -r t; do
      [[ -n $t ]] || continue
      k=$((k + 1))
      tget() { sed -n "s/^$1=//p" "$t"; }
      echo "$c queue $k  seat=$(tget seat)  priority=$(tget priority)  waiting=$(dur $((now - $(tget arrived))))  pid=$(tget pid)  cwd=$(tget cwd)  cmd=$(tget cmd)"
    done < <(tickets "$c")
    ((k)) || echo "$c queue  empty"
  done
  exit 0
fi

usage="usage: agent-heavy <build|browser> [--wait S] [--max-runtime SPAN] [--allow-long] -- cmd..."
class=${1:?$usage}; shift
wait_s=1800 max="" allow_long=0 priority=${AGENT_HEAVY_PRIORITY:-routine}
while [[ $# -gt 0 && $1 != "--" ]]; do case $1 in
  --wait) wait_s=$2; shift 2;; --max-runtime) max=$2; shift 2;; --allow-long) allow_long=1; shift;;
  --priority) priority=${2:-}; shift 2;;
  *) echo "unknown arg $1" >&2; exit 2;; esac; done
case $priority in critical) rank=0;; urgent) rank=1;; routine) rank=2;;
  *) echo "agent-heavy: bad priority '$priority' (routine, urgent or critical)" >&2; exit 2;; esac
# The resolved lane is the default for every nested call (inline or in another class), whether it came from the flag
# or the environment.
export AGENT_HEAVY_PRIORITY=$priority
[[ ${1:-} == "--" ]] && shift
[[ $# -gt 0 ]] || { echo "no command given" >&2; exit 2; }
case $class in
  build)   slots=${AGENT_HEAVY_BUILD_SLOTS:-2};   cpu=${AGENT_HEAVY_BUILD_CPU:-800%};   mem=${AGENT_HEAVY_BUILD_MEM:-14G}
           swap=${AGENT_HEAVY_BUILD_SWAP:-0}; max=${max:-${AGENT_HEAVY_BUILD_MAX_RUNTIME:-45min}} ;;
  browser) slots=${AGENT_HEAVY_BROWSER_SLOTS:-2}; cpu=${AGENT_HEAVY_BROWSER_CPU:-400%}; mem=${AGENT_HEAVY_BROWSER_MEM:-8G}
           swap=${AGENT_HEAVY_BROWSER_SWAP:-0}; max=${max:-${AGENT_HEAVY_BROWSER_MAX_RUNTIME:-30min}} ;;
  *) echo "class must be build or browser" >&2; exit 2 ;;
esac
# A span in seconds: N, Ns, Nmin (or Nm), Nh.
secs() { [[ $1 =~ ^([0-9]+)(s|m|min|h)?$ ]] || return 1
  case ${BASH_REMATCH[2]} in h) echo $((BASH_REMATCH[1] * 3600));; m|min) echo $((BASH_REMATCH[1] * 60));; *) echo "${BASH_REMATCH[1]}";; esac; }
max_s=$(secs "$max") && [[ $max_s -gt 0 ]] || { echo "agent-heavy: bad max runtime '$max' (use N, Ns, Nmin or Nh)" >&2; exit 2; }

# Is this an obvious long-lived server? (Only the obvious forms: package-manager scripts and well-known server CLIs.)
# Options are skipped, including those that take a value (npm --prefix app, pnpm --filter web, npx -p pkg).
takes_value() { [[ $1 =~ ^(--prefix|-C|--dir|--cwd|--filter|-F|--workspace|-w|--package|-p|--call|-c|--mode|-m|--config|--port|--base)$ ]]; }
server_bin() { local name=${1##*/}; shift; name=${name%@*}; [[ -n $name ]] || return 1
  local a
  case $name in
    next) for a in "$@"; do [[ $a == -* ]] && continue; [[ $a == start || $a == dev ]]; return; done; return 1 ;;
    vite) for a in "$@"; do [[ $a =~ ^(build|optimize|-v|--version|-h|--help)$ ]] && return 1; done; return 0 ;;
    serve|http-server|live-server) for a in "$@"; do [[ $a =~ ^(-v|--version|-h|--help)$ ]] && return 1; done; return 0 ;;
    *) return 1 ;;
  esac; }
server() { local a=("$@") i=0
  while [[ $i -lt ${#a[@]} ]]; do   # env, its options (-u NAME, -C DIR, -i, --) and VAR=value assignments
    case ${a[i]} in
      env|-i|--ignore-environment|-0|--null|--) i=$((i + 1)) ;;
      -u|--unset|-C|--chdir) i=$((i + 2)) ;;
      -u*|--unset=*|-C*|--chdir=*) i=$((i + 1)) ;;
      *) [[ ${a[i]} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && i=$((i + 1)) || break ;;
    esac
  done
  local c=${a[i]##*/}; i=$((i + 1))
  skip_opts() { while [[ ${a[i]:-} == -* ]]; do takes_value "${a[i]}" && [[ ${a[i]} != *=* ]] && i=$((i + 1)); i=$((i + 1)); done; }
  case $c in
    npm|pnpm|yarn|bun)
      skip_opts
      [[ $c == yarn && ${a[i]:-} == workspace ]] && { i=$((i + 2)); skip_opts; }   # yarn workspace <name> <script>
      if [[ ${a[i]:-} == exec || ${a[i]:-} == x || ${a[i]:-} == dlx ]]; then i=$((i + 1)); skip_opts; server_bin "${a[@]:i}"; return; fi
      [[ ${a[i]:-} == run || ${a[i]:-} == run-script ]] && { i=$((i + 1)); skip_opts; }
      [[ ${a[i]:-} =~ ^(start|dev|serve|preview)(:.*)?$ ]] ;;
    npx|bunx) skip_opts; server_bin "${a[@]:i}" ;;
    *) server_bin "$c" "${a[@]:i}" ;;
  esac; }
if [[ $allow_long == 0 ]] && server "$@"; then
  echo "agent-heavy: '$*' looks like a long-lived server. Run servers outside agent-heavy: a server never finishes, so it" \
       "would hold a shared $class slot until the max runtime. Wrap only the tests/builds that use it. If this is really a" \
       "bounded job, re-run with --allow-long." >&2
  exit 2
fi

# The nesting markers are only trusted when verified: the named slot's lock must be held by one of this process's own
# ancestors (the agent-heavy that took it, or the job that inherited its locked fd): an ancestor's fd on the lock that
# carries the FLOCK in /proc/<pid>/fdinfo (the file, not device numbers: see holders above). A
# marker that can't be verified (leaked into a long-lived shell, set by hand, or naming a slot someone else holds) is
# dropped and the run takes a slot normally: it never skips the budget.
held_by_ancestor() {   # <class.N>
  local lock=$dir/$1.lock p
  [[ -e $lock ]] || return 1
  p=$PPID
  while [[ -n $p && $p -gt 1 ]]; do
    [[ -n $(holders "$lock" "$p") ]] && return 0
    p=$(sed 's/^.*) //' "$PROC/$p/stat" 2>/dev/null | awk '{print $2}')
  done
  return 1
}
if [[ " ${AGENT_HEAVY_ACTIVE:-} " == *" $class "* ]]; then
  mine=""
  for s in ${AGENT_HEAVY_SLOT:-}; do [[ $s == "$class".* ]] && held_by_ancestor "$s" && { mine=$s; break; }; done
  if [[ -n $mine ]]; then
    echo "[agent-heavy] nested $class run: already inside $mine; running inline (no second slot)" >&2
    exec "$@"
  fi
  echo "[agent-heavy] ignoring AGENT_HEAVY_ACTIVE=$AGENT_HEAVY_ACTIVE: no $class slot is held by this process's ancestors; taking a slot" >&2
  AGENT_HEAVY_ACTIVE=$(tr ' ' '\n' <<<"$AGENT_HEAVY_ACTIVE" | grep -vx "$class" | paste -sd' ' || true)
  AGENT_HEAVY_SLOT=$(tr ' ' '\n' <<<"${AGENT_HEAVY_SLOT:-}" | grep -v "^$class\." | paste -sd' ' || true)
fi

# The filesystem sandbox (2026-10-04: a mutation run of a test-harness cleanup called rmSync('/', {recursive: true}) as
# the owner, outside any sandbox, and wiped ~/.config, ~/.local/share and the dotfiles). Every job runs under bwrap:
# the whole filesystem read-only, except the job's own repository (its git top level and git common dir), ~/.cache,
# the agents' worktrees (~/Projects/*.worktrees), /tmp, its TMPDIR and agent-heavy's own lock dir. HOME and the XDG
# dirs point at a per-run scratch dir under ~/.cache/agent-heavy (removed afterwards); real config a tool needs is
# passed read-only by path (gh, git, mise, Playwright's browsers). No way to skip it: if bwrap can't run, the job is
# refused. Inside, no privileges can be gained (no sudo) and the host's groups are unmapped (no docker socket).
real_home=$(getent passwd "$(id -u)" | cut -d: -f6); real_home=${real_home:-$HOME}
bwrap=${AGENT_HEAVY_BWRAP:-bwrap}   # tests only
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=""
rw=("$top" "$real_home/.cache" "$dir")
[[ ${AGENT_HEAVY_TMP_RW:-1} == 0 ]] || rw+=(/tmp)   # AGENT_HEAVY_TMP_RW=0: tests only (stricter, never looser)
[[ -n $common ]] && rw+=("$common")
for w in "$real_home"/Projects/*.worktrees; do [[ -d $w ]] && rw+=("$w"); done
[[ -n ${TMPDIR:-} && -d $TMPDIR ]] && rw+=("$TMPDIR")
for p in "${rw[@]}"; do
  r=$(realpath -m "$p")
  if [[ $r == / || $real_home/ == "$r"/* ]]; then
    echo "agent-heavy: refused: the job would get write access to $r, which holds your home directory. Run it from a" \
         "repository or worktree (cd into it), not from ${r}." >&2
    exit 2
  fi
done
if ! "$bwrap" --ro-bind / / --dev-bind /dev /dev true 2>/dev/null; then
  echo "agent-heavy: refused: the filesystem sandbox (bwrap) can't run here, and jobs never run without it." >&2
  exit 78
fi
sandbox() {   # <scratch> -- cmd...: the bwrap prefix for one job
  local sc=$1 a=(--ro-bind / / --dev-bind /dev /dev --bind /proc /proc) p; shift
  for p in "${rw[@]}"; do a+=(--bind "$p" "$p"); done
  a+=(--chdir "$PWD" --die-with-parent --setenv HOME "$sc/home" --setenv XDG_CONFIG_HOME "$sc/config"
      --setenv XDG_DATA_HOME "$sc/data" --setenv XDG_STATE_HOME "$sc/state" --setenv XDG_CACHE_HOME "$sc/cache"
      --setenv AGENT_HEAVY_REAL_HOME "$real_home"
      --setenv GH_CONFIG_DIR "${GH_CONFIG_DIR:-$real_home/.config/gh}"
      --setenv MISE_CONFIG_DIR "${MISE_CONFIG_DIR:-$real_home/.config/mise}"
      --setenv MISE_DATA_DIR "${MISE_DATA_DIR:-$real_home/.local/share/mise}"
      --setenv MISE_STATE_DIR "${MISE_STATE_DIR:-$real_home/.local/state/mise}"
      --setenv npm_config_cache "${npm_config_cache:-$real_home/.cache/agent-heavy/npm}")
  [[ -z ${GIT_CONFIG_GLOBAL:-} && -f $real_home/.gitconfig ]] && a+=(--setenv GIT_CONFIG_GLOBAL "$real_home/.gitconfig")
  [[ -z ${GIT_CONFIG_GLOBAL:-} && ! -f $real_home/.gitconfig && -f $real_home/.config/git/config ]] && a+=(--setenv GIT_CONFIG_GLOBAL "$real_home/.config/git/config")
  [[ -z ${PLAYWRIGHT_BROWSERS_PATH:-} && -d $real_home/.cache/ms-playwright ]] && a+=(--setenv PLAYWRIGHT_BROWSERS_PATH "$real_home/.cache/ms-playwright")
  printf '%s\0' "$bwrap" "${a[@]}" --
}
total=${AGENT_HEAVY_TOTAL_MEM:-24G} workers=${AGENT_HEAVY_WORKERS:-4}
# Test runners default to one worker per core (32 here, ~1 GB each): a hint the job's tools read, unless already set.
export PYTEST_XDIST_AUTO_NUM_WORKERS=${PYTEST_XDIST_AUTO_NUM_WORKERS:-$workers} VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-$workers} \
  VITEST_MAX_THREADS=${VITEST_MAX_THREADS:-$workers} VITEST_MAX_FORKS=${VITEST_MAX_FORKS:-$workers}
# A systemd user session to put the job in a scope: systemd-run, and a user manager that answers.
if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then systemd=1; else systemd=0; fi
cmdline() { printf '%s ' "$@" | tr '\n' ' ' | sed 's/ $//'; }
log() { logger -t agent-heavy "$1: seat=${OPENRIG_SESSION_NAME:-$USER} class=$class slot=$i runtime=$(( $(date +%s) - start ))s max=$max cwd=$PWD cmd=$(cmdline "${@:2}")" \
  2>/dev/null || true; }
focused="Rerun it focused: a subset of the tests, or fewer workers (node --test --test-concurrency=4, vitest --maxWorkers=4,
  jest --maxWorkers=4, pytest -n 4)"

mkdir -p "$dir/queue.$class"
deadline=$(( $(date +%s) + wait_s ))
# This waiter's ticket: written whole, then renamed into the queue (a reader never sees half a ticket). Its name sorts
# by priority, then arrival (ns), so the queue order is the name order.
ticket=$dir/queue.$class/$rank-$(printf '%020d' "$(date +%s%N)")-$$.ticket arrived=$(date +%s)
put_ticket() {
  printf 'pid=%s\npstart=%s\nseat=%s\npriority=%s\narrived=%s\ncwd=%s\ncmd=%s\n' "$$" "$(pstart $$)" "${OPENRIG_SESSION_NAME:-$USER}" \
    "$priority" "$arrived" "$PWD" "$(cmdline "$@")" > "$dir/queue.$class/.$$.tmp" && mv -f "$dir/queue.$class/.$$.tmp" "$ticket"; }
put_ticket "$@"
trap 'rm -f "$ticket" "$dir/queue.$class/.$$.tmp"' EXIT
# How many slots are free right now: each is probed with a non-blocking lock that is released at once.
free_slots() { local n=0 j f
  for j in $(seq 1 "$slots"); do exec {f}>"$dir/$class.$j.lock"; flock -n "$f" && n=$((n + 1)); exec {f}>&-; done; echo $n; }
announced=0
while :; do
  mapfile -t queue < <(tickets "$class" --clean)
  pos=-1; for k in "${!queue[@]}"; do [[ ${queue[k]} == "$ticket" ]] && { pos=$k; break; }; done
  ((pos >= 0)) || { put_ticket "$@"; continue; }   # removed under us (e.g. by hand): take the same place again
  free=0; ((pos < slots)) && free=$(free_slots)
  if ((pos >= free && announced == 0)); then
    echo "[agent-heavy] waiting for a $class slot: position $((pos + 1)) of ${#queue[@]} ($priority); see agent-heavy status" >&2
    announced=1
  fi
  for i in $(seq 1 "$slots"); do
    ((pos < free)) || break
    exec {fd}>"$dir/$class.$i.lock"
    if flock -n "$fd"; then
      rm -f "$ticket"   # out of the queue: this run holds a slot now
      echo "[agent-heavy] $class slot $i/$slots (cpu=$cpu mem=$mem swap=$swap all-heavy=$total max=$max workers=$workers) seat=${OPENRIG_SESSION_NAME:-$USER}" >&2
      unit="agent-heavy-$class-$i-$$" start=$(date +%s) rc=0
      holder=$dir/$class.$i.holder   # for `agent-heavy status`; cmd last, since it may hold anything
      printf 'pid=%s\nseat=%s\ncwd=%s\nstart=%s\nmax=%s\ncmd=%s\n' "$$" "${OPENRIG_SESSION_NAME:-$USER}" "$PWD" "$start" "$max_s" \
        "$(printf '%s ' "$@" | tr '\n' ' ' | sed 's/ $//')" > "$holder"
      trap 'rm -f "$holder"' EXIT
      export AGENT_HEAVY_ACTIVE="${AGENT_HEAVY_ACTIVE:+$AGENT_HEAVY_ACTIVE }$class" AGENT_HEAVY_SLOT="${AGENT_HEAVY_SLOT:+$AGENT_HEAVY_SLOT }$class.$i"
      scratch=$real_home/.cache/agent-heavy/run-$unit
      mkdir -p "$scratch"/{home,config,data,state,cache} "$real_home/.cache/agent-heavy/npm"
      trap 'rm -f "$holder"; rm -rf "${scratch:?}"' EXIT
      mapfile -d '' -t box < <(sandbox "$scratch")
      orig=("$@"); set -- "${box[@]}" "$@"
      if [[ $systemd == 0 ]]; then
        echo "[agent-heavy] WARN: no systemd user session (systemd-run --user unavailable): running WITHOUT the CPU and memory" \
             "limits, only the slot and the max runtime" >&2
        timeout --kill-after=30 "$max_s" "$@" || rc=$?
        if [[ $rc == 124 || $rc == 137 && $(( $(date +%s) - start )) -ge $max_s ]]; then
          log "stopped at the $class max runtime" "${orig[@]}"
          echo "[agent-heavy] stopped: reached the $class max runtime ($max). Split the job, run a focused subset, or pass" \
               "--max-runtime if it genuinely needs longer." >&2
          exit 124
        fi
        exit $rc
      fi
      # The shared ceiling for every heavy run (a runtime property: nothing is written outside /run).
      systemctl --user set-property --runtime "$slice" MemoryMax="$total" MemorySwapMax=0 >/dev/null 2>&1 \
        || echo "[agent-heavy] WARN: could not set the all-heavy ceiling ($total) on $slice; per-run limits still apply" >&2
      systemd-run --user --scope --quiet --slice="$slice" -p CPUQuota="$cpu" -p MemoryMax="$mem" \
        -p MemorySwapMax="$swap" -p RuntimeMaxSec="$max_s" --unit="$unit" -- "$@" || rc=$?
      # Killed for memory? systemd counts the kernel's OOM kills in the scope (its own ceiling, or the all-heavy one).
      ooms=$(systemctl --user show -p OOMKills --value "$unit.scope" 2>/dev/null || true)
      if [[ ${ooms:-0} =~ ^[0-9]+$ && ${ooms:-0} -gt 0 ]]; then
        systemctl --user reset-failed "$unit.scope" 2>/dev/null || true
        log "killed for memory: $class ceiling $mem, all heavy runs $total" "${orig[@]}"
        echo "[agent-heavy] killed: the run went over its memory ceiling ($class: $mem, no swap; all heavy runs together:" \
             "$total) and the kernel stopped it inside its own scope; the host was not touched. $focused." \
             "If it genuinely needs more, set AGENT_HEAVY_${class^^}_MEM." >&2
        exit 137   # as a SIGKILL: never a success, whatever the job returned
      fi
      # Stopped at the limit? Ask systemd (Result=timeout) rather than trust the exit code: a job that traps SIGTERM
      # can exit 0. If systemd can't say, the elapsed time decides.
      if result=$(systemctl --user show -p Result --value "$unit.scope" 2>/dev/null); then
        [[ $result == timeout ]] && timed_out=1 || timed_out=0
      else
        [[ $(( $(date +%s) - start )) -ge $max_s ]] && timed_out=1 || timed_out=0
      fi
      if [[ $timed_out == 1 ]]; then
        systemctl --user reset-failed "$unit.scope" 2>/dev/null || true
        # findable later with `journalctl -t agent-heavy`, like a kernel OOM kill
        log "stopped at the $class max runtime" "${orig[@]}"
        echo "[agent-heavy] stopped: reached the $class max runtime ($max). Split the job, run a focused subset, or pass" \
             "--max-runtime if it genuinely needs longer." >&2
        exit 124   # as timeout(1): never a success, whatever the job returned when it was stopped
      fi
      systemctl --user reset-failed "$unit.scope" 2>/dev/null || true   # a failed scope otherwise stays listed
      exit $rc
    fi
    exec {fd}>&-
  done
  (( $(date +%s) >= deadline )) && { echo "[agent-heavy] no $class slot free within ${wait_s}s" >&2; exit 75; }
  sleep "${AGENT_HEAVY_POLL:-2}"
done
