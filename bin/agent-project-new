#!/usr/bin/env bash
# agent-project-new: set up a project for an OpenRig build team, the correct way, in one idempotent run.
#
#   agent-project-new --name <Project> --rig <short> [--github <user>] [--team full-stack|build|small|core]
#                     [--identity "Name <email>"] [--no-github] [--no-up] [--no-deps] [--dry-run]
#
# Creates or completes (never overwrites):
#   ~/Projects/<P>            the repo, with the starter kit added (existing files kept)
#   ~/Projects/<P>-heldout    held-out journeys, outside the repo
#   ~/Projects/<P>-work       the OpenRig workspace: project.yaml (+ agent-stack SDLC/wave/git defaults),
#                             workspace.yaml, SPEC.md, conventions.md, missions/, rig/ (spec, CULTURE, watchdogs)
#   ~/Projects/<P>.worktrees  one git worktree per seat (implementers on agent/<seat>, others detached)
# and wires it: umbrella catalog, files.allowlist, progress.scan_roots, .git/info/exclude, GitHub protection,
# rig up, the merge-sweep and daily-summary watchdogs (never duplicated). Finishes with agent-project-check.
# Missions, slices and wave maps are the lead's job once the plan is in (see the openrig-project-setup skill).
set -euo pipefail
AS=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
NAME= RIG= GH= TEAM=full-stack ID= GITHUB=1 UP=1 DEPS=1 DRY=0
while [ $# -gt 0 ]; do case "$1" in
  --name) NAME=$2; shift 2 ;; --rig) RIG=$2; shift 2 ;; --github) GH=$2; shift 2 ;; --team) TEAM=$2; shift 2 ;;
  --identity) ID=$2; shift 2 ;; --no-github) GITHUB=0; shift ;; --no-up) UP=0; shift ;; --no-deps) DEPS=0; shift ;;
  --dry-run) DRY=1; shift ;; -h|--help) sed -n 2,16p "$0"; exit 0 ;; *) echo "unknown option $1" >&2; exit 2 ;; esac; done
[ -n "$NAME" ] && [ -n "$RIG" ] || { sed -n 2,6p "$0"; exit 2; }
[ -f "$AS/rig/template/$TEAM.yaml" ] || { echo "no team spec rig/template/$TEAM.yaml" >&2; exit 2; }
P=$NAME; R=$HOME/Projects/$P; W=$HOME/Projects/$P-work; WT=$HOME/Projects/$P.worktrees; H=$HOME/Projects/$P-heldout
U=$HOME/Projects/openrig-workspace
# Seats by ROLE, from the team spec itself (the member whose agent_ref is agents/<role>), never assumed by name:
# the lead (agents/lead), the merge owner (agents/integrator; it gets the merge sweep and judges proof) and the QA seats
# (agents/qa, however they are named: qa-codex, qa-codex-1, ...). A session name is <pod id>-<member id>.
seats_for() {
  python3 - "$AS/rig/template/$TEAM.yaml" "$1" <<'PY'
import sys, yaml
spec, role = yaml.safe_load(open(sys.argv[1])), sys.argv[2]
for pod in spec.get("pods") or []:
    for m in pod.get("members") or []:
        if str(m.get("agent_ref", "")).rstrip("/").endswith(f"/agents/{role}"):
            print(f"{pod['id']}-{m['id']}")
PY
}
LEAD=$(seats_for lead | head -1); MERGE=$(seats_for integrator | head -1); QA=$(seats_for qa | sort)
[ -n "$LEAD" ] && [ -n "$MERGE" ] || { echo "rig/template/$TEAM.yaml needs a lead (agents/lead) and a merge owner (agents/integrator)" >&2; exit 2; }
[ "$(seats_for integrator | wc -l)" = 1 ] || echo "note: several merge owners in $TEAM.yaml; the merge sweep goes to $MERGE" >&2
JUDGES=$(printf '%s\n' $QA "$MERGE" "$LEAD" | sed "s/\$/@$RIG/" | paste -sd, - | sed 's/,/, /g')
# The repo's trunk: origin/HEAD, else the checked-out branch, else main. An EXISTING repo (commits and an origin) is
# adopted as it is: the starter kit goes to the workspace for the lead to bring in by PR, never into the working tree.
trunk_of() { local t; t=$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); t=${t#origin/}
  [ -n "$t" ] || t=$(git -C "$1" branch --show-current 2>/dev/null); echo "${t:-main}"; }
# OpenRig judges "merged" against a LOCAL ref named main (execution view). When the trunk isn't main, keep
# refs/heads/main as a mirror of origin/<trunk>: a ref only, never checked out, never pushed (the pre-push hook refuses).
# Only a main this created (agent-stack.mainMirror) is ever moved.
mirror_main() { local r=$1 t=$2
  [ "$t" != main ] || return 0
  git -C "$r" rev-parse -q --verify "refs/remotes/origin/$t" >/dev/null || { echo "  $r: no origin/$t; main mirror not set" >&2; return 1; }
  # never move main under a checkout: not in the shared checkout, nor in any linked worktree
  ! git -C "$r" worktree list --porcelain | grep -qx 'branch refs/heads/main' || { echo "  $r: main is checked out in a worktree; mirror not set" >&2; return 1; }
  if git -C "$r" rev-parse -q --verify refs/heads/main >/dev/null && [ "$(git -C "$r" config --bool agent-stack.mainMirror)" != true ]; then
    echo "  $r: a local main exists that agent-stack didn't create; not overwriting it (delete it, or set agent-stack.mainMirror=true)" >&2; return 1; fi
  git -C "$r" config agent-stack.mainMirror true; git -C "$r" config agent-stack.trunk "$t"
  git -C "$r" update-ref -m "agent-stack: main mirrors origin/$t" refs/heads/main "refs/remotes/origin/$t"; }
EXISTING=0; TRUNK=main
if [ -d "$R/.git" ] && git -C "$R" rev-parse -q --verify HEAD >/dev/null && git -C "$R" remote get-url origin >/dev/null 2>&1; then
  EXISTING=1; TRUNK=$(trunk_of "$R"); fi
say() { printf '\033[1m==\033[0m %s\n' "$*"; }
run() { if [ $DRY = 1 ]; then echo "  would: $*"; else "$@"; fi; }
if [ -z "$ID" ]; then   # the commit identity seats use; a fresh machine has none yet (git config fails under set -e)
  gname=$(git config --global user.name 2>/dev/null || true); gmail=$(git config --global user.email 2>/dev/null || true)
  [ -n "$gname" ] && [ -n "$gmail" ] || { echo "agent-project-new: no commit identity. Pass --identity \"Name <email>\", or set git config --global user.name and user.email" >&2; exit 2; }
  ID="$gname <$gmail>"
fi

if [ $EXISTING = 1 ]; then say "repo $R (existing, trunk $TRUNK: adopted as is; starter kit goes to $W/starter-kit)"
else say "repo $R (starter kit, existing files kept; trunk $TRUNK)"; fi
run mkdir -p "$R" "$H"
if [ $DRY = 0 ] && [ $EXISTING = 1 ]; then
  ex="$R/.git/info/exclude"; mkdir -p "$(dirname "$ex")"
  # Hooks go where git runs them. A project with its own hooks directory (core.hooksPath, e.g. husky) keeps it: nothing
  # is written there, and the missing guard is reported (agent-project-check FAILs it too).
  hooks=$(cd "$R" && realpath -m "$(git rev-parse --git-path hooks)")
  if [ "$hooks" != "$(cd "$R" && realpath -m "$(git rev-parse --git-common-dir)/hooks")" ]; then
    echo "  core.hooksPath is $hooks (the project's own hooks): add the agent-stack pre-commit and pre-push checks there by hand" >&2
  else
    for hk in pre-commit pre-push; do   # never replace a hook the project has of its own
      if [ ! -e "$hooks/$hk" ] || grep -q '^# agent-stack:' "$hooks/$hk"; then install -m 755 "$AS/system/git-hooks/$hk" "$hooks/$hk"
      else echo "  $hooks/$hk is the project's own; not replaced (add the agent-stack check to it by hand)" >&2; fi; done
  fi
  for e in /.codex/ /.claude/settings.local.json /.claude/skills/ /.claude/plugins/ /.openrig/ /.mcp.json /CLAUDE.local.md /.agents/skills/; do
    grep -qxF "$e" "$ex" 2>/dev/null || echo "$e" >> "$ex"; done
  git -C "$R" fetch -q origin "$TRUNK" || echo "  could not fetch origin $TRUNK" >&2
  mirror_main "$R" "$TRUNK" || true
elif [ $DRY = 1 ] && [ "$TRUNK" != main ]; then
  echo "  would: set refs/heads/main := origin/$TRUNK (a mirror for OpenRig; never checked out or pushed) + pre-push guard"
fi
if [ $DRY = 0 ] && [ $EXISTING = 0 ]; then
  cp -rn "$AS/starter-kit/." "$R/"; rm -f "$R/README.md.kit"
  [ -f "$R/README.md" ] && cmp -s "$R/README.md" "$AS/starter-kit/README.md" && rm "$R/README.md"
  for f in AGENTS.md docs/PLAN.md; do [ -f "$R/$f" ] && sed -i "s#@PROJECT@#$P#g; s#@HELDOUT@#$H#g; s#@COMMIT_IDENTITY@#$ID#g" "$R/$f"; done
  [ -d "$R/.git" ] || { git -C "$R" init -q -b main; git -C "$R" add -A; git -C "$R" commit -qm "chore: starter kit"; }
  ex="$R/.git/info/exclude"; mkdir -p "$(dirname "$ex")"
  install -m 755 "$AS/system/git-hooks/pre-commit" "$R/.git/hooks/pre-commit"   # never commit OpenRig seat blocks
  for e in /.codex/ /.claude/settings.local.json /.claude/skills/ /.claude/plugins/ /.openrig/ /.mcp.json /CLAUDE.local.md /.agents/skills/; do
    grep -qxF "$e" "$ex" 2>/dev/null || echo "$e" >> "$ex"; done
fi

if [ $GITHUB = 1 ] && [ -n "$GH" ]; then
  say "GitHub $GH/$P (private) + branch protection"
  if ! git -C "$R" remote get-url origin >/dev/null 2>&1; then
    # REST, not `gh repo create`: GraphQL hits the secondary rate limit while rigs are polling
    run gh api -X POST user/repos -f name="$P" -F private=true >/dev/null
    run git -C "$R" remote add origin "https://github.com/$GH/$P.git"
    run git -C "$R" push -q -u origin main
  fi
  if [ $EXISTING = 1 ]; then
    # An existing repo keeps its own GitHub rules: skip the kit's protection when the trunk already has any.
    # Fail closed. Ruleset rules that can be read and are present mean "already protected". Otherwise the kit adds
    # protection only after a readable, empty rule list AND a confirmed "not protected" (HTTP 404). Any other failure
    # (503, auth, rate limit) changes nothing.
    prot="" rules="" unreadable=""
    why() { local m; m=$(tail -n1 <<<"$1"); echo "${m:-failed with no message}"; }
    if rout=$(gh api "repos/$GH/$P/rules/branches/$TRUNK" --jq '[.[].type] | join(", ")' 2>&1); then rules=$rout
    else unreadable="rules: $(why "$rout")"; fi
    if [ -z "$rules" ]; then
      if pout=$(gh api "repos/$GH/$P/branches/$TRUNK/protection" --silent 2>&1); then prot="branch protection"
      elif ! grep -q 'HTTP 404' <<<"$pout"; then unreadable="${unreadable:+$unreadable; }branch protection: $(why "$pout")"; fi
    fi
    if [ -n "$prot$rules" ]; then say "GitHub: $TRUNK already protected (${prot}${prot:+${rules:+; }}${rules:+ruleset: $rules}); kit protection skipped"
    elif [ -n "$unreadable" ]; then say "GitHub: could not read $TRUNK's protection ($unreadable); nothing changed. Re-run later."
    else run "$AS/starter-kit/scripts/setup-github.sh" "$GH/$P" "$TRUNK"; fi
  else
    [ -x "$R/scripts/setup-github.sh" ] && run "$R/scripts/setup-github.sh" "$GH/$P" "$TRUNK"
  fi
fi

say "workspace $W"
if [ ! -f "$W/project.yaml" ]; then run rig config init-workspace --root "$W" >/dev/null; fi
if [ $DRY = 0 ]; then
  sed -i "s/  - id: default/  - id: $RIG/" "$W/workspace.yaml"
  grep -q '^sdlc:' "$W/project.yaml" || cat "$AS/rig/template/project-sdlc.yaml" >> "$W/project.yaml"
  grep -q '^metadata:' "$W/project.yaml" || sed -i "0,/^kind: project$/s//kind: project\nmetadata:\n  id: $RIG/" "$W/project.yaml"
  if ! grep -q '^proofPolicy:' "$W/project.yaml"; then   # readiness is "legacy" in the TUI without it
    printf '\n# Who may accept a slice'"'"'s Proof contract items (rig proof judge); readiness derives from their judgments.\nproofPolicy:\n  judges: [%s]\n' "$JUDGES" >> "$W/project.yaml"
  fi
  [ -f "$W/conventions.md" ] || printf '# %s conventions\n\nRepo rules: %s/AGENTS.md. Team rules: rig/CULTURE.md.\n' "$P" "$R" > "$W/conventions.md"
  grep -qE '^ *- conventions.md' "$W/project.yaml" || sed -i 's/^  context: \[\]/  context:\n    - conventions.md/' "$W/project.yaml"
  grep -qF "$W" "$U/workspace.yaml" 2>/dev/null || printf '  - id: %s\n    root: %s\n' "$RIG" "$W" >> "$U/workspace.yaml"
fi
if [ $EXISTING = 1 ]; then
  if [ $DRY = 1 ]; then echo "  would: copy the starter kit to $W/starter-kit (for the lead's adoption PR)"
  elif [ ! -d "$W/starter-kit" ]; then
    mkdir -p "$W/starter-kit" && cp -r "$AS/starter-kit/." "$W/starter-kit/"
    for f in AGENTS.md docs/PLAN.md; do [ -f "$W/starter-kit/$f" ] && sed -i "s#@PROJECT@#$P#g; s#@HELDOUT@#$H#g; s#@COMMIT_IDENTITY@#$ID#g" "$W/starter-kit/$f"; done
  fi
  echo "  The starter kit is in $W/starter-kit, NOT in the repo. Adopting it (AGENTS.md, guards, journeys; merge with the"
  echo "  project's own AGENTS.md, README, .gitignore, playwright.config.ts) is the lead's first slice, as a PR to $TRUNK."
fi
changed=0
for k in files.allowlist progress.scan_roots; do
  c=$(rig config get $k 2>/dev/null || true)
  case ",$c," in *",$RIG:$W,"*) ;; *) run rig config set $k "${c:+$c,}$RIG:$W" >/dev/null; changed=1 ;; esac
done
# The daemon reads these roots at start: restart only the daemon (verified stop/start; seats live in openrig-tmux's server).
[ $changed = 1 ] && run "$AS/bin/openrig-daemon-cycle" --reason "agent-project-new $NAME: new workspace roots"

say "rig folder $W/rig ($TEAM: lead $LEAD, merge owner $MERGE, proof judges [$JUDGES])"
run mkdir -p "$W/rig"
if [ $DRY = 0 ]; then
  for f in "$TEAM.yaml" CULTURE.md merge-sweep.watchdog.yaml daily-summary.watchdog.yaml; do
    [ -f "$W/rig/$f" ] || cp "$AS/rig/template/$f" "$W/rig/$f"; done
  mkdir -p "$W/rig/startup"
  [ -f "$W/rig/startup/context.md" ] || sed "s#@REPO@#$R#g; s#@WT@#$WT#g; s#@TRUNK@#$TRUNK#g" "$AS/rig/template/startup/context.md" > "$W/rig/startup/context.md"
  sed -i "s#@RIG@#$RIG#g; s#@REPO@#$R#g; s#@WT@#$WT#g; s#@AGENT_STACK@#$AS#g; s#@LEAD_SEAT@#$LEAD#g; s#@MERGE_SEAT@#$MERGE#g" \
    "$W/rig/$TEAM.yaml" "$W/rig/merge-sweep.watchdog.yaml" "$W/rig/daily-summary.watchdog.yaml"
  grep -q "^## $P specifics" "$W/rig/CULTURE.md" || printf '\n## %s specifics\n- Trunk: `%s`. Branch from origin/%s; every PR targets %s.\n- (status names, commit identity, repo procedures; owner decisions go in "Owner decisions" above)\n' "$P" "$TRUNK" "$TRUNK" "$TRUNK" >> "$W/rig/CULTURE.md"
fi

# Worktrees start from the trunk: local main for a main-trunk repo (as always), origin/<trunk> otherwise.
BASE=main; [ "$TRUNK" = main ] || BASE="origin/$TRUNK"
say "worktrees $WT (one per seat, from $BASE)"
run mkdir -p "$WT"
if [ $DRY = 1 ]; then
  for cwd in $(grep -oE 'cwd: *"?[^"]+' "$AS/rig/template/$TEAM.yaml" | sed 's/cwd: *"\{0,1\}//; s#@WT@#'"$WT"'#'); do
    seat=$(basename "$cwd"); case "$seat" in impl-*) run git -C "$R" worktree add -q --no-track "$cwd" -b "agent/$seat" "$BASE" ;; *) run git -C "$R" worktree add -q --detach "$cwd" "$BASE" ;; esac
    [ -f "$R/.env.local" ] && echo "  would: ln -s $R/.env.local $cwd/.env.local"
    if [ $DEPS = 1 ] && { [ -f "$R/bun.lock" ] || [ -f "$R/bun.lockb" ]; }; then echo "  would: (cd $cwd && bun install --frozen-lockfile)"
    elif [ $DEPS = 1 ] && [ -f "$R/package-lock.json" ]; then echo "  would: (cd $cwd && npm ci)"; fi
  done
else
  for cwd in $(grep -oE 'cwd: *"?[^"]+' "$W/rig/$TEAM.yaml" | sed 's/cwd: *"\{0,1\}//'); do
    seat=$(basename "$cwd")
    if [ ! -d "$cwd" ]; then
      case "$seat" in impl-*) git -C "$R" worktree add -q --no-track "$cwd" -b "agent/$seat" "$BASE" ;; *) git -C "$R" worktree add -q --detach "$cwd" "$BASE" ;; esac
      if [ $DEPS = 1 ]; then   # the project's own package manager, from its lockfile
        if [ -f "$cwd/bun.lock" ] || [ -f "$cwd/bun.lockb" ]; then
          if command -v bun >/dev/null; then (cd "$cwd" && bun install --frozen-lockfile >/dev/null 2>&1 || echo "  bun install failed in $seat (install later)")
          else echo "  $seat: bun.lock present but bun is not installed; install bun, then: bun install --frozen-lockfile"; fi
        elif [ -f "$cwd/package-lock.json" ]; then (cd "$cwd" && npm ci --silent >/dev/null 2>&1 || echo "  npm ci failed in $seat (install later)"); fi
      fi
    fi
    # The project's dev env (e.g. the dev-branch database URL): .env.local ONLY, as a link, so seats share the owner's
    # file. Never .env.*.local or .env.production*. An existing file in the worktree is left alone.
    if [ -f "$R/.env.local" ] && [ ! -e "$cwd/.env.local" ] && [ ! -L "$cwd/.env.local" ]; then ln -s "$R/.env.local" "$cwd/.env.local"; fi
  done
fi

# Claude seats: trust their worktrees now, so none stops on "trust this folder?" at first launch.
if [ $DRY = 1 ]; then echo "  would: agent-claude-trust --spec $W/rig/$TEAM.yaml (pre-trust every Claude seat worktree in ~/.claude.json)"
else "$AS/bin/agent-claude-trust" --spec "$W/rig/$TEAM.yaml" | tail -n 3; fi

if [ $UP = 1 ]; then
  say "launch rig $RIG"
  run rig spec validate "$W/rig/$TEAM.yaml"
  rig ps 2>/dev/null | grep -qE "^$RIG[[:space:]]" || run rig up "$W/rig/$TEAM.yaml"
  active=$(rig watchdog list --json 2>/dev/null || echo '[]')
  reg() { # reg <seat> <interval> <spec>: only when no such watchdog is active (duplicates waste turns)
    echo "$active" | jq -e --arg s "$1@$RIG" --argjson i "$2" 'any(.[]; .state=="active" and .targetSession==$s and .intervalSeconds==$i)' >/dev/null \
      || if [ $DRY = 1 ]; then echo "  would: rig watchdog register --spec $3 --target-session $1@$RIG --interval-seconds $2"
         else rig watchdog register --policy periodic-reminder --spec "$3" --target-session "$1@$RIG" --interval-seconds "$2" --registered-by "$USER" >/dev/null; fi; }
  reg "$MERGE" 900 "$W/rig/merge-sweep.watchdog.yaml"   # the merge owner from the team spec
  reg "$LEAD" 86400 "$W/rig/daily-summary.watchdog.yaml"
fi

say "check"
[ $DRY = 1 ] || "$AS/bin/agent-project-check" "$P" || true
cat <<EOF

Next: write $R/docs/PLAN.md, commit it, then  rig send $LEAD@$RIG "Build docs/PLAN.md"
The lead creates missions, slices (depends_on + Territory) and one wave map per mission after your plan approval;
every wave with user-facing slices ends with a W witness slice (copy $AS/rig/template/witness-slice/).
Re-run  agent-project-check $P  after that: every FAIL must be gone before builders are dispatched wide.
EOF
