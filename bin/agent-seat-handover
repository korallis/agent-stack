#!/usr/bin/env python3
"""agent-seat-handover <seat> [rig seat handover options]: run `rig seat handover`, then WAIT for the real outcome.

`rig seat handover` gives up after the CLI's fixed 5 s client timeout ("outcome UNKNOWN") while the daemon carries on
and usually completes. Retrying then would start a SECOND successor. This wrapper:
  1. runs `rig seat handover <seat> ... --json` (a --dry-run is passed straight through);
  2. a JSON answer is final: ok -> complete; ok:false -> failed, with the daemon's code and message;
  3. anything else (the timeout) -> polls `rig seat status <seat> --json` every 5 s until handover_result is
     "complete" with a handover_at at or after this run's start (the seat's new occupant is printed).
     Correlation is by time only: a second handover of the same seat started elsewhere after this run would also
     count (OpenRig records no request id).
     OpenRig only records successes there; a failure after the timeout is never recorded, so when --wait (default
     600 s) runs out the answer is UNKNOWN: do NOT hand over again; check `rig seat status` and the seat's tmux
     sessions first.
  4. parked rows keep their wakes (WO56): at a seat swap OpenRig stops every watchdog job the retiring generation
     registered, park timers included (`rig queue block --wake-after`); the successor is meant to re-arm its own
     and nothing does. So before the handover the seat's blocked rows and their timed wakes are recorded (the wake
     the daemon itself projects for each row, waiting.nextBackstop, so a custom message or an attached watchdog
     counts too), and after "complete" each row that is still blocked, still the seat's, and has no live wake any
     more is re-parked on the same blocker with the same interval; what was re-armed is printed. A row that still
     has a live wake is left alone (never two). A repeating wait (the wake ladder) can't be re-armed from the CLI:
     it is reported, to re-park by hand. A row that can't be read, before or after, is reported too, never skipped.
Exit: 0 complete (or a dry run), 1 failed, 3 unknown, 4 complete but a wake could not be re-armed or checked (listed).
`agent-seat-handover <seat> --wakes` only prints the parked-row timers a handover would stop, and changes nothing.
Before a --source rebuild handover, check the seat's chain: agent-seat-recap show --seat <seat>.
"""
import datetime, json, os, subprocess, sys, time

args = sys.argv[1:]
wait = 600.0
if "--wait" in args:
    i = args.index("--wait")
    wait = float(args[i + 1])
    del args[i:i + 2]
if not args or args[0].startswith("-"):
    sys.exit(__doc__.strip().split("\n\n")[0])
seat = args[0]
POLL = float(os.environ.get("AGENT_SEAT_HANDOVER_POLL", "5"))

if "--dry-run" in args:
    os.execvp("rig", ["rig", "seat", "handover", *args])


def rig_json(*a):
    """(parsed JSON, None) or (None, why)."""
    try:
        r = subprocess.run(["rig", *a], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, str(e)
    if r.returncode != 0:
        return None, f"exit {r.returncode}: {' '.join((r.stderr or r.stdout).split())[-200:]}"
    try:
        return json.loads(r.stdout), None
    except ValueError:
        return None, "output is not JSON"


def live_wake(row):
    """The row's armed, still-active watchdog job id, as the daemon projects it (waiting.nextBackstop); else None.
    This is the row's own wake record, so a custom message or an attached watchdog counts too."""
    mech = str(((row.get("waiting") or {}).get("nextBackstop") or {}).get("mechanism") or "")
    return mech[len("watchdog:"):] if mech.startswith("watchdog:") else None


def ladder(job):
    """A repeating wait (the wake ladder) keeps its state as JSON in the spec: the CLI can't arm one."""
    try:
        return bool(json.loads(job.get("specYaml") or "").get("context", {}).get("queue_wait", {}).get("qitemId"))
    except (ValueError, AttributeError):
        return False


def parked_wakes(targets):
    """The seat's blocked rows that have a live wake: ({qitem: {interval, ladder, job, blocked_on}}, [problems]);
    or (None, why) when the rows can't be listed at all."""
    rows, problems = {}, []
    for t in sorted(targets):
        listed, why = rig_json("queue", "list", "-A", "--destination", t, "--state", "blocked", "--json", "--limit", "1000")
        if not isinstance(listed, list):
            return None, why or "rig queue list did not return a list"
        for item in listed:
            q = item.get("qitemId") if isinstance(item, dict) else None
            if not q or q in rows:
                continue
            row, why = rig_json("queue", "show", q, "--full", "--json")
            if not isinstance(row, dict):
                problems.append(f"{q}: could not read the row ({why})"); continue
            job_id = live_wake(row)
            if row.get("state") != "blocked" or not job_id:
                continue   # no timed wake to lose (a blocker's resolution is its wake)
            job, why = rig_json("watchdog", "show", job_id, "--json")
            if not isinstance(job, dict):
                problems.append(f"{q}: could not read its wake {job_id} ({why})"); continue
            rows[q] = {"interval": job.get("intervalSeconds"), "ladder": ladder(job), "job": job_id, "blocked_on": row.get("blockedOn")}
    return rows, problems


st0, _ = rig_json("seat", "status", seat, "--json")
targets = {seat} | ({st0["current_occupant"]} if isinstance(st0, dict) and st0.get("current_occupant") else set())
wakes, snap = parked_wakes(targets)   # snap: why, when wakes is None; else the rows that couldn't be read
if "--wakes" in args:
    if wakes is None:
        sys.exit(f"could not read the seat's parked rows: {snap}")
    for p in snap:
        print(f"WARN: {p}", file=sys.stderr)
    for q, w in sorted(wakes.items()):
        print(f"{q}: {'repeating wait' if w['ladder'] else 'timer'} every {w['interval']}s (job {w['job']}), blocked on {w['blocked_on'] or '-'}")
    print(f"{len(wakes)} parked row(s) of {seat} with a timed wake; a handover stops the old occupant's, and this wrapper re-arms them")
    sys.exit(1 if snap else 0)
if wakes is None:
    print(f"WARN: could not record {seat}'s parked rows ({snap}); no wake will be re-armed after the handover", file=sys.stderr)
    snap = [f"the seat's parked rows could not be recorded ({snap})"]
else:
    for p in snap:
        print(f"WARN: {p}; its wake is not recorded and won't be re-armed", file=sys.stderr)


def rearm(occupant):
    """After a completed handover: re-park each recorded row that lost its wake. Returns how many need a hand."""
    failed = len(snap)   # rows that couldn't be recorded: the caller has to check them
    owners = targets | ({occupant} if occupant and occupant != "?" else set())
    for q, w in sorted((wakes or {}).items()):
        row, rwhy = rig_json("queue", "show", q, "--full", "--json")
        if not isinstance(row, dict):
            print(f"wake of {q}: NOT checked: could not read the row ({rwhy}); re-arm by hand if it's gone: "
                  f"rig queue update {q} --state blocked{' --blocked-on ' + w['blocked_on'] if w['blocked_on'] else ''} --wake-after {w['interval']}s",
                  file=sys.stderr); failed += 1; continue
        if row.get("state") != "blocked":
            print(f"wake of {q}: not needed, the row is {row.get('state')} now"); continue
        if row.get("destinationSession") not in owners:
            print(f"wake of {q}: left alone, the row belongs to {row.get('destinationSession')} now"); continue
        live = live_wake(row)
        if live:
            print(f"wake of {q}: still live (job {live}), left alone"); continue
        if w["ladder"]:
            print(f"wake of {q}: NOT re-armed: it was a repeating wait (every {w['interval']}s), which the CLI can't arm; re-park it by hand",
                  file=sys.stderr); failed += 1; continue
        cmd = ["rig", "queue", "update", q, "--state", "blocked", "--wake-after", f"{w['interval']}s",
               "--note", f"wake re-armed after the seat handover of {seat} (the retiring occupant's wake {w['job']} was stopped)"]
        if row.get("blockedOn"):
            cmd[6:6] = ["--blocked-on", row["blockedOn"]]   # after --state blocked
        try:
            u = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            ok, uwhy = u.returncode == 0, " ".join((u.stderr or u.stdout).split())[-200:]
        except (OSError, subprocess.TimeoutExpired) as e:
            ok, uwhy = False, str(e)
        if ok:
            print(f"wake of {q}: re-armed, every {w['interval']}s{', blocked on ' + row['blockedOn'] if row.get('blockedOn') else ''}")
        else:
            print(f"wake of {q}: NOT re-armed: {uwhy}", file=sys.stderr); failed += 1
    for p in snap:
        print(f"CHECK BY HAND: {p}", file=sys.stderr)
    return failed


def done(occupant):
    sys.exit(4 if rearm(occupant) else 0)

start = datetime.datetime.now(datetime.timezone.utc)   # full precision: the daemon records handover_at in ms
cmd = ["rig", "seat", "handover", *args] + ([] if "--json" in args else ["--json"])
r = subprocess.run(cmd, capture_output=True, text=True)
try:
    res = json.loads(r.stdout)
except ValueError:
    res = None
if isinstance(res, dict) and "ok" in res:
    if res["ok"]:
        occ = (res.get("currentStatus") or {}).get("currentOccupant") or res.get("currentOccupant") or "?"
        print(f"handover of {seat}: complete (occupant {occ})")
        done(occ)
    print(f"handover of {seat}: FAILED: {res.get('code', '?')}: {res.get('message', '')}", file=sys.stderr)
    sys.exit(1)

why = " ".join((r.stderr or r.stdout).split())[:200]
print(f"handover of {seat}: no answer from the CLI ({why or f'exit {r.returncode}'}); waiting up to {wait:.0f}s for the daemon's result",
      file=sys.stderr)


def when(s):
    """handover_at as UTC ('YYYY-MM-DD HH:MM:SS' from SQLite, or ISO with Z/offset)."""
    try:
        d = datetime.datetime.fromisoformat(str(s).replace("Z", "+00:00").replace(" ", "T"))
    except ValueError:
        return None
    return d if d.tzinfo else d.replace(tzinfo=datetime.timezone.utc)


deadline = time.monotonic() + wait
while True:
    s = subprocess.run(["rig", "seat", "status", seat, "--json"], capture_output=True, text=True)
    try:
        st = json.loads(s.stdout)
    except ValueError:
        st = {}
    at = when(st.get("handover_at")) if st.get("handover_at") else None
    if st.get("handover_result") == "complete" and at and at >= start:
        print(f"handover of {seat}: complete at {st['handover_at']} (occupant {st.get('current_occupant', '?')}, "
              f"previous {st.get('previous_occupant', '?')})")
        done(st.get("current_occupant"))
    if time.monotonic() >= deadline:
        print(f"handover of {seat}: UNKNOWN after {wait:.0f}s (no completed handover recorded since {start:%H:%M:%S.%f}Z). "
              f"Do NOT start another handover: check `rig seat status {seat}` and the seat's tmux sessions first.", file=sys.stderr)
        if wakes:
            print(f"Parked rows whose timers a completed handover stops (re-run `agent-seat-handover {seat} --wakes` after and re-arm what's gone): "
                  + ", ".join(f"{q} ({w['interval']}s)" for q, w in sorted(wakes.items())), file=sys.stderr)
        sys.exit(3)
    time.sleep(POLL)
