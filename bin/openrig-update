#!/usr/bin/env bash
# Tell the operator when a newer OpenRig is out. Never upgrades by itself: project rigs run around the clock, so an
# unattended upgrade would either never fire or interrupt live seats. Upgrading is an operator-run window: docs/UPGRADE.md.
#   openrig-update [--check]  report installed vs npm latest, and whether local patches exist for the target
#   openrig-update --notify   weekly timer: the same, plus a desktop note and a queue item for the upgrade owner
#                             (OPENRIG_UPGRADE_OWNER, default operator-agent@kernel), at most one per version per week
#   openrig-update --validate validate every rig/template spec against the installed OpenRig (an UPGRADE.md step)
set -uo pipefail
S=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd); source "$S/config/versions.env"
OWNER=${OPENRIG_UPGRADE_OWNER:-operator-agent@kernel}
note() { logger -t openrig-update "$2"; notify-send --app-name="Agent stack" ${3:+--urgency=$3} "$1" "$2" 2>/dev/null || true; echo "$2"; }

validate() {
  local tmp; tmp=$(mktemp -d); local ok=0
  for f in "$S"/rig/template/{core,team,build,full-stack,fallback-codex}.yaml; do
    sed -e "s#@RIG@#chk$(basename "$f" .yaml)#g; s#@REPO@#$tmp/repo#g; s#@WT@#$tmp/wt#g; s#@AGENT_STACK@#$S#g" "$f" > "$tmp/$(basename "$f")"
    rig spec validate "$tmp/$(basename "$f")" >/dev/null 2>&1 || { echo "spec failed: $(basename "$f")"; ok=1; }
  done
  rm -rf "$tmp"; [ $ok = 0 ] && echo "all rig/template specs validate against OpenRig $(rig --version 2>/dev/null | awk '{print $1}')"
  return $ok
}
[ "${1:-}" = "--validate" ] && { validate; exit; }

N=$(mise where "node@$NODE_FOR_OPENRIG")/bin
latest=$(PATH=$N:$PATH npm view @openrig/cli version 2>/dev/null) || { echo "npm unreachable"; exit 0; }
current=$(rig --version 2>/dev/null | awk '{print $1}')
[ -n "$latest" ] && [ "$latest" != "$current" ] || { echo "OpenRig $current is current"; exit 0; }

have=$(cd "$S/patches/openrig/$latest" 2>/dev/null && ls *.patch 2>/dev/null | sed 's/\.patch$//' | paste -sd, -)
carried=$(cd "$S/patches/openrig/$current" 2>/dev/null && ls *.patch 2>/dev/null | sed 's/\.patch$//' | paste -sd, -)
patches="${have:+yes ($have)}"; patches=${patches:-"no${carried:+ (installed $current carries $carried: port them or confirm upstream fixed them)}"}
summary="upgrade window due: OpenRig $current -> $latest, patches present? $patches"
echo "$summary"
[ "${1:-}" = "--notify" ] || exit 0

note "OpenRig $latest available" "$summary. Upgrade in a planned window: $S/docs/UPGRADE.md"
week=$(date +%G-W%V); err=$(mktemp); trap 'rm -f "$err"' EXIT
body=$(printf '%s\n\n- installed: %s; npm latest: %s\n- local patches for %s: %s\n- procedure: %s/docs/UPGRADE.md (census, snapshots, verified SQLite backup, rollback copy of the install prefix, controlled restart, plugin refresh plan, `rig ps --nodes -A`, canary)\n- release notes: https://github.com/mvschwarz/openrig/releases/tag/v%s\n\nRaised by the weekly openrig-update timer; it upgrades nothing by itself. Close this row with the outcome (upgraded / deferred and why).\n' \
  "$summary" "$current" "$latest" "$latest" "$patches" "$S" "$latest")
if rig queue create --id "qitem-openrig-upgrade-$latest-$week" --destination "$OWNER" --summary "$summary" \
     --tags "agent-stack,openrig-upgrade" --body "$body" >/dev/null 2>"$err"; then
  echo "queue item for $OWNER: qitem-openrig-upgrade-$latest-$week"
else
  note "OpenRig upgrade reminder not queued" "Could not create the queue item for $OWNER: $(head -c 200 "$err")" critical
fi
exit 0
