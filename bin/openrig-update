#!/usr/bin/env bash
# Keep OpenRig current with upstream without losing this setup's customisations.
# - Checks npm for a newer @openrig/cli. Upgrades only when no project rig is running (kernel is fine).
# - Upgrades via openrig-upgrade (which re-applies YOLO to presets and re-links shared agents).
# - Validates every team spec in rig/template; on any failure rolls back to the previous version.
# - On success bumps config/versions.env and commits it (pushes if the repo has a remote).
# Runs daily from openrig-update.timer; safe to run by hand. --check only reports.
set -uo pipefail
S=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd); source "$S/config/versions.env"
note() { logger -t openrig-update "$2"; notify-send --app-name="Agent stack" ${3:+--urgency=$3} "$1" "$2" 2>/dev/null || true; echo "$2"; }
N=$(mise where "node@$NODE_FOR_OPENRIG")/bin
latest=$(PATH=$N:$PATH npm view @openrig/cli version 2>/dev/null) || { echo "npm unreachable"; exit 0; }
current=$(rig --version 2>/dev/null | awk '{print $1}')
[ -n "$latest" ] && [ "$latest" != "$current" ] || { echo "OpenRig $current is current"; exit 0; }
[ "${1:-}" = "--check" ] && { echo "OpenRig $latest available (installed $current)"; exit 0; }

busy=$(rig ps --json 2>/dev/null | jq -r '[.[] | select(.name != "kernel" and .runningCount > 0) | .name] | join(", ")')
if [ -n "$busy" ]; then
  note "OpenRig $latest available" "Installed $current. Will upgrade automatically when no project rig is running (running: $busy)."
  exit 0
fi

validate() {
  local tmp; tmp=$(mktemp -d); local ok=0
  for f in "$S"/rig/template/{core,team,build,full-stack,fallback-codex}.yaml; do
    sed -e "s#@RIG@#chk$(basename "$f" .yaml)#g; s#@REPO@#$tmp/repo#g; s#@WT@#$tmp/wt#g; s#@AGENT_STACK@#$S#g" "$f" > "$tmp/$(basename "$f")"
    rig spec validate "$tmp/$(basename "$f")" >/dev/null 2>&1 || { echo "spec failed: $(basename "$f")"; ok=1; }
  done
  rm -rf "$tmp"; return $ok
}

"$S/bin/openrig-upgrade" "$latest" >/tmp/openrig-update.log 2>&1
if [ "$(rig --version 2>/dev/null | awk '{print $1}')" = "$latest" ] && validate && rig ps --json >/dev/null 2>&1; then
  sed -i "s/^OPENRIG_VERSION=.*/OPENRIG_VERSION=$latest/" "$S/config/versions.env"
  if git -C "$S" diff --quiet -- config/versions.env; then :; else
    git -C "$S" commit -q -m "chore: OpenRig $latest (validated upgrade from $current)" -- config/versions.env
    git -C "$S" remote | grep -q . && git -C "$S" push -q 2>/dev/null || true
  fi
  note "OpenRig upgraded to $latest" "Upgrade from $current validated: all team specs pass. Customisations re-applied."
else
  "$S/bin/openrig-upgrade" "$current" >>/tmp/openrig-update.log 2>&1
  note "OpenRig upgrade to $latest rolled back" "Validation failed; reinstalled $current. Log: /tmp/openrig-update.log" critical
  exit 1
fi
