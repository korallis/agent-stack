#!/usr/bin/env python3
"""Alert a project's recovery owner after 15 observed minutes of unhealthy HTTP checks."""
import argparse
from concurrent.futures import ThreadPoolExecutor
import datetime
import fcntl
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request


def timestamp(value):
    try:
        dt = datetime.datetime.fromisoformat(str(value).replace('Z', '+00:00'))
        if dt.tzinfo is None:
            raise ValueError('maintenance timestamp needs a timezone')
        return dt.timestamp()
    except (ValueError, TypeError):
        raise ValueError('invalid maintenance timestamp') from None


def validate(monitors):
    if not isinstance(monitors, list) or len(monitors) > 20:
        raise ValueError('config must contain at most 20 monitors')
    ids = set()
    for m in monitors:
        if not isinstance(m, dict) or not re.fullmatch(r'[A-Za-z0-9._-]{1,80}', m.get('id', '')) or m['id'] in ids:
            raise ValueError('monitor IDs must be unique simple names')
        ids.add(m['id'])
        url = urllib.parse.urlsplit(m.get('url', ''))
        if url.scheme not in ('http', 'https') or not url.hostname or url.username or url.password or url.query or url.fragment:
            raise ValueError('health URL must be HTTP(S), without credentials, query or fragment')
        if not re.fullmatch(r'[A-Za-z0-9._-]+@[A-Za-z0-9._-]+', m.get('destination', '')):
            raise ValueError('destination must be seat@rig')
        if 'bodyContains' in m and (not isinstance(m['bodyContains'], str) or not m['bodyContains'] or len(m['bodyContains']) > 4096):
            raise ValueError('bodyContains must be a short nonempty string')
        interval = m.get('interval_minutes', 1)
        if type(interval) is not int or not 1 <= interval <= 1440:
            raise ValueError('interval_minutes must be a whole number of minutes from 1 to 1440')
        if not isinstance(m.get('windows', []), list):
            raise ValueError('windows must be a list')
        for w in m.get('windows', []):
            if not isinstance(w, dict) or timestamp(w.get('start')) >= timestamp(w.get('end')):
                raise ValueError('maintenance window must have start before end')
    return monitors


def observe(state, healthy, maintenance, now, gap=600):
    if maintenance or healthy:
        state.clear()
        state['checkedAt'] = now
        return 'maintenance' if maintenance else 'healthy'
    if not 0 <= now - state.get('checkedAt', now) <= gap:
        state.clear()  # A missing observer does not prove a continuous outage.
    state['checkedAt'] = now
    state.setdefault('downSince', now)
    return 'alert' if now - state['downSince'] >= 900 and not state.get('alerted') else 'observe'


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None  # A redirect to login must not masquerade as a healthy endpoint.


def probe(m):
    try:
        req = urllib.request.Request(m['url'], headers={'User-Agent': 'agent-uptime-watch/1'})
        with urllib.request.build_opener(NoRedirect).open(req, timeout=10) as res:
            body = res.read(65536) if 'bodyContains' in m else b''
            healthy = 200 <= res.status < 300 and ('bodyContains' not in m or m['bodyContains'].encode() in body)
            return healthy, res.status
    except urllib.error.HTTPError as error:
        return False, error.code
    except (OSError, urllib.error.URLError, http.client.HTTPException, ValueError):
        return False, 'unreachable'


def timed_probe(m):
    # A monitor queued behind slower ones is probed later than the run started; its interval counts from its own probe.
    started = time.time()
    return probe(m) + (started,)


def save(path, state):
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as out:
        json.dump(state, out)
        temp = out.name
    os.replace(temp, path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', type=Path, default=Path.home() / '.config/agent-stack/uptime.json')
    parser.add_argument('--state', type=Path, default=Path(os.environ.get('AGENT_STACK_STATE',
                        Path.home() / '.local/state/agent-stack')) / 'uptime-watch.json')
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    if not args.config.exists():
        print('[]')  # No endpoint is guessed from project names or credentials.
        return 0
    monitors = validate(json.loads(args.config.read_text()))
    lock = None
    if not args.dry_run:
        args.state.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        lock = open(str(args.state) + '.lock', 'a')
        os.chmod(lock.name, 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
    state = json.loads(args.state.read_text()) if args.state.exists() else {}
    if not isinstance(state, dict):
        raise ValueError('invalid monitor state')
    now = time.time()
    maintenance = {m['id']: any(timestamp(w['start']) <= now < timestamp(w['end']) for w in m.get('windows', [])) for m in monitors}
    fingerprints, due = {}, {}
    for m in monitors:
        s = state.setdefault(m['id'], {})
        # Changing an endpoint, alert destination or interval starts a new observation window.
        fingerprints[m['id']] = hashlib.sha256(json.dumps(m, sort_keys=True).encode()).hexdigest()
        if s.get('config') and s['config'] != fingerprints[m['id']]:
            s.clear()
        # The timer runs every minute and the default probes every run; a slower monitor waits its interval (less a few
        # seconds of timer jitter).
        interval = m.get('interval_minutes', 1)
        due[m['id']] = maintenance[m['id']] or interval == 1 or now - s.get('probedAt', float('-inf')) >= interval * 60 - 5
    with ThreadPoolExecutor(max_workers=4) as pool:
        results = list(pool.map(lambda m: (False, 'maintenance') if maintenance[m['id']] else timed_probe(m) if due[m['id']] else None, monitors))
    report, failed = [], False
    for m, result in zip(monitors, results):
        s = state[m['id']]
        if result is None:
            report.append({'id': m['id'], 'status': 'not-due', 'action': 'skipped', 'dryRun': args.dry_run})
            continue
        healthy, status = result[:2]
        # Down-alert timing still counts from the first failure; gaps up to two intervals are one observed outage.
        action = observe(s, healthy, maintenance[m['id']], now, max(600, 2 * m.get('interval_minutes', 1) * 60))
        if not maintenance[m['id']]:
            s['probedAt'] = result[2]
        s['config'] = fingerprints[m['id']]
        row = {'id': m['id'], 'status': status, 'action': action, 'dryRun': args.dry_run}
        if action == 'alert' and not args.dry_run:
            key = hashlib.sha256(f'{m["id"]}:{s["downSince"]}'.encode()).hexdigest()[:24]
            body = (f'Health monitor {m["id"]} has failed checks for at least 15 minutes outside a declared '
                    f'maintenance window. Last result: {status}. Check the configured endpoint and take incident '
                    'custody. The watchdog has not restarted or deployed anything.')
            with tempfile.NamedTemporaryFile(mode='w', dir=args.state.parent) as out:
                out.write(body)
                out.flush()
                try:
                    res = subprocess.run(['rig', 'queue', 'create', '--destination', m['destination'], '--priority', 'urgent',
                                      '--summary', f'Health monitor down: {m["id"]}', '--body-file', out.name,
                                      '--id', f'uptime-watch-{key}', '--tags', 'uptime-watch', '--json'],
                                     text=True, capture_output=True, timeout=10)
                    delivered = res.returncode == 0
                except (OSError, subprocess.TimeoutExpired):
                    delivered = False
            row['delivered'] = delivered
            if row['delivered']:
                s['alerted'] = True
            else:
                failed = True
        report.append(row)
        if not args.dry_run:
            save(args.state, state)
    print(json.dumps(report))
    return 1 if failed else 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(f'agent-uptime-watch: {type(error).__name__}; check config and service journal', file=__import__('sys').stderr)
        raise SystemExit(1)
