#!/usr/bin/env python3
"""agent-project-onboard <answers.env> [--apply]: the mechanical steps of onboarding a project (skill: project-onboarding).

Dry run by default: prints every step and runs `agent-project-new --dry-run`; changes nothing. With --apply:
  1. clone REPO to ~/Projects/<NAME> (an existing checkout is adopted as it is);
  2. VERCEL_PROJECT set: link it and pull ONLY the Development env into <repo>/.env.local (skipped if the file
     exists; production and preview env stay with the owner, docs/PROJECT-ENV.md);
  3. agent-project-new (creates the workspace, worktrees, GitHub setup, starts the team);
  4. stage: PLAN -> <NAME>-work/docs/PLAN.md; DECISIONS -> CULTURE "Owner decisions"; SPECIFICS -> CULTURE
     "<NAME> specifics"; the issue workflow (WORKFLOW=issues) as an owner decision; the lead brief rendered from
     rig/template/onboarding/lead-brief.md -> <NAME>-work/docs/lead-brief.md. Nothing already there is overwritten:
     a different existing PLAN.md or lead brief gets a .new beside it; a bullet already in CULTURE is not added again;
  5. agent-refresh-guidance <NAME> --apply, so running seats get the staged CULTURE.
It never sends the lead brief: review it, then send it (the command is printed). Judgment stays in the skill.
The answers file: rig/template/onboarding/answers.example.env.
"""
import datetime, os, re, shlex, subprocess, sys

S = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
HOME = os.path.expanduser("~")
args = [a for a in sys.argv[1:] if not a.startswith("--")]
APPLY = "--apply" in sys.argv
if len(args) != 1 or not os.path.isfile(args[0]):
    sys.exit(__doc__.strip().splitlines()[0])
base = os.path.dirname(os.path.abspath(args[0]))

A = {}
for line in open(args[0]):
    line = re.sub(r"\s+#.*$", "", line.strip())
    if line and not line.startswith("#") and "=" in line:
        k, v = line.split("=", 1)
        A[k.strip()] = v.strip()
need = [k for k in ("NAME", "RIG", "TEAM", "IDENTITY") if not A.get(k)]
if need:
    sys.exit(f"agent-project-onboard: missing in {args[0]}: {', '.join(need)}")
if A["TEAM"] not in ("core", "small", "build", "full-stack"):
    sys.exit(f"agent-project-onboard: TEAM must be core, small, build or full-stack, not {A['TEAM']}")
if not re.fullmatch(r"[A-Za-z0-9._-]+", A["NAME"]) or not re.fullmatch(r"[a-z0-9-]+", A["RIG"]):
    sys.exit("agent-project-onboard: NAME must be a plain name and RIG lower-case letters, digits and dashes")
if A.get("WORKFLOW", "plan") not in ("plan", "issues"):
    sys.exit("agent-project-onboard: WORKFLOW must be plan or issues")
P, RIG = A["NAME"], A["RIG"]
R, W = f"{HOME}/Projects/{P}", f"{HOME}/Projects/{P}-work"
files = {k: os.path.join(base, A[k]) for k in ("PLAN", "DECISIONS", "SPECIFICS") if A.get(k)}
for k, f in files.items():
    if not os.path.isfile(f):
        sys.exit(f"agent-project-onboard: {k} file not found: {f}")
OPERATOR = os.environ.get("OPENRIG_SESSION_NAME") or "operator-agent@kernel"


def say(msg):
    print(f"{'' if APPLY else 'would: '}{msg}")


def run(cmd, **kw):
    print("  $ " + " ".join(shlex.quote(c) for c in cmd))
    r = subprocess.run(cmd, **kw)
    if r.returncode != 0:
        sys.exit(f"agent-project-onboard: step failed (exit {r.returncode}): {' '.join(cmd)}")
    return r


def put(path, text):
    """Write `text` to `path` unless a different file is already there (then `path`.new). Returns what was written."""
    if os.path.exists(path):
        if open(path).read() == text:
            return f"{path} (already there)"
        path += ".new"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    open(path, "w").write(text)
    return path


def add_bullets(culture, heading, bullets):
    """Append bullets at the end of the `## <heading>` section, skipping any already present. Returns the count added."""
    text = open(culture).read()
    m = re.search(rf"^## {re.escape(heading)}.*$", text, re.M)
    if not m:
        text += f"\n## {heading}\n"
        m = re.search(rf"^## {re.escape(heading)}.*$", text, re.M)
    nxt = re.search(r"^## ", text[m.end():], re.M)
    end = m.end() + (nxt.start() if nxt else len(text) - m.end())
    new = [b for b in bullets if b.strip() and b.strip() not in text]
    if new:
        section = text[:end].rstrip("\n") + "\n" + "\n".join(new) + "\n"
        text = section + ("\n" + text[end:] if text[end:] else "")
        open(culture, "w").write(text)
    return len(new)


def bullets_of(path):
    """A file's top-level '- ' bullets, each with its indented continuation lines."""
    out = []
    for line in open(path).read().splitlines():
        if line.startswith("- "):
            out.append(line)
        elif out and line.startswith("  ") and line.strip():
            out[-1] += "\n" + line
    return out


print(f"== onboard {P} (rig {RIG}, team {A['TEAM']}, workflow {A.get('WORKFLOW', 'plan')}){'' if APPLY else ' -- dry run'}")

# 1. repo
if A.get("REPO"):
    if os.path.isdir(f"{R}/.git"):
        print(f"repo {R} exists: adopted as it is")
    else:
        say(f"git clone {A['REPO']} {R}")
        if APPLY:
            run(["git", "clone", A["REPO"], R])
else:
    print(f"no REPO: agent-project-new creates a new private repo {A.get('GITHUB', '<GITHUB>')}/{P}")

# 2. development env only
if A.get("VERCEL_PROJECT"):
    if os.path.exists(f"{R}/.env.local"):
        print(f"{R}/.env.local exists: not pulled again")
    else:
        say(f"vercel link --project {A['VERCEL_PROJECT']} and vercel env pull .env.local --environment=development (Development only)")
        if APPLY:
            run(["vercel", "link", "--yes", "--project", A["VERCEL_PROJECT"], "--cwd", R], stdout=subprocess.DEVNULL)
            run(["vercel", "env", "pull", ".env.local", "--environment=development", "--yes", "--cwd", R], stdout=subprocess.DEVNULL)
    print("  then check the dev database password differs from production's (docs/PROJECT-ENV.md, 'Verify without printing values')")

# 3. agent-project-new: always its dry run first, then the real run with --apply
apn = [os.environ.get("AGENT_PROJECT_NEW", f"{S}/bin/agent-project-new"), "--name", P, "--rig", RIG, "--team", A["TEAM"],
       "--identity", A["IDENTITY"]] + (["--github", A["GITHUB"]] if A.get("GITHUB") else ["--no-github"])
run(apn + ["--dry-run"], stdout=None if not APPLY else subprocess.DEVNULL)
if APPLY:
    run(apn)

# 4. stage the owner's files
culture = f"{W}/rig/CULTURE.md"
decisions = bullets_of(files["DECISIONS"]) if "DECISIONS" in files else []
if A.get("WORKFLOW") == "issues" and "Issue workflow:" not in (open(culture).read() if os.path.isfile(culture) else ""):
    today = datetime.date.today().isoformat()
    decisions.append(f"- {today}: Issue workflow: research, plan, implement, verify. NEVER close an issue. When done, comment on it "
                     "(what was wrong, what changed with the PR link, where to see it, exact re-test steps), reassign it to "
                     "its creator and ask them to re-test.")
specifics = bullets_of(files["SPECIFICS"]) if "SPECIFICS" in files else []
workflow = ("4. Done per issue: merged through the gate, deployed, witnessed where the creator re-tests. Then comment on "
            "the issue (what was wrong, what changed with the PR link, where to see it, exact re-test steps), reassign "
            "it to its creator and ask them to re-test. Never close an issue."
            if A.get("WORKFLOW") == "issues" else
            "4. Done per feature: merged through the gate, deployed where the plan says, and witnessed.")
brief = (open(f"{S}/rig/template/onboarding/lead-brief.md").read()
         .replace("@PROJECT@", P).replace("@RIG@", RIG).replace("@WORK@", W).replace("@OPERATOR@", OPERATOR)
         .replace("@WORKFLOW@", workflow))
spec = next((f"{W}/rig/{f}" for f in (f"{A['TEAM']}.yaml",) if os.path.isfile(f"{W}/rig/{f}")), None)
lead = "coord-lead-claude"
if spec:
    t = open(spec).read()
    for pod in re.split(r"\n  - id: ", t)[1:]:
        pid = pod.split("\n", 1)[0].strip()
        for mem in re.split(r"\n      - id: ", pod)[1:]:
            if "agents/lead\"" in mem:
                lead = f"{pid}-{mem.split(chr(10), 1)[0].strip()}"
lead = f"{lead}@{RIG}"

say(f"write {W}/docs/PLAN.md from {A.get('PLAN', '(no PLAN given)')}")
say(f"add {len(decisions)} owner decision(s) and {len(specifics)} specifics line(s) to {culture}")
say(f"render the lead brief to {W}/docs/lead-brief.md (for {lead})")
if APPLY:
    if not os.path.isfile(culture):
        sys.exit(f"agent-project-onboard: {culture} is missing after agent-project-new")
    if "PLAN" in files:
        print("  " + put(f"{W}/docs/PLAN.md", open(files["PLAN"]).read()))
    print(f"  {add_bullets(culture, 'Owner decisions', decisions)} owner decision(s) added")
    print(f"  {add_bullets(culture, f'{P} specifics', specifics)} specifics line(s) added")
    print("  " + put(f"{W}/docs/lead-brief.md", brief))
    run([os.environ.get("AGENT_REFRESH_GUIDANCE", f"{S}/bin/agent-refresh-guidance"), P, "--apply"], stdout=subprocess.DEVNULL)

print(f"""
Next (project-onboarding skill, steps 6-9):
  review {W}/docs/lead-brief.md, then:  rig send {lead} "$(cat {W}/docs/lead-brief.md)"
  wait for plan-ready from the lead; review SPECs, waves, W slices and docs/VERIFY.md; agent-project-check {P}""")
