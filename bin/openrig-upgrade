#!/usr/bin/env bash
# Upgrade (or reinstall) OpenRig and re-apply the local adjustments an upgrade overwrites.
# usage: openrig-upgrade [--no-restart] [--allow-downgrade] [version]   (default: OPENRIG_VERSION, config/versions*.env)
#   --no-restart       install, patch and pin only; the running daemon is restarted separately after observing (docs/UPGRADE.md)
#   --allow-downgrade  permit installing a version OLDER than the one installed (refused otherwise, before npm runs:
#                      an older OpenRig against a database the newer one migrated is not a supported state)
# Stops with exit 1, before any restart, when the installed package is not the version asked for.
set -euo pipefail
# Never act for another HOME: an inherited OPENRIG_HOME outside $HOME (a seat's env under a test HOME) names a daemon and
# database this HOME doesn't own.
if [ -n "${OPENRIG_HOME:-}" ]; then case "$(realpath -m "$OPENRIG_HOME")/" in "$(realpath -m "$HOME")/"*) ;; *)
  echo "$(basename "$0"): OPENRIG_HOME=$OPENRIG_HOME is not under HOME=$HOME; refusing. Nothing changed." >&2; exit 2 ;; esac; fi
S=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
source "$S/config/versions.defaults.env"; [ -f "$S/config/versions.env" ] && source "$S/config/versions.env"   # tracked defaults, local override
restart=1 downgrade=0
while [ $# -gt 0 ]; do case $1 in --no-restart) restart=0; shift ;; --allow-downgrade) downgrade=1; shift ;; *) break ;; esac; done
V=${1:-$OPENRIG_VERSION}; N22=$(mise where node@$NODE_FOR_OPENRIG); P=$HOME/.local/share/agent-stack/openrig
# Resolve the target to an exact version BEFORE anything is installed: a leading "v" is dropped, and a dist-tag
# ("latest", "next") is asked of the registry. The guard and the install then use that exact version.
[ -x "$S/bin/semver-cmp" ] || { echo "openrig-upgrade: needs $S/bin/semver-cmp; nothing changed" >&2; exit 1; }
V=${V#v}
if ! "$S/bin/semver-cmp" "$V" 0.0.0 >/dev/null 2>&1; then
  tag=$V; V=$(PATH=$N22/bin:$PATH npm view "@openrig/cli@$tag" version 2>/dev/null | tail -n1 || true)
  "$S/bin/semver-cmp" "$V" 0.0.0 >/dev/null 2>&1 || { echo "openrig-upgrade: could not resolve '$tag' to a version (npm view); nothing changed" >&2; exit 1; }
  echo "openrig-upgrade: $tag = $V"
fi
have=$(jq -r '.version // empty' "$P/lib/node_modules/@openrig/cli/package.json" 2>/dev/null || true)
if [ -n "$have" ] && [ "$("$S/bin/semver-cmp" "$V" "$have" 2>/dev/null)" = -1 ] && [ $downgrade = 0 ]; then
  echo "openrig-upgrade: $V is OLDER than the installed $have; refusing to downgrade (nothing changed). If you really mean it: openrig-upgrade --allow-downgrade $V" >&2
  exit 1
fi
PATH=$N22/bin:$PATH npm install -g --prefix "$P" --allow-scripts=@openrig/cli,better-sqlite3 "@openrig/cli@$V"
# Local fixes upstream has not released yet (patches/openrig/<version>/); warns but never fails the upgrade.
"$S/bin/openrig-apply-patches" "$P/lib/node_modules/@openrig/cli"
got=$(jq -r '.version // empty' "$P/lib/node_modules/@openrig/cli/package.json" 2>/dev/null || true)
if [ -z "$got" ]; then
  echo "openrig-upgrade: no readable @openrig/cli version in $P after install; stopping before any restart" >&2
  exit 1
fi
if [ "$got" != "$V" ]; then
  echo "openrig-upgrade: asked for $V but $got is installed; stopping before any restart (the daemon still runs the old code)" >&2
  exit 1
fi
# Record what is installed, so install.sh (which reinstalls OPENRIG_VERSION when they differ) can't downgrade it later.
if grep -q '^OPENRIG_VERSION=' "$S/config/versions.env" 2>/dev/null; then sed -i "s/^OPENRIG_VERSION=.*/OPENRIG_VERSION=$got/" "$S/config/versions.env"
else echo "OPENRIG_VERSION=$got" >> "$S/config/versions.env"; fi
# OpenRig has no global permission default: re-record YOLO into every built-in rig preset (upgrades replace them).
for f in "$P"/lib/node_modules/@openrig/cli/daemon/specs/rigs/*/*/rig*.yaml; do
  grep -q '^permission_policy: builtin:yolo' "$f" || rig policy apply yolo --spec "$f"
done
ln -sfn "$P/lib/node_modules/@openrig/cli/daemon/specs/agents/shared" "$S/rig/template/openrig-shared"
if [ $restart = 0 ]; then
  echo "OpenRig $got installed and patched; daemon NOT restarted. Observe, then: openrig-daemon-cycle --reason 'upgrade to $got'"
  exit 0
fi
# Restart only the daemon (verified stop, then start in its own scope); never stop/restart openrig.service while rigs run.
"$S/bin/openrig-daemon-cycle" --reason "openrig-upgrade $got" || { echo "openrig-upgrade: installed $got, but the daemon restart did not complete; see above and docs/UPGRADE.md" >&2; exit 1; }
echo "OpenRig $(rig --version) installed. Running seats keep their launch settings until they are relaunched one at a time; an upgrade never tears seats down (docs/UPGRADE.md)."
echo "Re-check known issues after upgrading: codex submit keymap (#28), --no-daemon shim (#69), resume probe matcher."
