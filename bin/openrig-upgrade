#!/usr/bin/env bash
# Upgrade (or reinstall) OpenRig and re-apply the local adjustments an upgrade overwrites.
# usage: openrig-upgrade [version]   (default: current pinned 0.5.17)
set -euo pipefail
V=${1:-0.5.17}; N22=$(mise where node@22); P=$HOME/.local/share/agent-stack/openrig
PATH=$N22/bin:$PATH npm install -g --prefix "$P" --allow-scripts=@openrig/cli,better-sqlite3 "@openrig/cli@$V"
# OpenRig has no global permission default: re-record YOLO into every built-in rig preset (upgrades replace them).
for f in "$P"/lib/node_modules/@openrig/cli/daemon/specs/rigs/*/*/rig*.yaml; do
  grep -q '^permission_policy: builtin:yolo' "$f" || rig policy apply yolo --spec "$f"
done
ln -sfn "$P/lib/node_modules/@openrig/cli/daemon/specs/agents/shared" "$HOME/Projects/agent-stack/rig/template/openrig-shared"
systemctl --user restart openrig.service
echo "OpenRig $(rig --version) installed. Existing kernel seats keep their old policy until: rig down kernel --delete && systemctl --user restart openrig.service"
echo "Re-check known issues after upgrading: codex submit keymap (#28), --no-daemon shim (#69), resume probe matcher."
