#!/usr/bin/env python3
"""agent-playwright-mcp <npx args...>: start the Playwright MCP with ONE output dir per seat (WO83).

Both runtimes register this as their Playwright MCP command (Codex: system/codex/config.toml; Claude Code: install.sh's
`claude mcp add`), with the pinned `npx -y @playwright/mcp@<pin> ...` arguments after it. It adds
`--output-dir ~/.local/state/agent-stack/playwright-mcp/<seat>/` (any --output-dir it is given is replaced), made 0700
with its net/ subdir, and execs npx. Snapshots, screenshots, PDFs and console/network logs of one seat therefore never
mix with another seat's or another project's, and the retention timer (agent-playwright-retention) can age them by
the seat's rig.

The seat is OPENRIG_SESSION_NAME. A runtime may start MCP servers with a trimmed environment (Codex passes only a few
variables), so when it is absent here it is read from the nearest ancestor process that has it (/proc/<pid>/environ:
the seat's own codex or claude). No seat (the operator's own shell, a human): "local". The name is reduced to
[A-Za-z0-9._@-] with no leading dot, as the credential guard does for the net/ dir it allows (system/credguard-read-hook
netDir).

It also enables the MCP's devtools capability (--caps; any caps given are kept): with it @playwright/mcp 0.0.80 offers
browser_start_video / browser_stop_video, which a witness records its walk with.
"""
import os, re, sys

PROC = os.environ.get("AGENT_PLAYWRIGHT_MCP_PROC", "/proc")   # tests only


def stat(pid):
    """(ppid, start time in clock ticks since boot) from /proc/<pid>/stat."""
    f = open(f"{PROC}/{pid}/stat").read().rsplit(")", 1)[1].split()
    return int(f[1]), int(f[19])


def from_ancestors(pid):
    """The nearest ancestor's OPENRIG_SESSION_NAME. Identity check (QA PR87): an ancestor started no later than its
    child, so a pid that was reused after the real ancestor exited (a newer process) ends the walk: no seat, "local",
    rather than another process's seat."""
    seen, child_start = set(), None
    try:
        child_start = stat(os.getpid())[1]
    except (OSError, ValueError, IndexError):
        return None
    while pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            ppid, start = stat(pid)
            if start > child_start:
                return None
            env = open(f"{PROC}/{pid}/environ", "rb").read().split(b"\0")
            if stat(pid)[1] != start:   # replaced while we read it
                return None
            for kv in env:
                if kv.startswith(b"OPENRIG_SESSION_NAME="):
                    v = kv.split(b"=", 1)[1].decode("utf-8", "replace")
                    if v:
                        return v
            pid, child_start = ppid, start
        except (OSError, ValueError, IndexError):
            return None
    return None


def seat():
    s = os.environ.get("OPENRIG_SESSION_NAME") or from_ancestors(os.getppid()) or "local"
    # a leading dot becomes "_" too, so "." and ".." can't name the parent dirs (QA PR87); same as the guard's netDir
    return re.sub(r"^\.", "_", re.sub(r"[^A-Za-z0-9._@-]", "_", s))


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    base = os.path.join(os.path.expanduser("~"), ".local/state/agent-stack/playwright-mcp")
    out = os.path.join(base, seat())
    os.makedirs(os.path.join(out, "net"), mode=0o700, exist_ok=True)
    for d in (base, out, os.path.join(out, "net")):
        try:
            os.chmod(d, 0o700)
        except OSError:
            pass
    args, caps, i = [], [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("--output-dir", "--caps"):
            if a == "--caps" and i + 1 < len(argv):
                caps += argv[i + 1].split(",")
            i += 2
            continue
        if a.startswith("--output-dir="):
            i += 1
            continue
        if a.startswith("--caps="):
            caps += a.split("=", 1)[1].split(",")
            i += 1
            continue
        args.append(a)
        i += 1
    caps = list(dict.fromkeys(c for c in [*caps, "devtools"] if c))   # given ones first, devtools once
    cmd = ["npx", *args, "--caps", ",".join(caps), "--output-dir", out]
    if os.environ.get("AGENT_PLAYWRIGHT_MCP_DRY"):   # tests: print what would run
        print(" ".join(cmd))
        return 0
    os.execvp("npx", cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
