#!/usr/bin/env python3
"""agent-queue-backfill <Project> [--apply]

Adds OpenRig execution-data tags to a project's EXISTING queue rows (new rows get them from seat-tools/rig):
  - project:<id> on every row of the project's rig;
  - slice:<dir> + mission:<m> when a row names exactly one slice (by slice dir, or by the id in the dir name,
    e.g. F-001 -> 01-f-001-..., T023 -> 02-t023);
  - on open rows (pending / in-progress / blocked) the body line `worktree_path=<destination worktree>`;
  - with --candidates: `candidate:<PR head sha>` on the newest row of each slice that has none, from the
    implementation PR its rows name (pr:<n> tags or "PR #n"), so OpenRig's built/folded ladder can derive.
Additive only: no tag is removed, no body text is changed except that appended line. OpenRig's CLI can't
edit tags, so this writes the daemon's SQLite directly after a `.backup` into
~/.local/share/agent-stack/backups/. Dry run unless --apply.
"""
import datetime, glob, json, os, re, sqlite3, subprocess, sys

H = os.path.expanduser("~")
arg = next((a for a in sys.argv[1:] if not a.startswith("--")), None)
if not arg:
    sys.exit(__doc__)
APPLY = "--apply" in sys.argv
W = os.path.join(H, "Projects", f"{arg}-work")
WT = os.path.join(H, "Projects", f"{arg}.worktrees")
pid = (re.search(r"^\s*-\s*id:\s*([\w.-]+)", open(f"{W}/workspace.yaml").read(), re.M) or [0, None])[1]
specs = sorted(glob.glob(f"{W}/rig/*.yaml"), key=lambda f: open(f).read().count("cwd:"), reverse=True)
rig = re.search(r'^name:\s*"?([\w.-]+)', open(specs[0]).read(), re.M).group(1)

idx, slice_mission = {}, {}
for d in glob.glob(f"{W}/missions/*/slices/*/"):
    m, s = d.rstrip("/").split("/")[-3], d.rstrip("/").split("/")[-1]
    slice_mission[s] = m
    k = re.match(r"\d+-([a-z]+-?\d{2,3})", s)
    if k:
        idx[k.group(1).replace("-", "")] = s

DB = f"{H}/.openrig/openrig.sqlite"
if APPLY:
    b = f"{H}/.local/share/agent-stack/backups/openrig-sqlite-{datetime.datetime.now():%Y%m%d-%H%M%S}.sqlite"
    os.makedirs(os.path.dirname(b), exist_ok=True)
    subprocess.run(["sqlite3", DB, f".backup '{b}'"], check=True)
    print("backup:", b)
db = sqlite3.connect(DB, timeout=30)
db.execute("PRAGMA busy_timeout=30000")
rows = db.execute("select qitem_id, tags, body, state, destination_session from queue_items "
                  "where destination_session like ? or source_session like ?", (f"%@{rig}", f"%@{rig}")).fetchall()
st = dict(rig=rig, project=pid, rows=len(rows), add_project=0, add_slice=0, add_worktree=0)
updates = {}  # qitem_id -> [tags, body]; written in ONE short transaction at the end (the daemon shares this DB:
              # a write lock held across slow work, e.g. GitHub calls, makes the daemon crash with SQLITE_BUSY)
for qid, tags, body, state, dest in rows:
    tl = json.loads(tags) if tags else []
    new = list(tl)
    if pid and not any(t.startswith("project:") for t in new):
        new.append(f"project:{pid}"); st["add_project"] += 1
    if not any(t.startswith("slice:") for t in new):
        named = {s for s in slice_mission if s in body}
        if not named:
            ids = {re.sub(r"[^a-z0-9]", "", x.lower()) for x in re.findall(r"\b[A-Z]{1,2}-?\d{2,3}\b", body)}
            named = {idx[k] for k in ids if k in idx}
        if len(named) == 1:
            s = named.pop(); new.append(f"slice:{s}"); st["add_slice"] += 1
            if not any(t.startswith("mission:") for t in new):
                new.append(f"mission:{slice_mission[s]}")
    nb = body
    if state in ("pending", "in-progress", "blocked") and "worktree_path=" not in body:
        wt = f"{WT}/{dest.split('@')[0]}"
        if os.path.isdir(wt):
            nb = body.rstrip("\n") + f"\n\nworktree_path={wt}\n"; st["add_worktree"] += 1
    if new != tl or nb != body:
        updates[qid] = [new, nb]
if "--candidates" in sys.argv:
    remote = subprocess.run(["git", "-C", f"{H}/Projects/{arg}", "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    repo = re.sub(r"(\.git)?$", "", re.sub(r"^.*github\.com[:/]", "", remote)) if remote else None
    by_slice = {}
    for qid, tags, body, state, dest in db.execute("select qitem_id, tags, body, state, destination_session from queue_items "
                                                   "where destination_session like ? or source_session like ? order by ts_created",
                                                   (f"%@{rig}", f"%@{rig}")).fetchall():
        tl = json.loads(tags) if tags else []
        sl = next((t[6:] for t in tl if t.startswith("slice:")), None)
        if sl:
            by_slice.setdefault(sl, []).append((qid, tl, body or ""))
    pr_cache, st["add_candidate"] = {}, 0
    def pr(n):
        if n not in pr_cache:
            r = subprocess.run(["gh", "api", f"repos/{repo}/pulls/{n}", "--jq", "[.head.sha,.head.ref]|@tsv"], capture_output=True, text=True)
            pr_cache[n] = r.stdout.strip().split("\t") if r.returncode == 0 and r.stdout.strip() else None
        return pr_cache[n]
    for sl, rws in by_slice.items():
        if any(t.startswith("candidate:") for _, tl, _ in rws for t in tl) or not repo:
            continue
        nums = []
        for _, tl, body in rws:
            nums += [int(t[3:]) for t in tl if re.fullmatch(r"pr:\d+", t)] + [int(x) for x in re.findall(r"\bPR #(\d+)", body)]
        best = None
        for n in sorted(set(nums), reverse=True):
            info = pr(n)
            if info and len(info) == 2 and not info[1].startswith("tests/"):
                best = info[0]; break
        if best:
            qid, tl, body = rws[-1]
            st["add_candidate"] += 1
            cur = updates.get(qid, [tl, body])
            updates[qid] = [cur[0] + [f"candidate:{best}"], cur[1]]
if APPLY and updates:
    db.close()
    db = sqlite3.connect(DB, timeout=30)
    db.execute("PRAGMA busy_timeout=30000")
    with db:  # one short write transaction
        for qid, (tl, body) in updates.items():
            db.execute("update queue_items set tags=?, body=? where qitem_id=?", (json.dumps(tl), body, qid))
print(("APPLIED " if APPLY else "DRY RUN ") + json.dumps(st))
