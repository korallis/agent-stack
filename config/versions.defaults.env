# Known-good versions for this setup, TRACKED in git so a fresh clone never starts from a stale pin.
# install.sh, openrig-upgrade and openrig-update read this first, then config/versions.env (local, untracked) on top:
# that file only overrides, and openrig-upgrade records the installed OpenRig version there after a validated upgrade.
# OpenRig is never downgraded by a lower pin (install.sh keeps a newer install; openrig-upgrade needs --allow-downgrade).
OPENRIG_VERSION=0.6.3
CLIPROXY_VERSION=8.0.10
NODE_FOR_OPENRIG=22
NODE_FOR_JEV=24
NODE_GLOBAL=26.8.2
