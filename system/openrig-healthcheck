#!/usr/bin/env bash
# Restart the OpenRig daemon if /healthz keeps failing. Seats are never touched: they live in openrig-tmux.service's tmux
# server, and the daemon is cycled with openrig-daemon-cycle (rig daemon stop, verified gone, rig daemon start in its own
# scope), never by stopping or restarting openrig.service.
# Load-tolerant (hot-tune 2026-09-29 after a restart loop): a busy daemon answers slowly, and a fresh one is flooded by
# every seat reconnecting, so a short timeout turned load into repeated restarts. 3 misses at 15s each, and no second
# cycle within COOLDOWN seconds of the last one (alert instead).
export PATH=$HOME/.local/bin:$HOME/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
COOLDOWN=600
stamp=${OPENRIG_HOME:-$HOME/.openrig}/state/healthcheck-last-cycle
for i in 1 2 3; do curl -fsS -m 15 -o /dev/null http://127.0.0.1:7433/healthz && exit 0; [ $i -lt 3 ] && sleep 10; done
last=$(cat "$stamp" 2>/dev/null || echo 0); now=$(date +%s)
if [ $((now - last)) -lt $COOLDOWN ]; then
  logger -t openrig-healthcheck "healthz failed 3x but the daemon was cycled $((now - last))s ago; not cycling again (cooldown ${COOLDOWN}s)"
  notify-send --app-name="Agent stack" --urgency=critical "OpenRig daemon unresponsive" "Cycled $((now - last))s ago and still failing; not restarting again inside the cooldown. Check load (rig status)." 2>/dev/null || true
  exit 1
fi
mkdir -p "$(dirname "$stamp")"; echo "$now" > "$stamp"
logger -t openrig-healthcheck "healthz failed 3x; cycling the daemon with openrig-daemon-cycle"
out=$(openrig-daemon-cycle --reason "health check: healthz failed 3x" 2>&1) && exit 0
logger -t openrig-healthcheck "daemon cycle failed: $(tail -n1 <<<"$out")"
notify-send --app-name="Agent stack" --urgency=critical "OpenRig daemon down and not restarted" "$(tail -n1 <<<"$out") (seats keep running; see docs/UPGRADE.md)" 2>/dev/null || true
exit 1
