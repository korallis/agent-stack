#!/usr/bin/env python3
"""codex-retries [--check] [config.toml]: keep Codex's retries to the local proxy at 12 or more.

Seats gave up on seconds-long 429 bursts with Codex's request_max_retries = 4 / stream_max_retries = 5 (2026-10-02), so
both keys under [model_providers.cliproxyapi] are kept at a floor of 12: a missing or lower value becomes 12, a higher
one is kept, never lowered. The pool-*.config.toml role profiles are layered on top of this file (`codex -p`) and set no
provider, so they inherit it. Only those two lines change (a missing key is added at the end of that table); the rest of
the file is byte-for-byte unchanged, a timestamped backup is written first, and the result is parsed back before it
replaces the file. --check only reports. Exit 0 = already right or fixed; 1 = needs fixing (--check) or failed.
"""
import os, re, shutil, sys, time, tomllib

FLOOR = 12
KEYS = ("request_max_retries", "stream_max_retries")
TABLE = "model_providers.cliproxyapi"
check = "--check" in sys.argv
path = next((a for a in sys.argv[1:] if not a.startswith("--")), os.path.expanduser("~/.codex/config.toml"))


def done(ok, msg):
    print(f"{path}: {msg}")
    sys.exit(0 if ok else 1)


try:
    text = open(path).read()
    current = tomllib.loads(text)
except (OSError, tomllib.TOMLDecodeError) as e:
    done(False, f"cannot read ({e}); set {' and '.join(f'{k} = {FLOOR}' for k in KEYS)} under [{TABLE}] by hand")
provider = current.get("model_providers", {}).get("cliproxyapi")
if provider is None:
    done(True, f"no [{TABLE}] table (not using the local proxy); nothing to do")
low = {k: provider.get(k) for k in KEYS if not isinstance(provider.get(k), int) or provider.get(k) < FLOOR}
if not low:
    done(True, ", ".join(f"{k} = {provider[k]}" for k in KEYS) + f" (at least {FLOOR})")
if check:
    done(False, "needs " + ", ".join(f"{k} >= {FLOOR} (now {v if v is not None else 'unset'})" for k, v in low.items()))

lines = text.splitlines(keepends=True)
start = next((i for i, l in enumerate(lines) if re.match(rf"\s*\[\s*{re.escape(TABLE)}\s*\]\s*(#.*)?$", l)), None)
if start is None:
    done(False, f"[{TABLE}] is not a plain table header in the file; set the keys by hand")
end = next((i for i in range(start + 1, len(lines)) if re.match(r"\s*\[", lines[i])), len(lines))
for key in low:
    at = next((i for i in range(start + 1, end) if re.match(rf"\s*{key}\s*=", lines[i])), None)
    if at is not None:
        lines[at] = f"{key} = {FLOOR}\n"
    else:
        last = end
        while last > start + 1 and not lines[last - 1].strip():
            last -= 1  # after the table's last key, before its trailing blank lines
        if not lines[last - 1].endswith("\n"):
            lines[last - 1] += "\n"
        lines.insert(last, f"{key} = {FLOOR}\n")
        end += 1
new = "".join(lines)
try:
    parsed = tomllib.loads(new)
except tomllib.TOMLDecodeError as e:
    done(False, f"in-place edit would not parse ({e}); file left unchanged")
want = {**current["model_providers"]["cliproxyapi"], **{k: FLOOR for k in low}}
rest = lambda d: {k: v for k, v in d.items() if k != "model_providers"}
if parsed["model_providers"]["cliproxyapi"] != want or rest(parsed) != rest(current) or \
        {k: v for k, v in parsed["model_providers"].items() if k != "cliproxyapi"} != {k: v for k, v in current["model_providers"].items() if k != "cliproxyapi"}:
    done(False, "in-place edit did not produce the expected config; file left unchanged")
backup = f"{path}.bak-{time.strftime('%Y%m%d%H%M%S')}"
shutil.copy2(path, backup)
tmp = path + ".tmp"
with open(tmp, "w") as f:
    f.write(new)
os.chmod(tmp, os.stat(path).st_mode & 0o777)
os.replace(tmp, path)
done(True, f"set {', '.join(f'{k} = {FLOOR}' for k in low)} (backup {os.path.basename(backup)})")
