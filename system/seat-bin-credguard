#!/usr/bin/env python3
"""OpenRig seats only: installed as seat-bin/{neon,neonctl,vercel,vc}, and called by env.sh's seat functions of the same
names (mise-activated shells put the real CLIs ahead of seat-bin on PATH; a shell function wins either way).

A seat's command output IS its transcript. On 2026-09-30 `neon connection-string --no-secrets` (neon 6.3.0 has no such
flag on that command and silently ignored it) printed a production owner connection string into a seat transcript. So:

1. Commands that print credentials run only when their output cannot reach the transcript:
   - `--output-file <path>` is given: the guard creates <path> with mode 0600 (never through a symlink), sends the
     command's stdout there and strips the flag; or
   - stdout is /dev/null.
   Anything else is refused with a one-line explanation, exit 2: a terminal, a pipe, `$(…)`, and also a plain
   `> file`. Claude Code's Bash tool itself captures a command's stdout in a regular file that becomes the transcript,
   so a regular-file stdout can't be told apart from a redirect the seat chose.
   neon:   connection-string/cs (not --psql), roles create/reset-password/get-password/reveal-password, credentials
           create/reveal/rotate, api-keys create, api (raw responses can hold connection URIs), and projects/branches
           create unless --no-secrets; env pull only when --file is not a regular file (e.g. /dev/stdout).
   vercel: env ls/list with --json, --format json or --decrypt; env pull to a non-regular file (e.g. /dev/stdout, -).
2. A `--no-secrets` the installed version doesn't have on that command is refused, never passed on to be ignored:
   support is read from the installed CLI's own `<command> --help`.
Neon's argv is read the way yargs reads it, erring on the guarded side: booleans last-one-wins as yargs-parser
reads them (`--no-x=v` never counts as a negation), and EVERY bare word counts as a possible command word (yargs lets an unknown `--opt`
swallow the next word, so no option list can say which word is the command). So a value that happens to equal a
guarded command word (a branch named `cs` or `api`) also needs --output-file. Destinations (`env pull` files,
--output-file) are resolved as the CLI resolves them and refused when they are not a plain file or are open as the
output of this command or any of its parent processes (a link to the harness's capture file).
Everything else runs unchanged. The real CLI is the next one on PATH after this guard.
"""
import os, re, stat, subprocess, sys

me = os.path.realpath(__file__)
tool = os.path.basename(sys.argv[0])
args = sys.argv[1:]
NAME = {"neonctl": "neon", "vc": "vercel"}.get(tool, tool)


# A version manager's shim is never the real CLI. Where mise doesn't activate the tool (a project pins another node), its
# shim execs the next `vercel`/`neon` on PATH, which is this guard again: guard -> shim -> guard, an endless loop at full
# CPU in one process (2026-09-30, hc). So shims are skipped (mise's, and any other manager's `shims` dir), and the real
# CLI comes from the next plain entry on PATH, else from mise's node installs, newest version first.
def is_shim(p):
    rp = os.path.realpath(p)
    return "/shims/" in p or "/shims/" in rp or os.path.basename(rp) == "mise"


def version_key(p):
    v = p.split("/node/", 1)[1].split("/", 1)[0] if "/node/" in p else ""
    return [int(x) if x.isdigit() else -1 for x in re.split(r"[.\-]", v)]


def resolve_real():
    """The real CLI this guard runs, or None. Never itself, never a shim."""
    import glob
    names = [tool] + (["neon"] if tool == "neonctl" else [])   # the npm package `neon` only ships `neon`
    for name in names:
        for d in os.environ.get("PATH", "").split(os.pathsep):
            p = os.path.join(d or ".", name)
            if os.path.isfile(p) and os.access(p, os.X_OK) and os.path.realpath(p) != me and not is_shim(p):
                return p
    for name in names:
        found = {}
        for p in glob.glob(os.path.expanduser(f"~/.local/share/mise/installs/node/*/bin/{name}")):
            rp = os.path.realpath(p)
            if os.path.isfile(rp) and os.access(rp, os.X_OK) and rp != me:
                found.setdefault(rp, p)
        if found:
            return max(found.values(), key=version_key)
    return None


def real_binary():
    p = resolve_real()
    if not p:
        sys.exit(f"{tool} (seat guard): the real {tool} is not on PATH (shims skipped) or under mise's node installs")
    return p


# Loop guard, as a second line of defence: the guard execs the real CLI in the SAME process, so if this process was the
# guard once already, nothing real ran in between (a wrapper handed the call straight back). A real CLI that starts its
# own `vercel` or `neon` does so in a child process, with another pid, and is not stopped.
if os.environ.get("AGENT_CREDGUARD_PID") == str(os.getpid()):
    sys.exit(f"{tool} (seat guard): loop detected: a wrapper sent {tool} straight back to the guard; check PATH "
             f"(agent-credguard-check)")
os.environ["AGENT_CREDGUARD_PID"] = str(os.getpid())

# `--credguard-resolve`: print the real CLI the guard would run, and run nothing (agent-credguard-check uses it).
if args[:1] == ["--credguard-resolve"]:
    p = resolve_real()
    print(p or "none")
    sys.exit(0 if p and not is_shim(p) else 1)


def refuse(why):
    print(f"{tool} (seat guard): refused: {why}. Credentials never go to a seat's output (it is the transcript): add "
          f"--output-file <path> (written 0600; a plain `> file` is not enough) and use the values by name, never print "
          f"them. See docs/PROJECT-ENV.md.", file=sys.stderr)
    sys.exit(2)


# Options that take a value, so their value is never mistaken for a command word.
# Vercel options that take a value (vercel 60.1.3 --help), so `env pull`'s file argument is found.
VALUE_OPTS = {"--cwd", "-Q", "--global-config", "-A", "--local-config", "-S", "--scope", "-t", "--token", "--environment",
              "--git-branch", "--id", "--project", "-F", "--format", "--output-file"}


def parse(argv):
    """(positionals, {option: value or True}). Words after `--` are positionals too (Vercel's parser appends them)."""
    pos, opts, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        i += 1
        if a == "--":
            pos.extend(argv[i:])
            break
        if a.startswith("-") and a != "-":
            name, eq, val = a.partition("=")
            if not eq and name in VALUE_OPTS and i < len(argv):
                val, i = argv[i], i + 1
            opts[name] = val if (eq or name in VALUE_OPTS) else True
        else:
            pos.append(a)
    return pos, opts


TRUE, FALSE, UNSURE = "true", "false", "unsure"
toks = args[:args.index("--")] if "--" in args else list(args)


def flag(name, short=None):
    """The value yargs-parser ends up with for boolean --<name>, last one winning, or None when never given. As the
    installed parser reads them: `--x` (and `--x true|false`, which takes the next word), `--x=true|false`, and a bare
    `--no-x` (false; it never takes the next word). `--no-x=<anything>` sets a different property and leaves x as it
    was; that, and any other value, gives UNSURE, which every caller treats as the guarded side."""
    val, i = None, 0
    while i < len(toks):
        t = toks[i]
        i += 1
        if short and t == f"-{short}":
            val = TRUE
        elif t == f"--no-{name}":
            val = FALSE
        elif t.startswith(f"--no-{name}="):
            val = UNSURE
        elif t == f"--{name}":
            val = TRUE
            if i < len(toks) and toks[i] in ("true", "false"):
                val, i = (TRUE if toks[i] == "true" else FALSE), i + 1
        elif t.startswith(f"--{name}="):
            v = t.split("=", 1)[1]
            val = TRUE if v == "true" else FALSE if v == "false" else UNSURE
    return val


def last_value(*names):
    """The last value given to any of these value options (`--x v`, `--x=v`, `-Xv` for short ones), or None."""
    val, i = None, 0
    while i < len(toks):
        t = toks[i]
        i += 1
        for n in names:
            if t == n and i < len(toks):
                val, i = toks[i], i + 1
                break
            if t.startswith(n + "=") and n.startswith("--"):
                val = t[len(n) + 1:]
                break
            if not n.startswith("--") and t.startswith(n) and len(t) > len(n):
                val = t[len(n):]
                break
    return val


def watched():
    """(dev, inode) of every file open in this process and its ancestors: the harness's capture file among them (and
    any fd a shell saved while redirecting). Writing a 'file' that is one of these means printing to the transcript."""
    seen, pid = set(), os.getpid()
    while pid > 1:
        try:
            for fd in os.listdir(f"/proc/{pid}/fd"):
                try:
                    st = os.stat(f"/proc/{pid}/fd/{fd}")
                    seen.add((st.st_dev, st.st_ino))
                except OSError:
                    pass
            pid = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return seen


def target_unsafe(path, base=None):
    """Why writing `path` (relative to `base`) could reach the transcript, or '' when it lands in a plain file."""
    if path in ("-", ""):
        return f"{path or 'an empty path'} is stdout"
    full = os.path.join(base or os.getcwd(), path)
    real = os.path.realpath(full)
    if re.match(r"^/(dev|proc|sys)/", os.path.abspath(full)) or re.match(r"^/(dev|proc|sys)/", real):
        return f"{path} is a device or process file"
    try:
        st = os.stat(real)
    except FileNotFoundError:
        return ""
    except OSError as e:
        return f"{path}: {e.strerror}"
    if not stat.S_ISREG(st.st_mode):
        return f"{path} is not a regular file"
    if (st.st_dev, st.st_ino) in watched():
        return f"{path} is open as this command's (or its shell's) output"
    return ""


def stdout_safe():
    """Only /dev/null (or no stdout at all). Not a regular file: that may be the harness's transcript capture."""
    try:
        st = os.fstat(1)
    except OSError:
        return True
    try:
        return stat.S_ISCHR(st.st_mode) and st.st_rdev == os.stat("/dev/null").st_rdev
    except OSError:
        return False


def help_lists_no_secrets(real, words):
    try:
        out = subprocess.run([real, *words, "--help"], capture_output=True, text=True, timeout=30,
                             env={**os.environ, "NO_COLOR": "1"}).stdout
    except Exception:
        return False
    return bool(re.search(r"--no-secrets|^\s*--secrets\b", out, re.M))


# Every bare word counts, option values included: an option the guard doesn't know can't hide a command word.
words = [t for t in toks if not (t.startswith("-") and t != "-")]
def pair(tops, subs):
    return any(w in tops and any(x in subs for x in words[i + 1:]) for i, w in enumerate(words))


# Post-install canary: `neon --credguard-status --help` (or vercel/vc) says whether this shell reaches the guard. Without
# the guard, the real CLI only prints its help (never a bare unknown flag: `vercel` alone would deploy).
if "--credguard-status" in args:
    print(f"{tool} (seat guard): active ({me})")
    sys.exit(0)
real = real_binary()
if flag("help", "h") == TRUE or flag("version") == TRUE or not words:
    if not any(re.match(r"^--(no-)?(help|version)=", t) or t in ("--no-help", "--no-version") for t in toks):
        os.execv(real, [tool, *args])

guard, why = False, ""
if NAME == "neon":
    secrets = flag("secrets")
    if secrets is not None:
        cmd = next(([w, x] for i, w in enumerate(words) for x in words[i + 1:i + 2]
                    if w in ("projects", "project", "branches", "branch") and x == "create"), words[:1])
        if not help_lists_no_secrets(real, cmd):
            refuse(f"`{NAME} {' '.join(cmd)}` has no --no-secrets/--secrets in the installed version; it would "
                   f"be ignored and the secret printed")
    if "cs" in words or "connection-string" in words:
        guard, why = flag("psql") != TRUE, "it prints a connection string with its password"
    if "api" in words:
        guard, why = True, "raw API responses can hold connection URIs and passwords"
    if pair(("roles", "role"), ("create", "reset-password", "get-password", "reveal-password")):
        guard, why = True, "it can print a role password (-o json/yaml prints the whole role)"
    if pair(("credentials", "credential"), ("create", "reveal", "rotate")):
        guard, why = True, "it prints an api_token and an S3 secret key"
    if pair(("api-keys", "api-key"), ("create",)):
        guard, why = True, "it prints the new API key"
    if pair(("projects", "project", "branches", "branch"), ("create",)) and secrets != FALSE:
        guard, why = True, "it prints connection URIs unless --no-secrets"
    if pair(("env",), ("pull",)):
        f = last_value("--file")
        if f is None:
            f = ".env" if os.path.exists(".env") or os.path.islink(".env") else ".env.local"
        bad = target_unsafe(f)
        if bad:
            refuse(f"env pull would write to {bad}")
elif NAME == "vercel":
    pos, _ = parse(args)
    k = next((j for j, w in enumerate(pos) if w == "env"), None)
    sub = pos[k + 1] if k is not None and k + 1 < len(pos) else ""
    if k is not None and sub in ("ls", "list"):
        guard = any("json" in t.lower() or t.startswith("--decrypt") for t in toks)
        why = "--json/--format json prints readable values"
    elif "pull" in pos and "env" in pos:
        # Every word after `pull` is checked, not only the first: which one Vercel takes as the file is its business.
        j = pos.index("pull")
        for target in pos[j + 1:] or [".env.local"]:
            bad = target_unsafe(target, last_value("--cwd"))
            if bad:
                refuse(f"env pull would write to {bad}")

if guard:
    out = last_value("--output-file")
    if out:
        if os.path.islink(out):
            refuse(f"--output-file {out} is a symlink")
        bad = target_unsafe(out)
        if bad:
            refuse(f"--output-file: {bad}")
        try:
            fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        except OSError as e:
            sys.exit(f"{tool} (seat guard): cannot write {out}: {e.strerror}")
        os.fchmod(fd, 0o600)
        rest, i = [], 0   # drop the guard's own flag (both spellings) before handing over
        while i < len(args):
            if args[i] == "--output-file":
                i += 2
                continue
            if args[i].startswith("--output-file="):
                i += 1
                continue
            rest.append(args[i])
            i += 1
        print(f"{tool} (seat guard): output goes to {out} (mode 0600); use it by name, never print it", file=sys.stderr)
        os.dup2(fd, 1)
        os.close(fd)
        os.execv(real, [tool, *rest])
    if not stdout_safe():
        refuse(why)
elif last_value("--output-file") is not None:
    refuse("--output-file is only for commands that print credentials")
os.execv(real, [tool, *args])
