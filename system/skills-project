#!/usr/bin/env python3
"""Project the installed skill catalog to each harness. Default is read-only; --apply repairs links."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tomllib

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--apply', action='store_true')
p.add_argument('--json', action='store_true')
a = p.parse_args()
home = Path.home()
roots = {
    'Claude': Path(os.environ.get('CLAUDE_CONFIG_DIR', home / '.claude')) / 'skills',
    'Codex': home / '.agents/skills',
    'Grok': home / '.grok/skills',
    'Kimi': Path(os.environ.get('KIMI_CODE_HOME', home / '.kimi-code')) / 'skills',
}
state = home / '.local/share/agent-stack/skills'
manifest = state / 'projection.json'
try:
    previous = json.loads(manifest.read_text())
except (OSError, ValueError):
    previous = {}
rows = []
def report(ok, detail):
    rows.append({'ok': ok, 'detail': detail})

catalog = {}
seen = set()
def add(directory):
    if not directory.is_dir() or directory.resolve() in seen:
        return
    seen.add(directory.resolve())
    for skill in sorted(directory.iterdir()):
        if (skill / 'SKILL.md').is_file():
            catalog.setdefault(skill.name, skill.resolve())
        elif skill.is_dir():
            add(skill)  # grouped account skills and Codex's .system directory

# Shared user choices take precedence over plugin defaults of the same name.
for directory in [roots['Codex'], roots['Claude'], home / '.codex/skills', home / '.codex/skills/.system',
                  roots['Grok'], roots['Kimi']]:
    add(directory)
openrig = home / '.local/share/agent-stack/openrig/lib/node_modules/@openrig/cli/daemon'
add(openrig / 'assets/plugins/openrig-core/skills')
add(openrig / 'specs/agents/shared/skills')
registry = home / '.claude/plugins/installed_plugins.json'
if registry.exists():
    try:
        plugins = json.loads(registry.read_text())['plugins']
        for name, installs in sorted(plugins.items()):
            for installed in installs:
                if installed.get('scope') == 'user' and installed.get('installPath'):
                    add(Path(installed['installPath']) / 'skills')
    except (OSError, ValueError, KeyError, TypeError) as e:
        report(False, f'cannot read installed plugin catalog: {type(e).__name__}')

# Codex records enabled plugin names in config.toml. Avoid choosing an arbitrary stale cache version.
codex = home / '.codex'
if (codex / 'config.toml').exists():
    try:
        config = tomllib.loads((codex / 'config.toml').read_text())
        for name, options in config.get('plugins', {}).items():
            if not options.get('enabled') or '@' not in name:
                continue
            plugin, market = name.rsplit('@', 1)
            versions = sorted((codex / 'plugins/cache' / market / plugin).glob('*/skills'))
            if len(versions) == 1:
                add(versions[0])
            else:
                report(False, f'Codex plugin {name}: expected one installed skill version, found {len(versions)}')
    except (OSError, ValueError, TypeError):
        report(False, 'cannot read Codex plugin catalog')

# Herdr's release-matched skill is generated by the installed binary, not fetched from latest docs.
herdr = state / 'herdr'
try:
    result = subprocess.run(['herdr', '--skill'], text=True, capture_output=True, timeout=15)
    text = result.stdout
    if result.returncode or not text.startswith('---\n') or '\nname: herdr\n' not in text or 'HERDR_ENV' not in text:
        raise ValueError('invalid bundled skill')
    target = herdr / 'SKILL.md'
    if not target.is_file() or target.read_text() != text:
        if a.apply:
            herdr.mkdir(parents=True, exist_ok=True)
            tmp = target.with_suffix('.tmp')
            tmp.write_text(text)
            tmp.replace(target)
        else:
            report(False, 'Herdr bundled skill missing or stale; run install.sh --apply')
    catalog['herdr'] = herdr
except (OSError, ValueError, subprocess.TimeoutExpired):
    report(False, 'cannot read herdr --skill; install Herdr before projecting its skill')

if not catalog:
    report(False, 'no installed skills found')
managed = dict(previous)
for harness, directory in roots.items():
    missing = []
    for name, source in sorted(catalog.items()):
        dest = directory / name
        if dest.resolve() == source.resolve() and (dest / 'SKILL.md').is_file():
            continue
        exists = dest.exists() or dest.is_symlink()
        owned = dest.is_symlink() and previous.get(str(dest)) == os.readlink(dest)
        if exists and not owned:
            # A duplicate with identical text is still readable. Never replace a user's directory.
            try:
                same = (dest / 'SKILL.md').read_bytes() == (source / 'SKILL.md').read_bytes()
            except OSError:
                same = False
            if same:
                continue
            report(False, f'{harness}: preserve conflicting skill {name}; reconcile it before applying')
            continue
        if a.apply and (source / 'SKILL.md').is_file():
            directory.mkdir(parents=True, exist_ok=True)
            if exists:
                dest.unlink()
            dest.symlink_to(source, target_is_directory=True)
            managed[str(dest)] = str(source)
        else:
            missing.append(name)
    report(not missing, f'{harness}: {len(catalog)} catalog skills' + (f'; missing/stale: {", ".join(missing)}' if missing else ' accessible'))
if a.apply:
    state.mkdir(parents=True, exist_ok=True)
    tmp = manifest.with_suffix('.tmp')
    tmp.write_text(json.dumps(managed, indent=2) + '\n')
    tmp.replace(manifest)
if a.json:
    print(json.dumps(rows))
else:
    for row in rows:
        print(('ok   ' if row['ok'] else 'FAIL ') + row['detail'])
sys.exit(0 if all(r['ok'] for r in rows) else 1)
