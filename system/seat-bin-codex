#!/usr/bin/env python3
"""OpenRig seats only (first on the OpenRig daemon's PATH).

1. OpenRig launches Codex from a `/bin/sh <script>` wrapper, so tmux's #{pane_current_command} reads
   "sh" until Codex draws its TUI; OpenRig's restore probe treats that as "returned_to_shell". Making
   Codex the terminal's foreground process group lets tmux report "codex" from the first instant.
2. --no-daemon: the shared Codex app-server daemon runs hooks with the env of whichever seat started
   it, so OpenRig activity hooks report the wrong seat/generation (openrig#69). OpenRig >= 0.6 passes it
   itself; the shim adds it only when absent (a repeated flag makes Codex exit).
3. model_catalog_json: the proxy's Codex catalog with display_name = slug. Codex 0.157 footers show the
   display name ("GPT 6.0 Astra"); OpenRig's live-TUI matcher expects the slug ("  gpt-6-astra · …").
   Same models and capabilities; only the label changes.
4. -a never: seats never stop for approval. OpenRig's builtin:yolo gives Codex only `-s danger-full-access`, so
   without this a seat still asks "Would you like to run the following command?" whenever ~/.codex/config.toml
   (or a profile) says on-request. Kept if the caller already chose an approval policy or a no-prompt mode.
"""
import os, signal, sys

real = os.path.expanduser("~/.local/share/mise/installs/codex/latest/bin/codex")
try:
    fd = os.open("/dev/tty", os.O_RDWR)
    old = signal.signal(signal.SIGTTOU, signal.SIG_IGN)
    os.setpgid(0, 0)
    os.tcsetpgrp(fd, os.getpgrp())
    signal.signal(signal.SIGTTOU, old)
    os.close(fd)
except OSError:
    pass  # no controlling tty (non-interactive use): nothing to do

catalog = os.path.join(os.path.dirname(os.path.realpath(__file__)), "codex-models.json")
try:
    import json, time, urllib.request
    if not os.path.exists(catalog) or time.time() - os.path.getmtime(catalog) > 6 * 3600:
        key = next(l.split("=", 1)[1].strip() for l in open(os.path.expanduser("~/.config/agent-stack/secrets/cliproxy.env"))
                   if l.startswith("CLIPROXY_CLIENT_KEY="))
        req = urllib.request.Request("http://127.0.0.1:8317/v1/models?client_version=0.157.1",
                                     headers={"Authorization": f"Bearer {key}", "User-Agent": "codex_cli_rs/0.157.1"})
        data = json.load(urllib.request.urlopen(req, timeout=5))
        for m in data.get("models", []):
            m["display_name"] = m["slug"]
        tmp = catalog + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, catalog)
except Exception:
    pass  # keep the previous catalog; a stale label never blocks launch
extra = ["-c", f'model_catalog_json="{catalog}"'] if os.path.exists(catalog) else []
# Seats talk only to the local proxy: no analytics, feedback upload or update checks.
extra += ["-c", "analytics.enabled=false", "-c", "feedback.enabled=false", "-c", "check_for_update_on_startup=false"]
# Codex options that take a value (codex 0.158 --help for the top level, resume, fork and exec).
VALUE_OPTS = {"-a", "--ask-for-approval", "--add-dir", "-C", "--cd", "-c", "--config", "--color", "--disable", "--enable",
              "-i", "--image", "--local-provider", "-m", "--model", "-o", "--output-last-message", "--output-schema",
              "-p", "--profile", "--remote", "--remote-auth-token-env", "-s", "--sandbox", "--thread-source"}
# Codex refuses -a next to these; each already means "no approval prompt to a human".
NO_PROMPT = {"--dangerously-bypass-approvals-and-sandbox", "--yolo", "--approve-for-me"}


def options(args):
    """(name, value) for each option Codex will parse, and (None, word) for each positional (subcommand, ids, prompt).
    Stops at `--`; option values are never mistaken for options."""
    i = 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            return
        if a.startswith("--"):
            name, eq, value = a.partition("=")
            if not eq and name in VALUE_OPTS and i < len(args):
                value, i = args[i], i + 1
            yield name, (value if eq or name in VALUE_OPTS else None)
        elif a.startswith("-") and len(a) > 1:
            name = a[:2]
            if name in VALUE_OPTS:
                if len(a) > 2:
                    yield name, a[2:]
                elif i < len(args):
                    yield name, args[i]
                    i += 1
            else:
                yield name, None
        else:
            yield None, a


# Seats never prompt for approval, whatever the user's config or profile says. A caller's own choice (-a, a
# -c approval_policy override, or a no-prompt mode Codex won't combine with -a) is kept as it is.
args = sys.argv[1:]
chose = any(n in ("-a", "--ask-for-approval") or n in NO_PROMPT
            or (n in ("-c", "--config") and (v or "").split("=", 1)[0].strip() == "approval_policy") for n, v in options(args))
if not chose:
    extra += ["-a", "never"]
# Compact before a seat re-sends half its window every turn (WO88): Codex has no auto-compact limit by default, so a
# busy seat ran to hundreds of thousands of tokens per turn. Leads and architects hold more context (300k), every
# other seat 200k; AGENT_CODEX_AUTO_COMPACT_TOKENS overrides, and a caller's own -c model_auto_compact_token_limit wins.
if not any(n in ("-c", "--config") and (v or "").split("=", 1)[0].strip() == "model_auto_compact_token_limit" for n, v in options(args)):
    seat = (os.environ.get("OPENRIG_SESSION_NAME") or "").split("@")[0]
    limit = os.environ.get("AGENT_CODEX_AUTO_COMPACT_TOKENS") or ("300000" if seat.startswith(("coord-", "arch-")) else "200000")
    if limit.isdigit():
        extra += ["-c", f"model_auto_compact_token_limit={limit}"]
# OpenRig >= 0.6 passes --no-daemon itself (upstream #69), and Codex refuses a repeated flag, so add it only when absent.
nd = [] if any(n == "--no-daemon" for n, _ in options(args)) else ["--no-daemon"]
os.execv(real, [real, *nd, *extra, *args])
