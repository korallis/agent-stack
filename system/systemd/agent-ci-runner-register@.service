# Before every start of agent-ci-runner@%i (Requires= + After=, so also after each ephemeral job): re-extract the runner,
# wipe its home and tool cache, and register it afresh (agent-ci-runner register). It runs outside the runner's sandbox
# (it needs gh's login); a privileged ExecStartPre=+ in the sandboxed unit can't set up its mount namespace once the
# runner's home is bound over the real home path (2026-10-03).
[Unit]
Description=Register a fresh ephemeral GitHub Actions runner for %i (agent-ci-runner)
[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/agent-ci-runner register %i
