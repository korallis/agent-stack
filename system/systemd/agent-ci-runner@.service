# One ephemeral GitHub Actions runner for korallis/%i on this host (agent-ci-runner install %i; docs/RUNNERS.md).
# Every job gets a freshly registered runner and a clean work dir (ExecStartPre, outside the sandbox: it needs gh).
# The job itself runs sandboxed: it sees only its own runner dir, the shared gate hooks and the CI slot state, never
# the agents' homes, keys or seats. It shares agent-heavy.slice's memory ceiling with heavy builds, at low CPU and
# IO weight, and the job-started hook holds it until one of the global CI job slots is free and the host isn't
# overloaded (AGENT_CI_MAX_JOBS etc. in ~/.config/agent-stack/ci-runners.env).
[Unit]
Description=GitHub Actions runner for %i (agent-stack, ephemeral, sandboxed)
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
Slice=agent-heavy.slice
Environment=AGENT_CI_REPO=%i
Environment=AGENT_CI_STATE=%h/.local/state/agent-stack/ci-runners
Environment=AGENT_CI_CONFIG=%h/.config/agent-stack/ci-runners.env
Environment=HOME=%h/.local/share/agent-stack/ci-runners/%i/home
Environment=RUNNER_TOOL_CACHE=%h/.local/share/agent-stack/ci-runners/%i/toolcache
Environment=AGENT_TOOLSDIRECTORY=%h/.local/share/agent-stack/ci-runners/%i/toolcache
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED=%h/.local/share/agent-stack/ci-runners/_shared/job-started.sh
Environment=ACTIONS_RUNNER_HOOK_JOB_COMPLETED=%h/.local/share/agent-stack/ci-runners/_shared/job-completed.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/share/agent-stack/ci-runners/%i/runner
ExecStartPre=+%h/.local/bin/agent-ci-runner register %i
ExecStart=%h/.local/share/agent-stack/ci-runners/%i/runner/run.sh
Restart=always
RestartSec=5
TimeoutStopSec=90
KillMode=control-group
# Sandbox
PrivateUsers=yes
ProtectHome=tmpfs
BindPaths=%h/.local/share/agent-stack/ci-runners/%i %h/.local/state/agent-stack/ci-runners
BindReadOnlyPaths=%h/.local/share/agent-stack/ci-runners/_shared -%h/.config/agent-stack/ci-runners.env
PrivateTmp=yes
NoNewPrivileges=yes
# Load bounds
MemoryMax=8G
MemorySwapMax=0
CPUQuota=800%
CPUWeight=20
IOWeight=20
TasksMax=4096

[Install]
WantedBy=default.target
