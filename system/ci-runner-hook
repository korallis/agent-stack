#!/usr/bin/env bash
# ci-runner-hook start|end: the local CI runners' job gate (ACTIONS_RUNNER_HOOK_JOB_STARTED/COMPLETED, through
# job-started.sh / job-completed.sh in ci-runners/_shared; agent-ci-runner install copies it there).
# start: wait for one of AGENT_CI_MAX_JOBS global job slots (default 2; one slot file per repo, taken under a lock) and,
# for up to AGENT_CI_GATE_WAIT_S (900), until load1 <= nproc x AGENT_CI_MAX_LOAD_PER_CPU (1.0) and <= AGENT_CI_MAX_LOAD
# (24: the fleet's seats need the rest; browser jobs timed out at load1 ~35) and MemAvailable >= AGENT_CI_MIN_MEM_GB (6). After the wait the load gate is skipped; the slot cap never is. end: free this repo's slot.
# A slot older than AGENT_CI_SLOT_STALE_S (6 h) is cleared. The load gate compares with the HOST's CPUs (`nproc --all`):
# plain nproc inside the unit reports its CPUQuota (8), which would read a normal load as overloaded. Settings come from AGENT_CI_CONFIG: only NAME=number lines.
# start first refuses fork code (exit 1: the job fails before any step runs): a pull_request-type event whose head repo,
# or a workflow_run whose head repository, is not GITHUB_REPOSITORY. A workflow's runs-on guard is not enough, because a
# PR runs its own copy of the workflow and a fork can edit it. Fails closed: no repository, or an event file that
# can't be read as JSON, is refused too. The runner sets GITHUB_REPOSITORY and GITHUB_EVENT_PATH; a workflow can't.
set -u
mode=${1:-}; repo=${AGENT_CI_REPO:?AGENT_CI_REPO unset}; slots=${AGENT_CI_STATE:?AGENT_CI_STATE unset}/slots
if [ -r "${AGENT_CI_CONFIG:-}" ]; then
  while IFS= read -r line; do
    [[ $line =~ ^(AGENT_CI_(MAX_JOBS|MAX_LOAD_PER_CPU|MAX_LOAD|MIN_MEM_GB|GATE_WAIT_S|SLOT_STALE_S|POLL_S))=([0-9]+(\.[0-9]+)?)$ ]] && printf -v "${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[3]}"
  done < "$AGENT_CI_CONFIG"
fi
max=${AGENT_CI_MAX_JOBS:-2} per=${AGENT_CI_MAX_LOAD_PER_CPU:-1.0} maxload=${AGENT_CI_MAX_LOAD:-24} minmem=${AGENT_CI_MIN_MEM_GB:-6}
gate=${AGENT_CI_GATE_WAIT_S:-900} stale=${AGENT_CI_SLOT_STALE_S:-21600} poll=${AGENT_CI_POLL_S:-10}
loadavg=${AGENT_CI_LOADAVG:-/proc/loadavg} meminfo=${AGENT_CI_MEMINFO:-/proc/meminfo} cpus=${AGENT_CI_NPROC:-$(nproc --all)}
mkdir -p "$slots"
exec 9>"$slots/.lock"
case $mode in
  end) flock 9; rm -f "$slots/$repo"; echo "[ci-gate] $repo: job slot released"; exit 0 ;;   # under the lock: never mid-sweep
  start) ;;
  *) echo "usage: ci-runner-hook start|end" >&2; exit 2 ;;
esac
if ! why=$(python3 - "${GITHUB_REPOSITORY:-}" "${GITHUB_EVENT_PATH:-}" <<'PY'
import json, sys
repo, path = sys.argv[1], sys.argv[2]
try:
    ev = json.load(open(path))
    assert repo and isinstance(ev, dict)
except Exception:
    print(f"no readable event for {repo or 'an unknown repository'}"); sys.exit(1)
head = None
if "pull_request" in ev:
    head = ((ev.get("pull_request") or {}).get("head") or {}).get("repo") or {}
elif "workflow_run" in ev:
    head = (ev.get("workflow_run") or {}).get("head_repository") or {}
if head is not None and head.get("full_name") != repo:
    print(f"code from {head.get('full_name') or 'a deleted fork'}, not {repo}"); sys.exit(1)
PY
); then
  echo "[ci-gate] $repo: REFUSED, fork code never runs on a local runner ($why)"; exit 1
fi
began=$(date +%s); said=0
# While the HOST holds this job (load or memory, not the slot cap) a marker says since when: agent-ci-runner watch moves
# a repo whose job is held 10+ min to hosted runners until the host is calm again. Gone as the hook ends.
waiting=$AGENT_CI_STATE/waiting; mkdir -p "$waiting"; trap 'rm -f "$waiting/$repo"' EXIT
while :; do
  now=$(date +%s)
  flock 9
  for f in "$slots"/*; do m=$(stat -c %Y "$f" 2>/dev/null) || continue; [ $((now - m)) -gt "$stale" ] && rm -f "$f"; done
  busy=$(find "$slots" -maxdepth 1 -type f ! -name '.*' ! -name "$repo" | wc -l)
  load=$(cut -d' ' -f1 "$loadavg"); avail=$(awk '/^MemAvailable:/{print int($2/1048576)}' "$meminfo")
  calm=$(awk -v l="$load" -v c="$cpus" -v p="$per" -v x="$maxload" -v a="$avail" -v m="$minmem" 'BEGIN{print (l <= c*p && l <= x && a >= m) ? 1 : 0}')
  waited=$((now - began))
  if [ "$busy" -lt "$max" ] && { [ "$calm" = 1 ] || [ "$waited" -gt "$gate" ]; }; then  # -gt: whole seconds, so at least the full wait
    echo "$now" > "$slots/$repo"; flock -u 9
    echo "[ci-gate] $repo: job slot taken ($((busy + 1))/$max busy, load $load/$cpus, ${avail}G free, waited ${waited}s)"
    exit 0
  fi
  flock -u 9
  if [ "$busy" -lt "$max" ] && [ "$calm" != 1 ]; then [ -e "$waiting/$repo" ] || echo "$began host" > "$waiting/$repo"; else rm -f "$waiting/$repo"; fi
  if [ $((now - said)) -ge 60 ]; then
    echo "[ci-gate] $repo: waiting ($busy/$max CI jobs running, load $load/$cpus, ${avail}G free; load gate for $((gate - waited > 0 ? gate - waited : 0))s more)"
    said=$now
  fi
  sleep "$poll"
done
