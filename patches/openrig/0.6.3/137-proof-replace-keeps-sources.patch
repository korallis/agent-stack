+/** Write a proof artifact without ever writing THROUGH an existing name. Without `replace` the file is created
+ *  exclusively ("wx"; an existing file or link of that name refuses). With `replace` the content goes to a fresh temp
+ *  file in the same directory and is renamed over the name: that swaps the directory entry, so a hardlink or a symlink
+ *  of that name (e.g. to a screenshot) keeps its content. `source` (the --file path) is never the target: an existing
+ *  name that is the same file (device + inode, so hardlinks and symlinks count) is refused. Returns null when written,
+ *  else "exists" or "is-source". */
+export function writeProofArtifact(target, content, { replace = false, source } = {}) {
+    const existing = fs.statSync(target, { throwIfNoEntry: false });
+    if (source && existing) {
+        const src = fs.statSync(source, { throwIfNoEntry: false });
+        if (src && src.dev === existing.dev && src.ino === existing.ino)
+            return "is-source";
+    }
+    if (!replace) {
+        try {
+            fs.writeFileSync(target, content, { encoding: "utf8", flag: "wx" });
+        }
+        catch (err) {
+            if (err.code === "EEXIST")
+                return "exists";
+            throw err;
+        }
+        return null;
+    }
+    // A random name, created exclusively; on failure only a temp THIS call created is removed.
+    const tmp = path.join(path.dirname(target), `.${path.basename(target)}.${process.pid}.${randomUUID()}.tmp`);
+    let created = false;
+    try {
+        fs.writeFileSync(tmp, content, { encoding: "utf8", flag: "wx" });
+        created = true;
+        fs.renameSync(tmp, target);
+    }
+    catch (err) {
+        if (created)
+            fs.rmSync(tmp, { force: true });
+        throw err;
+    }
+    return null;
+}
