+const pendingCaptures = new Map();
+/** Patch 144: capture one session's pane, sharing a batched read with every other session asking within
+ *  CAPTURE_COALESCE_MS. One fork of this (large) daemon per session per tick blocked its event loop: with ~90 seats,
+ *  spawn alone took a third of a 60 s CPU profile. An adapter without capturePanesContent (patch 142), a batch that
+ *  can't list tmux, or a session the batch left out falls back to the per-session capture, so a result is never
+ *  worse than before. Resolves to the pane text or null, as capturePaneContent does. */
+function captureCoalesced(tmuxAdapter, sessionName, lines) {
+    if (typeof tmuxAdapter.capturePanesContent !== "function")
+        return tmuxAdapter.capturePaneContent(sessionName, lines);
+    let byLines = pendingCaptures.get(tmuxAdapter);
+    if (!byLines) {
+        byLines = new Map();
+        pendingCaptures.set(tmuxAdapter, byLines);
+    }
+    let batch = byLines.get(lines);
+    if (!batch) {
+        batch = new Map();
+        byLines.set(lines, batch);
