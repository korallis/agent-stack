+/** Patch 146: a seat (OPENRIG_SESSION_NAME set) is told to wait, not to start the daemon. Daemon lifecycle belongs to
+ *  the operator; a seat that followed the start advice during an operator's daemon cycle started a second daemon in
+ *  its own terminal's scope (2026-10-02). Outside a seat, and for the operator seat (AGENT_OPERATOR_SEAT, default
+ *  operator-agent@kernel, as rig-lifecycle-guard), the advice is unchanged. */
+function seatLifecycleAdvice(action) {
+    const seat = process.env.OPENRIG_SESSION_NAME;
+    return seat && seat !== (process.env.AGENT_OPERATOR_SEAT || "operator-agent@kernel")
+        ? "Don't start it yourself: daemon lifecycle belongs to the operator. Wait 30 s and retry; if it stays down for 2 minutes, tell the operator."
+        : action;
+}
