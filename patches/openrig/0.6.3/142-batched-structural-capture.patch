+    /** Patch 142: capture many sessions' panes with a few tmux calls instead of one per session. One `list-sessions`
+     *  says which targets exist: a missing one maps to null (as a failed per-target capture), without a fork. The live
+     *  ones are captured in chunks of CAPTURE_BATCH chained commands (`display-message` marker, then `capture-pane`),
+     *  each pane's output delimited by a marker unique to the call. tmux stops a chain at its first failing command,
+     *  so a chunk that fails is split in half and retried (an oversized output or a session gone since the listing);
+     *  a single session that still fails is left OUT of the map: the caller reads it per target. Null when tmux can't be listed at all. `ansi` keeps SGR escapes (`-e`). `knownLive` (the
+     *  sessions a capture moments ago found) skips the listing. Each entry is { text, capturedAt }: capturedAt is when its
+     *  own chunk was read, so a slow later chunk can't make an earlier capture look fresh (upstream #309 review). */
+    async capturePanesContent(targets, lines = 20, ansi = false, knownLive = null, now = () => new Date()) {
+        let live = knownLive;
+        if (!live) {
+            try {
+                live = new Set((await this.exec(`tmux list-sessions -F '#{session_name}'`)).split("\n").map((s) => s.trim()).filter(Boolean));
+            }
+            catch {
+                return null;
+            }
+        }
+        const out = new Map();
+        const listedAt = now();
+        const present = [];
+        for (const t of new Set(targets)) {
+            if (live.has(t))
+                present.push(t);
+            else
+                out.set(t, { text: null, capturedAt: listedAt });
+        }
+        // A chunk that fails is split in half and retried, down to one session: its output overflowed exec's 1 MiB
+        // buffer (wide, colour-dense panes: each capture is the visible pane plus the requested history) or a session
+        // vanished since the listing. A single session that still fails is left out: the caller reads it per target.
+        const captureChunk = async (chunk) => {
+            const nonce = randomUUID().replace(/-/g, "");
+            const mark = (k) => `__openrig_capture_${nonce}_${k}__`;
+            // `=<name>:` targets exactly that session's current pane: no prefix match, and a name with a "." (which `-t
+            // <name>` would read as window.pane) still resolves, so one odd name can't fail its whole chunk.
+            const cmd = "tmux " + chunk.map((t, k) => `display-message -p -t ${shellQuote(`=${t}:`)} ${shellQuote(mark(k))} \\; capture-pane -p${ansi ? " -e" : ""} -t ${shellQuote(`=${t}:`)} -S -${lines}`).join(" \\; ");
+            let output, capturedAt;
