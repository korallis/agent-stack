# agent-project-onboard answers file. KEY=value, one per line; paths are relative to this file.
NAME=Shop                                  # the project: ~/Projects/Shop, Shop-work, Shop.worktrees
RIG=shop                                   # the team's rig name (short, lower case)
REPO=https://github.com/acme/shop.git      # an existing repo to adopt; leave empty for a new repo
GITHUB=acme                                # GitHub owner (a new repo is created there, private)
TEAM=small                                 # core | small | build | full-stack
IDENTITY=Shop Bot <bot@example.invalid>    # the commit identity seats use
VERCEL_PROJECT=                            # the Vercel project, to pull the Development env into .env.local; empty: none
WORKFLOW=issues                            # plan | issues (issues: never close; hand back to the creator)
PLAN_APPROVAL=owner                        # owner | operator (only when the owner delegated plan approval)
GITHUB_SETUP=no                            # existing repo: yes ONLY with the owner's OK to add branch protection and labels
PLAN=plan.md                               # the owner's plan, in their words
DECISIONS=owner-decisions.md               # standing owner decisions, one "- " bullet each
SPECIFICS=specifics.md                     # the project's facts for CULTURE: trunk, checks, merge path, env, deploys
